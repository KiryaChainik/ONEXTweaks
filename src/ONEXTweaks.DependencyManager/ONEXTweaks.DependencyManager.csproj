<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion><Version>0.29.385</Version><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <OnexWidgetPackageFamily Condition="'$(OnexWidgetPackageFamily)' == ''">ONEXTweaks.Widget_3a23eh8tyg7na</OnexWidgetPackageFamily>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="System.Net.Http"/><Reference Include="System.Management"/>
  </ItemGroup>
  <Target Name="ValidateOnexWidgetPackageFamily" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(OnexWidgetPackageFamily)', '\AONEXTweaks\.Widget_[0123456789abcdefghjkmnpqrstvwxyz]{13}\z'))"
           Text="OnexWidgetPackageFamily must match the signed ONEXTweaks widget registration." />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="OnexWidgetPackageFamily" Value="$(OnexWidgetPackageFamily)" />
  </ItemGroup>
</Project>
