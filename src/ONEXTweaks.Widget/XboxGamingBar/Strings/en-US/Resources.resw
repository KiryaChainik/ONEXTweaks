  </data>
  <data name="OnexCaption709.Text" xml:space="preserve">
    <value>Press Read RPM to read the live fan speed.</value>
  </data>
  <data name="OnexCaption710.Text" xml:space="preserve">
    <value>Fan override probe — diagnostic only</value>
  </data>
  <data name="OnexCaption711.Text" xml:space="preserve">
    <value>Writes a raw byte to an EC block (default 152) to find a proportional fan-duty register. Sweep + Write, then listen. Set value back to 0 when done.</value>
  </data>
  <data name="OnexCaption712.Text" xml:space="preserve">
    <value>Block</value>
  </data>
  <data name="OnexCaption713.Text" xml:space="preserve">
    <value>Value</value>
  </data>
  <data name="OnexCaption714.Text" xml:space="preserve">
    <value>0 (0x00)</value>
  </data>
  <data name="OnexCaption715.Content" xml:space="preserve">
    <value>Write</value>
  </data>
  <data name="OnexCaption716.Content" xml:space="preserve">
    <value>0x80|40</value>
  </data>
  <data name="OnexCaption717.Content" xml:space="preserve">
    <value>0x80|80</value>
  </data>
  <data name="OnexCaption718.Text" xml:space="preserve">
    <value>Write a value, then listen. Read-back confirms what landed in the EC.</value>
  </data>
