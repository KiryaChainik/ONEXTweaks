                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TDPBoostToggle"
                                                  Grid.Column="2"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="True" Width="52"
                                                  VerticalAlignment="Center"
                                                 
                                                 
                                                  Toggled="TDPBoostToggle_Toggled"
                                                  KeyDown="TDPBoostToggle_KeyDown"/>
                                </Grid>
<StackPanel x:Name="TDPBoostSliderArea" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Uid="OnexCaption150" Text="PL2-Boost"
                                                   FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        <!-- Same style as PL1's value above (CardValueStyle) - the two sat in one card at
                                             different sizes and colours, which read as different kinds of number. -->
                                        <TextBlock x:Uid="OnexCaption151" x:Name="TDPBoostFPPTValueInCard" local:OnexPowerReadout.IsNeutral="True"
                                                   Style="{StaticResource CardValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="3W"/>
                                    </Grid>
                                    <!-- Maximum is a placeholder until the helper reports the PL2
                                         ceiling; see the note on TDPSlider. -->
                                    <Grid x:Name="OnexPerformancePl2Track">
                                    <Slider x:Name="TDPBoostFPPTSliderCard"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="10" Maximum="100"
                                            TickFrequency="1" SnapsTo="Ticks"
                                            Value="3"
                                            IsEnabled="False"
                                            IsThumbToolTipEnabled="False"
                                           
                                           
                                            ValueChanged="TDPBoostFPPTSlider_ValueChanged"
                                            KeyDown="TDPBoostFPPTSliderCard_KeyDown"/>
                                    </Grid>
                                    <!-- Watt scale under the PL2 slider (same style as the PL1/FPS scales). -->
                                    <Canvas x:Name="TDPBoostScaleLabels" Height="14" Margin="0,2,0,0"
                                            HorizontalAlignment="Stretch"
                                            SizeChanged="TDPBoostScaleLabels_SizeChanged"/>
                                </StackPanel>
</StackPanel>
</Border></StackPanel></Border><Border x:Name="OnexPerfCpuDetail" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
 <StackPanel Spacing="10"><Grid><TextBlock x:Uid="OnexCaption152" Text="CPU Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="OnexPerfCpuClose" Tag="cpu" Click="OnexPerfClose_Click" Content="×" Style="{StaticResource StandaloneButtonStyle}" Width="34" Height="32" Padding="0" HorizontalAlignment="Right"/></Grid><Border x:Name="OnexPerfCpuBaseCard" BorderThickness="0" Background="Transparent" Padding="0" Margin="0">
                            <StackPanel>
                                <!-- Header: title + caption. The Boost toggle (on/off, the only boost control now)
                                     sits on top-right, the "More settings" expander directly BELOW it opens the
                                     advanced submenu (scheduling policy, P/E max freq). -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock x:Uid="OnexCaption153" Text="CPU" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                                <TextBlock x:Uid="OnexCaption154" x:Name="CpuBoostStatusText" Text="Boost" Foreground="#4CAF50" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Uid="OnexCaption155" x:Name="CpuCardCaptionText" Visibility="Collapsed"
                                                       Text="Toggle enables/disables CPU Boost. Expand for scheduling policy and P/E core max frequency."
                                                       Style="{StaticResource CardCaptionStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,12,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Boost on/off — the ONLY boost control (modes removed; no meaningful
                                         difference between Enabled/Aggressive/etc. in practice, and having two
                                         separate writers for one Windows setting caused repeated desync bugs). -->
                                    <ToggleSwitch x:Name="CPUBoostToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  MinWidth="0"
                                                  Margin="0,0,12,0"
                                                  KeyDown="CPUBoostToggle_KeyDown"
                                                  Toggled="CPUBoostToggle_StatusChanged"/>
                                    <!-- Collapse/expand chevron (collapsed by default) -->
                                    <ToggleButton x:Name="CpuCardExpandButton" Visibility="Collapsed" Grid.Column="2" IsChecked="False"
                                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4"
                                                 
                                                  KeyDown="CpuCardExpandButton_KeyDown"
                                                  Click="CpuCardExpandButton_Click" UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="CpuCardExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible content (collapsed by default). -->
                                <StackPanel x:Name="CpuSectionContent" Visibility="Collapsed" Margin="0,12,0,0" Spacing="10">
                                    <!-- Scheduling Policy -->
                                    <StackPanel>
                                        <TextBlock x:Uid="OnexCaption156" Text="Processor Scheduling Policy" Style="{StaticResource CardCaptionStyle}" Margin="0"/>
                                        <ComboBox x:Name="SchedulingPolicyComboBox"
                                                  Margin="0,4,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  KeyDown="CpuAdvancedCombo_KeyDown">
                                            <!-- On Lunar Lake only Auto (default) and Only E-Cores are useful/safe:
                                                 Prefer P/E are hard to verify and Only-P can't park the LP-E island
                                                 without stalling the system. Kept Tag values (0, 4) unchanged. -->
                                            <ComboBoxItem x:Uid="OnexCaption157" Content="Auto (default)" Tag="0" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="OnexCaption158" Content="Only E-Cores" Tag="4"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- P-Core Max Frequency -->
                                    <StackPanel>
                                        <TextBlock x:Uid="OnexCaption159" Text="P-Core Max Frequency" Style="{StaticResource CardCaptionStyle}" Margin="0"/>
                                        <ComboBox x:Name="MaxPCoreFreqComboBox"
                                                  Margin="0,4,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  KeyDown="CpuAdvancedCombo_KeyDown">
                                            <ComboBoxItem x:Uid="OnexCaption160" Content="Unlimited" Tag="0" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="OnexCaption161" Content="4800 MHz" Tag="4800"/>
                                            <ComboBoxItem x:Uid="OnexCaption162" Content="4200 MHz" Tag="4200"/>
                                            <ComboBoxItem x:Uid="OnexCaption163" Content="3600 MHz" Tag="3600"/>
                                            <ComboBoxItem x:Uid="OnexCaption164" Content="3000 MHz" Tag="3000"/>
                                            <ComboBoxItem x:Uid="OnexCaption165" Content="2400 MHz" Tag="2400"/>
                                            <ComboBoxItem x:Uid="OnexCaption166" Content="1800 MHz" Tag="1800"/>
                                            <ComboBoxItem x:Uid="OnexCaption167" Content="1200 MHz" Tag="1200"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- E-Core Max Frequency -->
                                    <StackPanel>
                                        <TextBlock x:Uid="OnexCaption168" Text="E-Core Max Frequency" Style="{StaticResource CardCaptionStyle}" Margin="0"/>
                                        <ComboBox x:Name="MaxECoreFreqComboBox"
                                                  Margin="0,4,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  KeyDown="CpuAdvancedCombo_KeyDown">
                                            <ComboBoxItem x:Uid="OnexCaption169" Content="Unlimited" Tag="0" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="OnexCaption170" Content="2900 MHz" Tag="2900"/>
                                            <ComboBoxItem x:Uid="OnexCaption171" Content="2400 MHz" Tag="2400"/>
                                            <ComboBoxItem x:Uid="OnexCaption172" Content="1800 MHz" Tag="1800"/>
                                            <ComboBoxItem x:Uid="OnexCaption173" Content="1200 MHz" Tag="1200"/>
                                            <ComboBoxItem x:Uid="OnexCaption174" Content="800 MHz" Tag="800"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border></StackPanel></Border><Border x:Name="OnexPerfModeDetail" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
 <StackPanel Spacing="10"><Grid><TextBlock x:Uid="OnexCaption175" Text="OS Power Mode" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="OnexPerfModeClose" Tag="mode" Click="OnexPerfClose_Click" Content="×" Style="{StaticResource StandaloneButtonStyle}" Width="34" Height="32" Padding="0" HorizontalAlignment="Right"/></Grid><Border x:Name="OnexPerfModeBaseCard" BorderThickness="0" Background="Transparent" Padding="0" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="OnexCaption176" x:Name="OnexPowerModeHeading" Grid.Column="0" Text="OS Power Mode"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Uid="OnexCaption177" x:Name="OSPowerModeValue"
                                           Text="Balanced"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="OSPowerModeComboBox"
                                          Grid.Column="1"
                                          MinWidth="180"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="1"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OSPowerModeComboBox_SelectionChanged"
                                         
                                          KeyDown="OSPowerModeComboBox_KeyDown">
                                    <ComboBoxItem x:Uid="OnexCaption178" Content="Best Power Efficiency"/>
                                    <ComboBoxItem x:Uid="OnexCaption179" Content="Balanced"/>
                                    <ComboBoxItem x:Uid="OnexCaption180" Content="Best Performance"/>
                                </ComboBox>
                            </Grid>
                        </Border></StackPanel></Border><Border x:Name="OnexPerfFpsDetail" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
 <StackPanel Spacing="10"><Grid><TextBlock x:Uid="OnexCaption181" Text="FPS Limit" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="OnexPerfFpsClose" Tag="fps" Click="OnexPerfClose_Click" Content="×" Style="{StaticResource StandaloneButtonStyle}" Width="34" Height="32" Padding="0" HorizontalAlignment="Right"/></Grid><Border x:Name="OnexPerfFpsBaseCard" BorderThickness="0" Background="Transparent" Padding="0" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: labels -->
                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption182" Grid.Column="0" Text="FPS Limit"
                                               Style="{StaticResource CardTitleStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FPSLimitValue" Grid.Column="1"
                                               Text="" FontSize="14" Foreground="#4CAF50"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Uid="OnexCaption183" x:Name="FPSStateCycleText" Grid.Row="0" Grid.Column="2"
                                           Text="RTSS" FontSize="11" Foreground="#A0A0A0"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Uid="OnexCaption184" Grid.Row="0" Grid.Column="4"
                                           Text="On / Off" FontSize="11" Foreground="#A0A0A0"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>

                                <!-- Row 1, Col 0: limiter slider (far left) + per-step FPS scale labels -->
                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                    <Slider x:Name="FPSLimitSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="20" Maximum="120"
                                            StepFrequency="1"
                                            IsEnabled="False"
                                            IsThumbToolTipEnabled="False"
                                           
                                           
                                           />
                                    <!-- Scale labels positioned proportionally to the LINEAR slider value
                                         (not evenly spaced) so each tick sits under the thumb at that FPS. -->
                                    <Canvas x:Name="FPSLimitScaleLabels" Height="14" Margin="0,2,0,0"
                                            HorizontalAlignment="Stretch"
                                            SizeChanged="FPSLimitScaleLabels_SizeChanged"/>
                                </StackPanel>

                                <!-- Row 1, Col 2: mode toggle (middle) — DIRECT Grid child.
                                     Deliberately a DIFFERENT colour/look from the accent-coloured
                                     On/Off toggle so the two read as distinct controls: this one is
                                     a violet "mode" switch (RTSS ↔ Intel). Local resources override
                                     the shared accent brushes for this instance only. -->
                                <ToggleSwitch x:Name="FPSModeToggle" Grid.Row="1" Grid.Column="2"
                                              Style="{StaticResource ModernToggleStyle}"
                                              Width="52" VerticalAlignment="Center"
                                              IsTabStop="True"
                                             
                                             
                                             
                                             
                                              Toggled="FPSModeToggle_Toggled"
                                              KeyDown="FPSModeToggle_KeyDown">
                                    <ToggleSwitch.Resources>
                                        <!-- ON state: violet (distinct from the accent On/Off toggle) -->
                                        <SolidColorBrush x:Key="ToggleSwitchFillOn"              Color="#9B6CF0"/>
                                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"   Color="#AB80F4"/>
                                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"       Color="#8A5BE0"/>
                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn"            Color="#9B6CF0"/>
                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#AB80F4"/>
                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"     Color="#8A5BE0"/>
                                        <!-- OFF state: muted violet-tinted track so it differs even when off -->
                                        <SolidColorBrush x:Key="ToggleSwitchFillOff"             Color="#3A335A"/>
                                        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver"  Color="#463E6B"/>
                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOff"           Color="#6B5FA0"/>
                                    </ToggleSwitch.Resources>
                                </ToggleSwitch>

                                <!-- Row 1, Col 4: on/off toggle (far right) — DIRECT Grid child.
                                     Spine: Up → Per-Game profile (or nav), Down → TDP slider. -->
                                <ToggleSwitch x:Name="FPSStateCycleButton" Grid.Row="1" Grid.Column="4"
                                              Style="{StaticResource ModernToggleStyle}"
                                              Width="52" VerticalAlignment="Center"
                                              IsTabStop="True"
                                             
                                             
                                             
                                              Toggled="FPSStateCycleButton_Toggled"
                                              KeyDown="FPSStateCycleButton_KeyDown"/>

                                <!-- Row 2: the two slider options, both widget-local (not per profile).
                                     · Stepless — off: the slider snaps to 24/30/40/45/60/…; on: 1-FPS steps.
                                     · Up to 180 FPS — off (default): ceiling 120, the panel's refresh rate;
