                        <Border x:Name="OnexDeferredImportedLegionScrollViewer7" x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
