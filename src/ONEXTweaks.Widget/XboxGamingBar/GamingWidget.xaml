                                  Glyph="&#xE895;"
                                  FontSize="16"
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Uid="OnexCaption1594" x:Name="ConnectionStatusText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxWidth="320"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

