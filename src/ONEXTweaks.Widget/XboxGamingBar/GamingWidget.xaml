                             (gated in code-behind via UpdateHwControllerExceptionVisibility). When on,
                             the running game uses the native HW controller instead of the virtual
                             Viiper/ViGEm pad — fixes a few titles (e.g. NBA 2K26) that choke on the
                             Viiper usbip controller. The swap is applied at the next game start. -->
                        <Border x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" x:Name="HwControllerExceptionCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption1506" x:Name="HwControllerExceptionTitle" Text="Use Hardware Controller for this Game" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption1507" x:Name="HwControllerExceptionSubtitle"
                                                   Text="Override the standard controller mode for this game only. Helps with titles that have issues with the virtual controller (e.g. NBA 2K26)."
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   Foreground="#C8C8C8"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HwControllerExceptionToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsOn="False"
                                                  Toggled="HwControllerExceptionToggle_Toggled"/>
                                </Grid>
                                <TextBlock x:Uid="OnexCaption1508" x:Name="HwControllerExceptionHint"
                                           Text="Close and restart the game to apply — the controller is only swapped at game start."
                                           Style="{StaticResource CardCaptionStyle}"
                                           Foreground="#FFAA46"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

