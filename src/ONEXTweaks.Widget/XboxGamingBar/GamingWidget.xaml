                                                <ComboBoxItem x:Uid="OnexCaption1089" Content="X"  Tag="X"/>
                                                <ComboBoxItem x:Uid="OnexCaption1090" Content="Y"  Tag="Y"/>
                                                <ComboBoxItem x:Uid="OnexCaption1091" Content="Z"  Tag="Z"/>
                                                <ComboBoxItem x:Uid="OnexCaption1092" Content="-X" Tag="-X"/>
                                                <ComboBoxItem x:Uid="OnexCaption1093" Content="-Y" Tag="-Y"/>
