 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
 <FontIcon Glyph="&#xE790;" FontSize="23" Width="24" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Uid="OnexCaption141" Text="Screen Color Profile" FontWeight="SemiBold" FontSize="18" TextWrapping="WrapWholeWords"/><TextBlock x:Name="OnexPerfScreenSummary" Text="—" FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
 <FontIcon x:Name="OnexPerfScreenChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Grid></Button><Border x:Name="OnexPerfTdpDetail" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
 <StackPanel Spacing="10"><Grid><TextBlock x:Uid="OnexCaption142" Text="TDP Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="OnexPerfTdpClose" Tag="tdp" Click="OnexPerfClose_Click" Content="×" Style="{StaticResource StandaloneButtonStyle}" Width="34" Height="32" Padding="0" HorizontalAlignment="Right"/></Grid><Border x:Name="OnexPerfTdpBaseCard" BorderThickness="0" Background="Transparent" Padding="0" Margin="0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Uid="OnexCaption143" Text="Power Limit (PL1)" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="TDPValueText" local:OnexPowerReadout.IsNeutral="True"
                                               Text="--"
                                               Style="{StaticResource CardValueStyle}"/>
                                </Grid>
                                <!-- MSI Center M warning - shown inline when Center M is active -->
                                <Border x:Name="MsiCenterTDPWarning"
                                        Background="#2A1800"
                                        BorderBrush="#FFA500"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFA500" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <TextBlock x:Uid="OnexCaption144" Text="MSI Center M is active - TDP control unavailable. Disable it via the MSI Center tile in the Quick Tab."
                                                   FontSize="11" Foreground="#FFA500" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Maximum is a PLACEHOLDER, deliberately wider than any supported
                                     device. UpdateTDPSliderBounds narrows it to the helper-reported
                                     PL1 ceiling once that arrives. It must never be a real device's
                                     ceiling: the helper pushes TDP before the capabilities land, and
                                     a too-tight maximum silently coerces the user's own value. -->
                                <Grid x:Name="OnexPerformancePl1Track">
                                <Slider x:Name="TDPSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="7" Maximum="100"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        IsEnabled="False" Value="-5"
                                        IsThumbToolTipEnabled="False"
                                       
                                       
                                        ValueChanged="TDPSlider_ValueChanged_UpdateDisplay"
                                        KeyDown="TDPSlider_KeyDown"/>
                                </Grid>
                                <!-- Watt scale under the slider, positioned proportionally to the linear
                                     value like the FPS limiter's scale. -->
                                <Canvas x:Name="TDPScaleLabels" Height="14" Margin="0,2,0,0"
                                        HorizontalAlignment="Stretch"
                                        SizeChanged="TDPScaleLabels_SizeChanged"/>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Uid="OnexCaption145" x:Name="CurrentTDPText"
                                               Text="Limits:"
                                               FontSize="12"
                                               Foreground="#A0A0A0"/>
                                    <TextBlock x:Uid="OnexCaption146" x:Name="CurrentTDPValueText"
                                               Text="-- W"
                                               FontSize="12"
                                               Foreground="#A0A0A0"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- Hint shown when TDP Mode is not set to Slider -->
                                <TextBlock x:Uid="OnexCaption147" x:Name="TDPSliderModeHint"
                                           Text="Set TDP Mode to &quot;Slider&quot; to enable manual TDP control."
                                           FontSize="11"
                                           Foreground="#FF8C00"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <!-- Overboost (PL2), same card -->
                                

                                

                                <!-- Slider + value: only shown while Overboost is ON. Collapsed when off so
                                     the card stays compact. Driven from TDPBoostToggle_Toggled. -->
                                
                            </StackPanel>
                        </Border>
<Border x:Name="OnexPerfPl2Card" BorderThickness="0" Background="Transparent" Padding="0" Margin="0">
<StackPanel>
<Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption148" Text="Power Limit (PL2)" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption149" x:Name="OnexPl2HelpText" Text="Sets PL2 directly. Must be higher than PL1. Capped at 41W."
