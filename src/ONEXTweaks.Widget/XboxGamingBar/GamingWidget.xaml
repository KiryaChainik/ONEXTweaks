<ScrollViewer x:Name="OnexOverlayScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" BringIntoViewOnFocusChange="True"><StackPanel x:Name="OnexOverlayBody" Padding="16,8,16,16" Spacing="10"><TextBlock x:Uid="OnexCaption64" x:Name="OnexOverlayConnectionCaption" Text="RTSS · Connecting…" TextWrapping="Wrap"/><Border x:Name="OnexOverlaySettingsCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header: title + overlay level dropdown (always visible) + expand toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption65" Text="Overlay"
                                               Style="{StaticResource CardTitleStyle}"
                                               VerticalAlignment="Center"
                                               Grid.Column="0"/>
                                    <ComboBox x:Name="PerformanceOverlayComboBox"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Width="150"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              SelectionChanged="PerformanceOverlayComboBox_SelectionChanged"
                                              KeyDown="PerformanceOverlayComboBox_KeyDown"
                                              XYFocusLeft="{x:Bind PerformanceNavItem}"
                                              XYFocusDown="{x:Bind CpuCardExpandButton}">
                                        <ComboBoxItem x:Uid="OnexCaption66" Content="Off" Tag="0" IsSelected="True"/>
                                        <ComboBoxItem x:Uid="OnexCaption67" Content="Basic" Tag="1"/>
                                        <ComboBoxItem x:Uid="OnexCaption68" Content="Horizontal" Tag="2"/>
                                        <ComboBoxItem x:Uid="OnexCaption69" Content="Horizontal Custom" Tag="3"/>
                                        <ComboBoxItem x:Uid="OnexCaption70" Content="Vertical Custom" Tag="4"/>
                                    </ComboBox>
                                    <ToggleButton x:Name="OSDCustomizeExpandButton"
                                                  Grid.Column="2"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="OSDCustomizeExpandButton_Click"
                                                  KeyDown="OSDCustomizeExpandButton_KeyDown"
                                                  UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="OSDCustomizeExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Hidden slider for property system compatibility -->
                                <Slider x:Name="PerformanceOverlaySlider"
                                        Visibility="Collapsed"
                                        Minimum="0" Maximum="4"
                                        Value="0"
                                        ValueChanged="PerformanceOverlaySlider_ValueChanged"/>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="OSDCustomizeContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <!-- OSD Provider and Overlay Level hidden — kept for code-behind compat.
                                         NOT the renderer switch below: this one is the old AMD-overlay
                                         path and only writes a widget-local setting. -->
                                    <ComboBox x:Name="OSDProviderComboBox" Visibility="Collapsed"
                                              SelectionChanged="OSDProviderComboBox_SelectionChanged">
                                        <ComboBoxItem x:Uid="OnexCaption71" Content="RTSS" Tag="0" IsSelected="True"/>
                                        <ComboBoxItem x:Uid="OnexCaption72" Content="AMD" Tag="1"/>
                                    </ComboBox>

                                    <!-- Which renderer draws the overlay. The same choice exists on the
                                         Game Bar widget's own settings page, but that page lives in a
                                         menu that is close to unreachable with a controller, so it is
                                         here too - both bound to the same helper value, so they cannot
                                         disagree. Tags are the helper's provider indices. -->
                                    <TextBlock x:Uid="OnexCaption73" Text="Renderer" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Uid="OnexCaption74" x:Name="OsdRendererCaption"
                                               Text="RTSS draws inside games only. The built-in overlay also shows on the desktop."
                                               Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <!-- Two columns: which renderer, and where it sits. Position is for
                                         the built-in overlay only and greys out under RTSS, which has
                                         no alignment control we could drive - it keeps its position in
                                         its own configuration. The six anchor points are MSI's
                                         (MCMOSDInfo RealtimeMonitorPosition).

                                         KeyDown, not XYFocus: this panel moves focus through the
                                         explicit OsdPanelNavOrder list because ComboBoxes swallow D-pad
                                         keys. Both boxes are in that list; a disabled one is skipped
                                         there automatically, which is why nothing has to unhook a
                                         focus link when the position box greys out. -->
                                    <Grid x:Name="OSDRendererPickerRow" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="OsdRendererComboBox" Grid.Column="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OsdRendererComboBox_SelectionChanged"
                                                  KeyDown="OsdPanelNav_KeyDown"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="OnexCaption75" Content="RTSS"                  Tag="0"/>
                                            <ComboBoxItem x:Uid="OnexCaption76" Content="ONEXTweaks (built-in)" Tag="1"/>
                                        </ComboBox>

                                        <ComboBox x:Name="OsdPositionComboBox" Grid.Column="2"
                                                  HorizontalAlignment="Stretch"
                                                  KeyDown="OsdPanelNav_KeyDown"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="OnexCaption77" Content="Top left"      Tag="1"/>
                                            <ComboBoxItem x:Uid="OnexCaption78" Content="Top center"    Tag="2"/>
                                            <ComboBoxItem x:Uid="OnexCaption79" Content="Top right"     Tag="3"/>
                                            <ComboBoxItem x:Uid="OnexCaption80" Content="Bottom left"   Tag="4"/>
                                            <ComboBoxItem x:Uid="OnexCaption81" Content="Bottom center" Tag="5"/>
                                            <ComboBoxItem x:Uid="OnexCaption82" Content="Bottom right"  Tag="6"/>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="RTSSOptionsPanel">
                                        <!-- Layout Settings Section -->
                                    <TextBlock x:Uid="OnexCaption83" Text="Layout"
                                               Style="{StaticResource CardTitleStyle}"
                                               Margin="0,0,0,8"/>

                                    <!-- Columns (hidden — both custom presets have a fixed layout: Vertical Custom
                                         is a 1-column list, Horizontal Custom is pinned to 7 columns so its
                                         default item set keeps wrapping onto a second row) -->
                                    <Grid Margin="0,0,0,8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Uid="OnexCaption84" Text="Columns"
                                                       Foreground="#B0B0B0"
                                                       FontSize="13"/>
                                            <TextBlock x:Uid="OnexCaption85" Text="Items per row (1 = vertical list)"
                                                       Foreground="#707070"
                                                       FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="OSDColumnsComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="80"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDLayoutOption_Changed"
                                                  KeyDown="OsdPanelNav_KeyDown"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White">
                                            <ComboBoxItem Content="1" Tag="1"/>
                                            <ComboBoxItem Content="2" Tag="2"/>
                                            <ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
                                            <ComboBoxItem Content="4" Tag="4"/>
                                            <ComboBoxItem Content="5" Tag="5"/>
                                            <ComboBoxItem Content="6" Tag="6"/>
                                            <ComboBoxItem Content="7" Tag="7"/>
                                            <ComboBoxItem Content="8" Tag="8"/>
                                            <ComboBoxItem Content="9" Tag="9"/>
                                            <ComboBoxItem Content="10" Tag="10"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Overlay Size (scales the whole overlay proportionally) -->
                                    <Grid x:Name="OSDTextSizeRow" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption86" Text="Overlay Size"
                                                   Foreground="#B0B0B0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <ComboBox x:Name="OSDTextSizeComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="100"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDLayoutOption_Changed"
                                                  KeyDown="OsdPanelNav_KeyDown"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White">
                                            <ComboBoxItem x:Uid="OnexCaption87" Content="Small" Tag="50"/>
                                            <ComboBoxItem x:Uid="OnexCaption88" Content="Medium" Tag="100"/>
                                            <ComboBoxItem x:Uid="OnexCaption89" Content="Medium-Large" Tag="125"/>
                                            <ComboBoxItem x:Uid="OnexCaption90" Content="Default" Tag="150" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="OnexCaption91" Content="Large" Tag="175"/>
                                            <ComboBoxItem x:Uid="OnexCaption92" Content="X-Large" Tag="200"/>
                                            <ComboBoxItem x:Uid="OnexCaption93" Content="XX-Large" Tag="250"/>
                                            <ComboBoxItem x:Uid="OnexCaption94" Content="XXX-Large" Tag="300"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Overlay Font (applied to the RTSS Global profile; helper restarts RTSS briefly) -->
                                    <Grid x:Name="OSDFontRow" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption95" Text="Overlay Font"
                                                   Foreground="#B0B0B0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <ComboBox x:Name="OSDFontComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="190"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDFontComboBox_SelectionChanged"
                                                  KeyDown="OsdPanelNav_KeyDown"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White">
                                            <!-- Bahnschrift named instances. The weight is baked into the
                                                 face name, so all use RTSS Weight 400. Each item is rendered
                                                 in its own variant for a live preview. Falls back to RTSS's
                                                 Unispace helper-side if a face isn't installed. -->
                                            <ComboBoxItem x:Uid="OnexCaption96" Content="Bahnschrift" Tag="Bahnschrift|400" IsSelected="True" FontFamily="Bahnschrift"/>
                                            <ComboBoxItem x:Uid="OnexCaption97" Content="Bahnschrift Light" Tag="Bahnschrift Light|400" FontFamily="Bahnschrift Light"/>
                                            <ComboBoxItem x:Uid="OnexCaption98" Content="Bahnschrift SemiLight" Tag="Bahnschrift SemiLight|400" FontFamily="Bahnschrift SemiLight"/>
                                            <ComboBoxItem x:Uid="OnexCaption99" Content="Bahnschrift SemiBold" Tag="Bahnschrift SemiBold|400" FontFamily="Bahnschrift SemiBold"/>
                                            <ComboBoxItem x:Uid="OnexCaption100" Content="Bahnschrift Condensed" Tag="Bahnschrift Condensed|400" FontFamily="Bahnschrift Condensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption101" Content="Bahnschrift SemiCondensed" Tag="Bahnschrift SemiCondensed|400" FontFamily="Bahnschrift SemiCondensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption102" Content="Bahnschrift Light Condensed" Tag="Bahnschrift Light Condensed|400" FontFamily="Bahnschrift Light Condensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption103" Content="Bahnschrift Light SemiCondensed" Tag="Bahnschrift Light SemiCondensed|400" FontFamily="Bahnschrift Light SemiCondensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption104" Content="Bahnschrift SemiLight Condensed" Tag="Bahnschrift SemiLight Condensed|400" FontFamily="Bahnschrift SemiLight Condensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption105" Content="Bahnschrift SemiLight SemiCondensed" Tag="Bahnschrift SemiLight SemiCondensed|400" FontFamily="Bahnschrift SemiLight SemiCondensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption106" Content="Bahnschrift SemiBold Condensed" Tag="Bahnschrift SemiBold Condensed|400" FontFamily="Bahnschrift SemiBold Condensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption107" Content="Bahnschrift SemiBold SemiCondensed" Tag="Bahnschrift SemiBold SemiCondensed|400" FontFamily="Bahnschrift SemiBold SemiCondensed"/>
                                            <ComboBoxItem x:Uid="OnexCaption108" Content="RTSS default (Unispace)" Tag="Unispace|400"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Colors Section -->
                                    <TextBlock x:Uid="OnexCaption109" Text="Colors"
                                               Style="{StaticResource CardTitleStyle}"
                                               Margin="0,12,0,8"/>

                                    <!-- Text Color -->
                                    <StackPanel x:Name="OSDTextColorCard" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption110" Text="Text Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Uid="OnexCaption111" x:Name="OSDTextColorDynamicCheckBox"
                                                          Content="Dynamic"
                                                          IsChecked="True"
                                                          Foreground="#AAAAAA"
                                                          FontSize="11"
                                                          Margin="0,0,8,0"
                                                          KeyDown="OsdPanelNav_KeyDown"
                                                          Checked="OSDTextColorDynamic_Changed"
                                                          Unchecked="OSDTextColorDynamic_Changed"/>
                                                <Border x:Name="OSDTextColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="OSDTextColorExpandButton"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="OSDTextColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="OSDTextColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="White"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="OSDTextColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- Label Color (Global) -->
                                    <StackPanel x:Name="OSDLabelColorCard" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption112" Text="Label Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Uid="OnexCaption113" x:Name="OSDLabelColorDefaultCheckBox"
                                                          Content="Default"
                                                          IsChecked="True"
                                                          Foreground="#AAAAAA"
                                                          FontSize="11"
                                                          Margin="0,0,8,0"
                                                          KeyDown="OsdPanelNav_KeyDown"
                                                          Checked="OSDLabelColorDefault_Changed"
                                                          Unchecked="OSDLabelColorDefault_Changed"/>
                                                <Border x:Name="OSDLabelColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="#00FFFF"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="OSDLabelColorExpandButton"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="OSDLabelColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="OSDLabelColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="#00FFFF"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="OSDLabelColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- OSD Opacity Slider (for OLED protection) -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption114" Grid.Column="0" Text="OSD Opacity" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                                            <TextBlock x:Name="OSDOpacityValue"
                                                       Grid.Column="1"
                                                       Text="100%" FontSize="13" Foreground="#4CAF50"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Uid="OnexCaption115" Text="Reduce OSD brightness to protect OLED pixels" Foreground="#707070" FontSize="11" Margin="0,2,0,4"/>
                                        <Slider x:Name="OSDOpacitySlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="10" Maximum="100"
                                                TickFrequency="5" StepFrequency="1" SmallChange="5" LargeChange="5"
                                                SnapsTo="StepValues"
                                                Value="100"
                                                XYFocusUp="{x:Bind OSDLabelColorDefaultCheckBox}"
                                                XYFocusDown="{x:Bind OSDBackgroundToggle}"
                                                ValueChanged="OSDOpacitySlider_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Background: RTSS's native OSD fill (a real backdrop box behind the
                                         text, rendered/sized by RTSS itself — works with every overlay
                                         level/layout since it's not a per-line tag). Boxed separately so
                                         it doesn't visually blend with the OSD Opacity slider above. -->
                                    <Border Background="#20203A" BorderBrush="#3A3A5C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel x:Name="OSDBackgroundCard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Uid="OnexCaption116" Text="Background" Foreground="#AAAAAA" FontSize="13"/>
                                                <TextBlock x:Uid="OnexCaption117" Text="Adds a dark backdrop behind the overlay for better contrast" Foreground="#707070" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="OSDBackgroundToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          KeyDown="OsdPanelNav_KeyDown"
                                                          Toggled="OSDBackgroundToggle_Toggled"/>
                                        </Grid>
                                        <StackPanel x:Name="OSDBackgroundOpacityPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption118" Grid.Column="0" Text="Background Opacity" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                                                <TextBlock x:Name="OSDBackgroundOpacityValue"
                                                           Grid.Column="1"
                                                           Text="60%" FontSize="13" Foreground="#4CAF50"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="OSDBackgroundOpacitySlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="10" Maximum="100"
                                                    TickFrequency="5" StepFrequency="1" SmallChange="5" LargeChange="5"
                                                    SnapsTo="StepValues"
                                                    Value="60"
                                                    Margin="0,2,0,0"
                                                    XYFocusUp="{x:Bind OSDBackgroundToggle}"
                                                    XYFocusDown="{x:Bind OSDPositionShiftToggle}"
                                                    ValueChanged="OSDBackgroundOpacitySlider_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <!-- Position Shift Toggle (OLED burn-in protection) — hidden -->
                                    <Grid Margin="0,4,0,8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption119" Text="Position Shift" Foreground="#AAAAAA" FontSize="13"/>
                                            <TextBlock x:Uid="OnexCaption120" Text="Shifts OSD every minute to prevent burn-in" Foreground="#707070" FontSize="11"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="OSDPositionShiftToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      KeyDown="OsdPanelNav_KeyDown"
                                                      Toggled="OSDPositionShiftToggle_Toggled"/>
                                    </Grid>

                                    <!-- Frametime Graph Pinned Toggle — hidden -->
                                    <Grid Margin="0,4,0,8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption121" Text="Pin Frametime Graph" Foreground="#AAAAAA" FontSize="13"/>
                                            <TextBlock x:Uid="OnexCaption122" Text="Always display graph on its own row at bottom" Foreground="#707070" FontSize="11"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FrametimeGraphPinnedToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      KeyDown="OsdPanelNav_KeyDown"
                                                      Toggled="FrametimeGraphPinnedToggle_Toggled"/>
                                    </Grid>

                                        <!-- Items Section -->
                                        <TextBlock x:Uid="OnexCaption123" Text="Items to Display"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,12,0,2"/>
                                        <TextBlock x:Uid="OnexCaption124" Text="Pick which of the two custom presets to edit — the checkboxes below show what that preset displays, in its own order. Basic and Horizontal are fixed ONEXTweaks presets and are not editable."
                                                   Foreground="#C8C8C8" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <!-- Which preset the item list below edits (levels 3 and 4) -->
                                        <Grid x:Name="OSDCustomizePresetRow" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption125" Text="Preset"
                                                       Foreground="#C8C8C8"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="OSDCustomizeLevelComboBox"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      Width="160"
                                                      Grid.Column="1"
                                                      SelectionChanged="OSDCustomizeLevelComboBox_SelectionChanged"
                                                      KeyDown="OsdPanelNav_KeyDown"
                                                      UseSystemFocusVisuals="True"
                                                      FocusVisualPrimaryBrush="White">
                                                <ComboBoxItem x:Uid="OnexCaption126" Content="Horizontal Custom" Tag="3"/>
                                                <ComboBoxItem x:Uid="OnexCaption127" Content="Vertical Custom" Tag="4" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>

                                        <TextBlock x:Uid="OnexCaption128" x:Name="OSDCustomizeLevelHint"
                                                   Text="Editing the overlay that is active right now."
                                                   Foreground="#C8C8C8" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,-4,0,8"/>

                                        <!-- OSD Items with reordering -->
                                        <ItemsControl x:Name="OSDItemsControl" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="OnexMetricRow" Margin="0,2" Loaded="OnexOverlayMetricRow_Loaded">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Label and checkbox are separate so the checkbox can sit
                                                             on the right, directly next to the reorder buttons. -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DisplayName}"
                                                                   Margin="0,0,44,0"
                                                                   ToolTipService.ToolTip="{Binding Description}"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>

                                                        <CheckBox Grid.Column="1"
                                                                  x:Name="OsdItemCheckBox"
                                                                  MinWidth="0"
                                                                  Width="44" MinHeight="40"
                                                                  Margin="8,0,0,0"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Foreground="#FFFFFF"
                                                                  Tag="{Binding Id}"
                                                                  ToolTipService.ToolTip="{Binding Description}"
                                                                  VerticalAlignment="Center"
                                                                  UseSystemFocusVisuals="True"
                                                                  FocusVisualPrimaryBrush="White"
                                                                  FocusVisualSecondaryBrush="Transparent"
                                                                  KeyDown="OsdItemCheckBox_KeyDown"
                                                                  Checked="OSDItemCheckBox_Changed"
                                                                  Unchecked="OSDItemCheckBox_Changed"/>

                                                        <Button Template="{StaticResource OnexMetricActionTemplate}" Grid.Column="2"
                                                                Content="&#xE70E;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Width="36" Height="40"
                                                                Padding="0"
                                                                Margin="4,0,0,0"
                                                                Background="Transparent"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                x:Name="OsdItemMoveUpButton"
                                                                Click="OSDItemMoveUp_Click"/>

                                                        <Button Template="{StaticResource OnexMetricActionTemplate}" Grid.Column="3"
                                                                Content="&#xE70D;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Width="36" Height="40"
                                                                Padding="0"
                                                                Margin="4,0,0,0"
                                                                Background="Transparent"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                x:Name="OsdItemMoveDownButton"
                                                                Click="OSDItemMoveDown_Click"/>
                                                        <Button Template="{StaticResource OnexMetricActionTemplate}" Grid.Column="0" Content="?" Width="36" Height="40" MinWidth="0" MinHeight="0"
                                                                Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Background="Transparent"
                                                                IsTabStop="False" ToolTipService.ToolTip="{Binding Description}"
                                                                Click="OnexOverlayHelp_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Custom RTSS Tags Section -->
                                        <TextBlock x:Uid="OnexCaption129" Text="Custom RTSS Tags"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,16,0,4"/>
                                        <TextBlock x:Uid="OnexCaption130" Text="Add custom RTSS tags (e.g. &lt;FR&gt; for FPS)"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Uid="OnexCaption131" x:Name="OSDCustomTagsTextBox"
                                                 PlaceholderText="Enter custom RTSS tags..."
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="60"
                                                 TextChanged="OSDCustomTagsTextBox_TextChanged"/>
                                    </StackPanel>

                                    <!-- AMD-specific info (shown when AMD provider is selected) -->
                                    <StackPanel x:Name="AMDOptionsPanel" Visibility="Collapsed">
                                        <TextBlock x:Uid="OnexCaption132" Text="AMD Adrenaline Overlay"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock x:Uid="OnexCaption133" Text="The AMD overlay is controlled through Adrenaline software. Use Ctrl+Shift+O to toggle and Ctrl+Shift+X to cycle overlay levels."
                                                   Foreground="#A0A0A0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border></StackPanel></ScrollViewer>
                <!-- PERFORMANCE TAB -->
                <ScrollViewer x:Name="PerformanceScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">
<Grid x:Name="OnexPerfCardGrid" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button x:Name="OnexPerfTdpCard" Grid.Row="0" Grid.Column="0" Tag="tdp" Click="OnexPerfCard_Click" Style="{StaticResource StandaloneButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" MinHeight="104" Margin="0,0,0,10" Padding="14,12">
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
 <FontIcon Glyph="&#xE945;" FontSize="23" Width="24" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Uid="OnexCaption134" Text="TDP Settings" FontWeight="SemiBold" FontSize="18" TextWrapping="WrapWholeWords"/><TextBlock x:Name="OnexPerfTdpSummary" Text="—" FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
 <FontIcon x:Name="OnexPerfTdpChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Grid></Button><Button x:Name="OnexPerfCpuCard" Grid.Row="0" Grid.Column="1" Tag="cpu" Click="OnexPerfCard_Click" Style="{StaticResource StandaloneButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" MinHeight="104" Margin="0,0,0,10" Padding="14,12">
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
 <FontIcon Glyph="&#xE950;" FontSize="23" Width="24" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Uid="OnexCaption135" Text="CPU Settings" FontWeight="SemiBold" FontSize="18" TextWrapping="WrapWholeWords"/><TextBlock x:Name="OnexPerfCpuSummary" Text="—" FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
 <FontIcon x:Name="OnexPerfCpuChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Grid></Button><Button x:Name="OnexPerfModeCard" Grid.Row="2" Grid.Column="0" Tag="mode" Click="OnexPerfCard_Click" Style="{StaticResource StandaloneButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" MinHeight="104" Margin="0,0,0,10" Padding="14,12">
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
 <FontIcon Glyph="&#xE7E8;" FontSize="23" Width="24" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
