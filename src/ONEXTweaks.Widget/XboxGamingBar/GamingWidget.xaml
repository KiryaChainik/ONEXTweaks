                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Refresh"
                                            Click="ControllerStateRefreshButton_Click">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                    <ToggleButton x:Name="ControllerStateDetailsToggle"
                                                  Grid.Column="2"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="ControllerStateDetailsToggle_Click">
                                        <FontIcon x:Name="ControllerStateDetailsIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Main status row: colored dot + state text -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="ControllerStateDot" Width="12" Height="12" Fill="#666666" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="OnexCaption1511" x:Name="ControllerStateText"
                                               Text="Status unknown"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Uid="OnexCaption1512" x:Name="ControllerStateCaption"
                                           Text="Tap Refresh to check the current state."
                                           Style="{StaticResource CardCaptionStyle}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"/>


                                <!-- Details (collapsed by default) -->
                                <StackPanel x:Name="ControllerStateDetailsPanel" Spacing="8" Margin="0,14,0,0" Visibility="Collapsed">
                                    <!-- Console-style controller list -->
                                    <Border Background="#0D0D0D"
                                            BorderBrush="#333333"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            Margin="0,4,0,0">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Uid="OnexCaption1513" Text="CONNECTED CONTROLLERS"
                                                       FontFamily="Consolas, Courier New"
                                                       FontSize="10"
                                                       Foreground="#555555"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock x:Uid="OnexCaption1514" x:Name="ControllerListConsole"
                                                       Text="scanning..."
                                                       FontFamily="Consolas, Courier New"
                                                       FontSize="11"
                                                       Foreground="#DDDDDD"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1515" Text="Virtual ViGEm controller" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="ControllerStateViGEmValue" Text="–" Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1516" Text="Virtual VIIPER controller" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="ControllerStateViiperValue" Text="–" Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1517" Text="Game controllers" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="ControllerStatePid1901Value" Text="–" Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1518" Text="MSI Claw DInput (PID_1902)" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="ControllerStatePid1902Value" Text="–" Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1519" Text="HidHide blocked devices" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="ControllerStateBlockedValue" Text="–" Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1520" Text="XInput slots connected" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="ControllerStateXInputValue" Text="–" Style="{StaticResource CardValueStyle}"/>
                                    </Grid>

                                <!-- VIIPER device picker (relocated here from the Controller Emulation card).
                                     On the MSI Claw only the virtual device TYPE is functional: VIIPER is fed
                                     from ClawButtonMonitor's submit point, so the GoTweaks forwarder settings
                                     (input/gyro source, IMU axis map, gyro→stick) don't apply and stay hidden in
                                     the (now never-shown) ViiperEmulationContent. Shown only while VIIPER is the
                                     active backend; placed at the bottom of the controller-status card. -->
                                <StackPanel x:Name="ViiperDeviceConfigPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Border Background="#1E2A3E" BorderBrush="#3D5A80" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock x:Uid="OnexCaption1521" Text="VIIPER Device" FontSize="13" FontWeight="SemiBold" Foreground="#4AB3F4"/>
                                            <TextBlock x:Uid="OnexCaption1522" Text="Active backend: VIIPER (USBIP). Changes take effect immediately (hot-swap). Note: any virtual device other than Xbox 360 can cause problems due to Game Bar incompatibilities — please test it and report back with feedback." FontSize="11" Foreground="{StaticResource HintTextBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                                            <TextBlock x:Uid="OnexCaption1523" Text="Virtual device" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ViiperDeviceTypeComboBox" HorizontalAlignment="Stretch">
                                                <ComboBoxItem x:Uid="OnexCaption1524" Content="Xbox 360" Tag="xbox360"/>
                                                <ComboBoxItem x:Uid="OnexCaption1525" Content="DualShock 4" Tag="dualshock4"/>
                                                <ComboBoxItem x:Uid="OnexCaption1526" Content="DualSense Edge" Tag="dualsenseedge"/>
                                                <ComboBoxItem x:Uid="OnexCaption1527" Content="Xbox Elite 2" Tag="xboxelite2"/>
                                                <ComboBoxItem x:Uid="OnexCaption1528" Content="Steam Controller" Tag="steam-generic"/>
                                                <ComboBoxItem x:Uid="OnexCaption1529" Content="Switch Pro" Tag="switchpro"/>
                                            </ComboBox>

                                            <StackPanel x:Name="ViiperSteamSubDevicePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <TextBlock x:Uid="OnexCaption1530" Text="Steam sub-device" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="ViiperSteamSubDeviceComboBox" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem x:Uid="OnexCaption1531" Content="Generic" Tag="generic"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1532" Content="Steam Deck" Tag="steam-deck"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1533" Content="Legion Go" Tag="legion-go"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1534" Content="Legion Go S" Tag="legion-go-s"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1535" Content="Legion Go 2" Tag="legion-go-2"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1536" Content="ROG Ally" Tag="rog-ally"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1537" Content="MSI Claw" Tag="msi-claw"/>
                                                    <ComboBoxItem x:Uid="OnexCaption1538" Content="Zotac Zone" Tag="zotac-zone"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Experimental: auto-swap a non-Xbox device to xbox360 while the Game Bar is open.
                                                 Relocated here from the (Claw-hidden) ViiperEmulationContent panel so it is
                                                 actually reachable; property wiring (viiperGameBarAutoXboxSwap) is unchanged. -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Uid="OnexCaption1539" Text="Auto-switch to Xbox in Game Bar (experimental)"
                                                               FontSize="13"
                                                               Foreground="#CCCCCC"/>
                                                    <TextBlock x:Uid="OnexCaption1540" Text="When a non-Xbox device (e.g. DualShock 4) is emulated, temporarily present it as an Xbox 360 pad while the Game Bar is open so the overlay navigates cleanly (some pads spam the right trigger). Swaps back on close. Briefly disconnects the virtual controller — a running game may notice."
                                                               FontSize="11"
                                                               Foreground="{StaticResource HintTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="ViiperGameBarAutoXboxSwapToggle"
                                                              Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource ModernToggleStyle}"
                                                              IsOn="False"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                </StackPanel>

                                <!-- Firmware keyboard-remap backend toggle (MSI Claw A2VM only; shown via
                                     DeviceSupportsFirmwareKeyboardRemap capability). Always visible at the
                                     bottom of the card (outside the collapsed details), per plan. -->
                                <StackPanel x:Name="FwKeyboardRemapPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Border Background="#1E2A3E" BorderBrush="#3D5A80" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption1541" Text="Keyboard remaps via firmware (works in games)"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#4AB3F4"/>
                                                <TextBlock x:Uid="OnexCaption1542" Text="Firmware key remaps run entirely on the controller hardware, so they work reliably — including inside games. When off, keystrokes are generated virtually (software), which can stop in-game shortcuts from working; turn this on to use the firmware remaps instead. MSI Claw 8/7 AI+ (A2VM) only."
                                                           FontSize="11" Foreground="{StaticResource HintTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="MsiClawFwKeyboardModeToggle"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"/>
                                        </Grid>
                                    </Border>

                                    <!-- Live firmware button→key readout (reads the controller EEPROM on demand). -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1543" Grid.Column="0" Text="Show current firmware keyboard mappings" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                        <Button x:Uid="OnexCaption1544" Grid.Column="1" Content="Re-read firmware" Style="{StaticResource ModernButtonStyle}"
                                                FontSize="11" Padding="10,4" Click="FwButtonMapRefresh_Click"/>
                                    </Grid>
                                    <TextBlock x:Uid="OnexCaption1545" x:Name="FwButtonMapText" Text="Tap Refresh to read the controller."
                                               FontFamily="Consolas, Courier New" FontSize="11"
                                               Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- GPD TAB -->
                <ScrollViewer x:Name="GPDScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Device Status Card -->
                        <Border x:Name="OnexDeferredImportedGPDScrollViewer12" x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption1546" x:Name="GPDDeviceNameText" Text="GPD Device" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Uid="OnexCaption1547" x:Name="GPDConnectionStatusText"
                                           Text="Detecting..."
                                           FontSize="14"
                                           Foreground="{StaticResource HintTextBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fan Control Card (Win 5 specific) -->
                        <StackPanel x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" x:Name="GPDFanControlSection" Visibility="Collapsed">
                            <TextBlock x:Uid="OnexCaption1548" Text="FAN CONTROL" Style="{StaticResource SectionHeaderStyle}"/>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <!-- Header: Fan Settings + RPM -->
                                    <TextBlock x:Uid="OnexCaption1549" Text="Fan Settings" Style="{StaticResource CardTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Uid="OnexCaption1550" Text="Fan: " Style="{StaticResource CardCaptionStyle}"/>
                                        <TextBlock x:Uid="OnexCaption1551" x:Name="GPDFanRPMText" Text="-- RPM" Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>

                                    <!-- Fan Curve Toggle -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Uid="OnexCaption1552" Text="Fan Curve" Foreground="#FFFFFF" FontSize="14"/>
                                            <TextBlock x:Uid="OnexCaption1553" Text="Software-controlled fan curve based on CPU temperature"
                                                       FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="GPDFanCurveToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      Toggled="GPDFanCurveToggle_Toggled"
                                                      XYFocusUp="{x:Bind GPDNavItem}"/>
                                    </Grid>

                                    <!-- Manual Fan Controls (visible when curve OFF) -->
                                    <StackPanel x:Name="GPDManualFanContent">
                                        <!-- Fan Mode Toggle -->
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Uid="OnexCaption1554" Text="Fan Mode" Foreground="#FFFFFF" FontSize="14"/>
                                                <TextBlock x:Uid="OnexCaption1555" x:Name="GPDFanModeText"
                                                           Text="Auto"
                                                           FontSize="12"
                                                           Foreground="{StaticResource HintTextBrush}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="GPDFanModeToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"
                                                          Toggled="GPDFanModeToggle_Toggled"/>
                                        </Grid>

                                        <!-- Fan Speed Slider (visible only in manual mode) -->
                                        <StackPanel x:Name="GPDFanSpeedSection" Margin="0,16,0,0" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption1556" Text="Fan Speed" Grid.Column="0" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GPDFanSpeedValueText"
                                                           Grid.Column="1"
                                                           Text="50%"
                                                           FontSize="14"
                                                           Foreground="#00C8FF"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="GPDFanSpeedSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="30"
                                                    Maximum="100"
                                                    Value="50"
                                                    ValueChanged="GPDFanSpeedSlider_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Fan Curve Content (visible when curve ON) -->
                                    <StackPanel x:Name="GPDFanCurveContent" Visibility="Collapsed">
                                        <!-- Preset + Expand toggle row -->
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="GPDFanCurvePresetComboBox"
                                                      Grid.Column="0"
                                                      Width="130"
                                                      HorizontalAlignment="Left"
                                                      SelectionChanged="GPDFanCurvePresetComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="OnexCaption1557" Content="Silent" Tag="Silent"/>
                                                <ComboBoxItem x:Uid="OnexCaption1558" Content="Balanced" Tag="Balanced"/>
                                                <ComboBoxItem x:Uid="OnexCaption1559" Content="Performance" Tag="Performance"/>
                                                <ComboBoxItem x:Uid="OnexCaption1560" Content="Max Cooling" Tag="MaxCooling"/>
                                                <ComboBoxItem x:Uid="OnexCaption1561" Content="Custom" Tag="Custom" IsSelected="True"/>
                                            </ComboBox>
                                            <ToggleButton x:Name="GPDFanCurveExpandToggle"
                                                          Grid.Column="1"
                                                          IsChecked="False"
                                                          VerticalAlignment="Center"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="8,4"
                                                          Click="GPDFanCurveExpandToggle_Click">
                                                <FontIcon x:Name="GPDFanCurveExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                            </ToggleButton>
                                        </Grid>

                                        <!-- Expandable graph content -->
                                        <StackPanel x:Name="GPDFanCurveGraphContent" Margin="0,12,0,0" Visibility="Collapsed">
                                            <!-- Y-axis label -->
                                            <TextBlock x:Uid="OnexCaption1562" Text="Fan %" FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>

                                            <!-- Graph area -->
                                            <Grid Height="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Y-axis labels -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                                                    <TextBlock Text="100" FontSize="10" Foreground="#666666" VerticalAlignment="Top"/>
                                                    <TextBlock Text="75" FontSize="10" Foreground="#666666" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                    <TextBlock Text="50" FontSize="10" Foreground="#666666" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                    <TextBlock Text="25" FontSize="10" Foreground="#666666" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                    <TextBlock Text="0" FontSize="10" Foreground="#666666" VerticalAlignment="Bottom"/>
                                                </StackPanel>

                                                <!-- Canvas for drawing the graph -->
                                                <Canvas x:Name="GPDFanCurveCanvas"
                                                        Grid.Column="1"
                                                        Background="#1A1A1A"
                                                        PointerPressed="GPDFanCurveCanvas_PointerPressed"
                                                        PointerMoved="GPDFanCurveCanvas_PointerMoved"
                                                        PointerReleased="GPDFanCurveCanvas_PointerReleased"
                                                        PointerCaptureLost="GPDFanCurveCanvas_PointerReleased"
                                                        SizeChanged="GPDFanCurveCanvas_SizeChanged">

                                                    <!-- Fill under the curve -->
                                                    <Polygon x:Name="GPDFanCurveFill"
                                                             Fill="#3300AAFF"
                                                             Stroke="Transparent"/>

                                                    <!-- The curve line -->
                                                    <Polyline x:Name="GPDFanCurvePolyline"
                                                              Stroke="#00AAFF"
                                                              StrokeThickness="2"
                                                              StrokeLineJoin="Round"/>

                                                    <!-- Temperature indicator line (vertical dashed orange) -->
                                                    <Line x:Name="GPDTempIndicatorLine"
                                                          Y1="0" Y2="150"
                                                          Stroke="#FF8800"
                                                          StrokeThickness="2"
                                                          StrokeDashArray="4,2"
                                                          Visibility="Collapsed"/>

                                                    <!-- Control points created in code-behind -->
                                                </Canvas>
                                            </Grid>

                                            <!-- X-axis labels (30°C to 100°C) -->
                                            <Grid Margin="30,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption1563" Grid.Column="0" Text="30°C" FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                                                <TextBlock x:Uid="OnexCaption1564" Grid.Column="1" Text="46°C" FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                                                <TextBlock x:Uid="OnexCaption1565" Grid.Column="2" Text="62°C" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock x:Uid="OnexCaption1566" Grid.Column="3" Text="78°C" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                                                <TextBlock x:Uid="OnexCaption1567" Grid.Column="4" Text="100°C" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Current CPU temperature display -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption1568" Text="CPU Temp: " FontSize="12" Foreground="#999999"/>
                                                <TextBlock x:Uid="OnexCaption1569" x:Name="GPDCurrentTempLabel" Text="--°C" FontSize="12" Foreground="#FF8800" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Button Remapping Section (Win 5 specific) -->
                        <StackPanel x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" x:Name="GPDButtonRemapSection" Visibility="Collapsed">
                            <TextBlock x:Uid="OnexCaption1570" Text="BUTTON REMAPPING" Style="{StaticResource SectionHeaderStyle}"/>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Uid="OnexCaption1571" Text="Button Remapping" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Uid="OnexCaption1572" Text="Remap controller buttons to keyboard or mouse"
                                                       Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="GPDButtonRemapExpandToggle"
                                                      Grid.Column="1"
                                                      IsChecked="False"
                                                      VerticalAlignment="Center"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="GPDButtonRemapExpandToggle_Click">
                                            <FontIcon x:Name="GPDButtonRemapExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                        </ToggleButton>
                                    </Grid>

                                    <StackPanel x:Name="GPDButtonRemapContent" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">

                                        <!-- Face Buttons -->
                                        <TextBlock x:Uid="OnexCaption1573" Text="Face Buttons" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption1574" Text="A" Grid.Column="0" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                            <ComboBox x:Name="GPDButtonAComboBox" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="GPDButtonComboBox_SelectionChanged" Tag="A">
                                                <x:String>Disabled</x:String>
                                                <x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String>
                                                <x:String>F13</x:String><x:String>F14</x:String><x:String>F15</x:String><x:String>F16</x:String><x:String>F17</x:String>
                                                <x:String>Enter</x:String><x:String>Escape</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String>
                                                <x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String>
                                                <x:String>Home</x:String><x:String>End</x:String><x:String>PageUp</x:String><x:String>PageDown</x:String><x:String>Insert</x:String><x:String>Delete</x:String>
                                                <x:String>Left Ctrl</x:String><x:String>Left Shift</x:String><x:String>Left Alt</x:String><x:String>Left Win</x:String>
                                                <x:String>Right Ctrl</x:String><x:String>Right Shift</x:String><x:String>Right Alt</x:String>
                                                <x:String>Mouse Left</x:String><x:String>Mouse Right</x:String><x:String>Mouse Middle</x:String>
                                                <x:String>Mouse Wheel Up</x:String><x:String>Mouse Wheel Down</x:String>
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption1575" Text="B" Grid.Column="0" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
