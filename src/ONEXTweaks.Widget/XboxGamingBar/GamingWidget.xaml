                                                <ComboBoxItem x:Uid="OnexCaption1098" Content="Z"  Tag="Z"/>
                                                <ComboBoxItem x:Uid="OnexCaption1099" Content="-X" Tag="-X"/>
                                                <ComboBoxItem x:Uid="OnexCaption1100" Content="-Y" Tag="-Y"/>
                                                <ComboBoxItem x:Uid="OnexCaption1101" Content="-Z" Tag="-Z"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Gyro → Right Stick (synthesized).
                                             Visible only when targetType has no native motion field
                                             (xbox360, xboxelite2, switchpro family, etc.) — see
                                             ViiperStickGyroProcessor.IsApplicableForTarget. The four
                                             controls below mirror the legacy ControllerEmulation
                                             stick-gyro controls so the same widget property pushes
                                             values to the helper; no separate property surface. -->
                                        <StackPanel x:Name="ViiperStickGyroSection" Visibility="Collapsed" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Header text is dynamic: reflects "Gyro → Left Stick" or "Gyro → Right
                                                     Stick" based on the Send-to-joystick setting so the title doesn't lie
                                                     when stickSelect is flipped. Driven from C# whenever the routing changes. -->
                                                <TextBlock x:Uid="OnexCaption1102" x:Name="ViiperStickGyroSectionHeader"
                                                           Grid.Column="0"
                                                           Text="Gyro → Right Stick"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#4AB3F4"
                                                           VerticalAlignment="Center"/>
                                                <!-- Configuration summary badge: at-a-glance "ON: Hold RT" / "ON: Always" /
                                                     "OFF" so first-time users can verify activation without expanding any
                                                     groups. Pure widget-side computation; no helper round-trip. -->
                                                <Border x:Name="ViiperStickGyroStatusBadge"
                                                        Grid.Column="1"
                                                        Background="#1F2A3D"
                                                        BorderBrush="#3D5A80"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Uid="OnexCaption1103" x:Name="ViiperStickGyroStatusBadgeText"
                                                               Text="OFF"
                                                               FontSize="10"
                                                               Foreground="#AAAAAA"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Uid="OnexCaption1104" Text="Synthesizes a stick contribution from gyro motion for emulated targets without a native motion field (Xbox 360, Xbox Elite 2, Switch Pro)."
                                                       FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                            <!-- Master enable.
                                                 Off = raw stick passthrough (legacy behavior pre-2152). On = synthesize gyro
                                                 contribution into the chosen stick. Default true. -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Uid="OnexCaption1105" Text="Enable gyro → stick" FontSize="13" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Uid="OnexCaption1106" Text="Off = raw stick passthrough; processor short-circuits."
                                                               FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="ViiperStickGyroEnabledToggle"
                                                              Grid.Column="1"
                                                              Style="{StaticResource ModernToggleStyle}"/>
                                            </Grid>

                                            <TextBlock x:Uid="OnexCaption1107" Text="Activation mode" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ViiperStickGyroActivationModeComboBox" HorizontalAlignment="Stretch"
                                                      SelectionChanged="ViiperStickGyroActivationModeComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="OnexCaption1108" Content="Always On" Tag="0" IsSelected="True"/>
                                                <ComboBoxItem x:Uid="OnexCaption1109" Content="Hold" Tag="1"/>
                                                <ComboBoxItem x:Uid="OnexCaption1110" Content="Toggle" Tag="2"/>
                                            </ComboBox>

                                            <TextBlock x:Uid="OnexCaption1111" Text="Activation button" FontSize="12" Foreground="#CCCCCC" Margin="0,8,0,4"/>
                                            <ComboBox x:Name="ViiperStickGyroActivationButtonComboBox" HorizontalAlignment="Stretch"
                                                      SelectionChanged="ViiperStickGyroActivationButtonComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="OnexCaption1112" Content="None" Tag="0"/>
                                                <ComboBoxItem x:Uid="OnexCaption1113" Content="Right Trigger" Tag="1" IsSelected="True"/>
                                                <ComboBoxItem x:Uid="OnexCaption1114" Content="Left Trigger" Tag="2"/>
                                                <ComboBoxItem x:Uid="OnexCaption1115" Content="Right Bumper" Tag="3"/>
                                                <ComboBoxItem x:Uid="OnexCaption1116" Content="Left Bumper" Tag="4"/>
                                                <ComboBoxItem x:Uid="OnexCaption1117" Content="A" Tag="5"/>
                                                <ComboBoxItem x:Uid="OnexCaption1118" Content="B" Tag="6"/>
                                                <ComboBoxItem x:Uid="OnexCaption1119" Content="X" Tag="7"/>
                                                <ComboBoxItem x:Uid="OnexCaption1120" Content="Y" Tag="8"/>
                                                <ComboBoxItem x:Uid="OnexCaption1121" Content="Right Stick Click" Tag="9"/>
                                                <ComboBoxItem x:Uid="OnexCaption1122" Content="Left Stick Click" Tag="10"/>
                                                <ComboBoxItem x:Uid="OnexCaption1123" Content="D-Pad Up" Tag="11"/>
                                                <ComboBoxItem x:Uid="OnexCaption1124" Content="D-Pad Down" Tag="12"/>
                                                <ComboBoxItem x:Uid="OnexCaption1125" Content="D-Pad Left" Tag="13"/>
                                                <ComboBoxItem x:Uid="OnexCaption1126" Content="D-Pad Right" Tag="14"/>
                                                <ComboBoxItem x:Uid="OnexCaption1127" Content="Start" Tag="15"/>
                                                <ComboBoxItem x:Uid="OnexCaption1128" Content="Back" Tag="16"/>
                                                <ComboBoxItem x:Uid="OnexCaption1129" Content="M3 (back R lower)" Tag="17"/>
                                                <ComboBoxItem x:Uid="OnexCaption1130" Content="M1 (side grip L)" Tag="18"/>
                                                <ComboBoxItem x:Uid="OnexCaption1131" Content="M2 (side grip R)" Tag="19"/>
                                                <ComboBoxItem x:Uid="OnexCaption1132" Content="Y1 (back L upper)" Tag="20"/>
                                                <ComboBoxItem x:Uid="OnexCaption1133" Content="Y2 (back L lower)" Tag="21"/>
                                                <ComboBoxItem x:Uid="OnexCaption1134" Content="Y3 (back R upper)" Tag="22"/>
                                            </ComboBox>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption1135" Text="Sensitivity" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Uid="OnexCaption1136" x:Name="ViiperStickGyroSensitivityValueText" Grid.Column="1" Text="1.00x" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                            </Grid>
                                            <Slider x:Name="ViiperStickGyroSensitivitySlider"
                                                    Minimum="1" Maximum="400" StepFrequency="1" SmallChange="5" LargeChange="25"
                                                    ValueChanged="ViiperStickGyroSensitivitySlider_ValueChanged"/>

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption1137" Text="Deadzone" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Uid="OnexCaption1138" x:Name="ViiperStickGyroDeadzoneValueText" Grid.Column="1" Text="2°/s" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                            </Grid>
                                            <Slider x:Name="ViiperStickGyroDeadzoneSlider"
                                                    Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                    ValueChanged="ViiperStickGyroDeadzoneSlider_ValueChanged"/>

                                            <!-- Advanced expander.
                                                 Each control mirrors a legacy ControllerEmulation* control via
                                                 GamingWidget.ViiperStickGyro.cs, so the same widget property
                                                 pushes values to the helper. Defaults match vvalente30's
                                                 recommended SteamOS-aligned settings (issue #79). -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
