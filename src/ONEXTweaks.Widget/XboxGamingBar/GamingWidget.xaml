                                               IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock x:Uid="OnexCaption247" Text="Info &amp; safety notes" FontSize="12" Foreground="#C0C8D0"/>
                                    </muxc:Expander.Header>
                                    <StackPanel>
                                        <Border Background="#3D2A1A" CornerRadius="4" Padding="10"
                                                x:Name="UnlockFanCurveWarningBorder">
                                            <StackPanel>
                                                <TextBlock Foreground="#FFB060" FontWeight="SemiBold" FontSize="12">
                                                    &#x26A0; Aggressive curves can damage hardware
                                                </TextBlock>
                                                <TextBlock x:Uid="OnexCaption248" Foreground="#DDB890" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="• Never 0% above ~50°C&#10;• 101°C software failsafe forces max RPM"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Uid="OnexCaption249" FontSize="11" Foreground="#9098A0" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Text="• Curves &amp; unlock state save per power mode&#10;• Dropdown selects which mode to edit, not the active one&#10;• Unlock OFF: firmware drives the fan (Custom only via WMI, with firmware-enforced floors)&#10;• Unlock ON: helper writes the curve directly to EC every 3s, in any mode&#10;• Axis labels (10°C–100°C) are how the curve is stored; firmware modes may map temps differently"/>

                                        <TextBlock FontSize="10" Foreground="#707880" TextWrapping="Wrap" Margin="0,8,0,0">
                                            Credits:
