<StackPanel x:Name="OnexPerfLegacyControls" Visibility="Collapsed">
<Border x:Name="ActiveProfileCard" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game-art backdrop, shown only while the per-game profile is ON.
                                     The ImageBrush sits on a Border BACKGROUND because that is what gets
                                     clipped to CornerRadius (a plain Image child would square off the
                                     corners).

                                     GEOMETRY — do not "simplify" the margin back to -12. CardStyle is
                                     Padding=12 INSIDE BorderThickness=2, so the child's slot starts 14px
                                     from the card's outer edge. -10 therefore stops the art 4px in,
                                     leaving the 2px border stroke plus a 2px ring of card background
                                     untouched. At -12 the art ran flush against the stroke, and because
                                     the art is far brighter than CardBorderBrush the rounded outline
                                     disappeared into it — reported 2026-08-02 as "the card loses its
                                     rounded corners when a game profile is active". Radius 4 = the
                                     card's 8 minus those 4px of inset, so the curves stay concentric.

                                     The blur is the upscale itself: a ~48px icon stretched across the
                                     full card width is already heavily smeared, so no blur effect and
                                     no extra dependency is involved. UniformToFill keeps the aspect and
                                     crops top/bottom. Hit-test off so the card stays operable. -->
                                <Border x:Name="ActiveProfileCardArt"
                                        Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="-10" CornerRadius="4"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <!-- Source is the pre-blurred copy from CreateBlurredArtAsync,
                                             not the sharp icon: the blur is produced by downscaling the
                                             icon to a few pixels and stretching that back up. Do not
                                             add a RelativeTransform zoom here — that was tried and it
                                             makes the card a flat colour patch without adding any
                                             smoothing. Blur strength is BlurredArtSize. -->
                                        <ImageBrush x:Name="ActiveProfileCardArtBrush"
                                                    Stretch="UniformToFill"
                                                    AlignmentY="Center"/>
                                    </Border.Background>
                                    <!-- Readability veil: the title and the badges sit on top of this.
                                         The middle stop used to be #4D (30%), which let a light icon
                                         wash the card out right where the toggle sits — and the toggle's
                                         focus ring is WHITE (ModernToggleStyle), so on a bright backdrop
                                         it became invisible and the card read as "no focus frame". The
                                         floor is #99 (60%) across the whole width for that reason; the
                                         ends stay darker so the art still reads as a gradient. -->
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#B3101B3A" Offset="0.0"/>
                                                <GradientStop Color="#99101B3A" Offset="0.55"/>
                                                <GradientStop Color="#C7101B3A" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <!-- Far-left: game icon in its own column, sized to the card.
                                     Collapsed (zero width) when no game runs, so the text gets
                                     the full width. -->
                                <Image x:Name="PerGamePerformanceProfileGameIcon"
                                       Grid.Column="0"
                                       Width="48" Height="48"
                                       Margin="0,0,12,0"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                                <!-- Middle: label + active profile name + game detection -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Uid="OnexCaption233" Text="Per Game performance &amp; display profile"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                    <!-- Badge + detected game on one row: badge left, game status to
                                         its right (uses the freed vertical space). -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <!-- Status badge: orange = global, green = per-game active. -->
                                        <Border x:Name="ActiveProfileBadge"
                                                Background="#37260C" BorderBrush="#A06E28" BorderThickness="1"
                                                CornerRadius="4" Padding="8,2"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock x:Uid="OnexCaption234" x:Name="ActiveProfileText"
                                                       Text="Global Profile"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFAA46"/>
                                        </Border>
                                        <!-- Game name, in a WHITE badge with black text. It used to be
                                             grey hint text, which vanished against a light game-art
                                             backdrop (reported 2026-08-02). An opaque white plate is the
                                             one background that stays readable over any icon, whatever
                                             its colours — the same reason the status badge to its left
                                             carries its own fill. The marquee (Canvas clip +
                                             TranslateTransform) is unchanged and still scrolls long
                                             titles; it just lives inside the badge now. -->
                                        <!-- A Canvas used to sit between the badge and the text to drive a
                                             marquee. It never worked — a Canvas does not size to its
                                             children, so the helper's own width guard bailed every call —
                                             and inside a Border it was actively harmful: the badge
                                             collapsed to its padding and the rounded Border clipped the
                                             name down to one letter (2026-08-02). Plain TextBlock with
                                             trimming now, identical to the controller card. -->
                                        <Border x:Name="DetectedGameBadge"
                                                Background="#FFFFFF"
                                                CornerRadius="4" Padding="8,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock x:Uid="OnexCaption235" x:Name="DetectedGameText"
                                                       Text="No app/game detected"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#000000"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="200"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: toggle top-aligned -->
                                <ToggleSwitch x:Name="PerGameProfileToggle"
                                              Grid.Column="2"
                                              Style="{StaticResource ModernToggleStyle}"
                                              IsEnabled="False"
                                              VerticalAlignment="Top"
                                              KeyDown="PerGameProfileToggle_KeyDown"/>
                            </Grid>
                        </Border>
