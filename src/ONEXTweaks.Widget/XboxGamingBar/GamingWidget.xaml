                    </Grid.Children>
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<Style x:Key="OnexCompactToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="#FF00E2E3"/>
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" /><Setter Property="Width" Value="48" /><Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid x:Name="RootGrid" Width="48" Height="28" UseLayoutRounding="False" Background="#00FFFFFF">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.States>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup.States>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualStateGroup.States>
                                        <VisualState x:Name="Dragging" />
                                        <VisualState x:Name="Off">
                                            <VisualState.Storyboard>
                                                <Storyboard>
                                                    <Storyboard.Children>
                                                        <DoubleAnimation To="0" Duration="0:0:0" Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation To="0" Duration="0:0:0" Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" />
                                                        <DoubleAnimation To="0" Duration="0:0:0" Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="Y" />
                                                    </Storyboard.Children>
                                                </Storyboard>
                                            </VisualState.Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="On">
                                            <VisualState.Storyboard>
                                                <Storyboard>
                                                    <Storyboard.Children>
                                                        <DoubleAnimation To="20" Duration="0:0:0" Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation To="1" Duration="0:0:0" Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" />
                                                        <DoubleAnimation To="0" Duration="0:0:0" Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="Y" />
                                                    </Storyboard.Children>
                                                </Storyboard>
                                            </VisualState.Storyboard>
                                        </VisualState>
                                    </VisualStateGroup.States>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.Children>
                                <!-- A common drawing plane keeps track and knob on the same pixel grid.
                                     Base sizes stay on a common DPI grid; only On has the requested optical lift. -->
                                <Canvas Width="48" Height="28" UseLayoutRounding="False">
                                    <Border x:Name="TrackOff" Width="48" Height="28" CornerRadius="14" Background="#FF2C3138" BorderBrush="#FF4A5058" BorderThickness="1" />
                                    <Border x:Name="TrackOn" Width="48" Height="28" CornerRadius="14" Opacity="0" Background="{TemplateBinding Background}" />
                                    <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#FFFFFFFF" Canvas.Left="4" Canvas.Top="4">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="KnobTransform" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>
                            </Grid.Children>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Page.Resources>

    <Grid x:Name="OnexStartupRoot" IsHitTestVisible="False">
        <ProgressRing x:Name="LoadingProgressRing"
                      IsActive="True"
                      Visibility="Collapsed"
                      Width="60"
                      Height="60"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Navigation Bar using RadioButtons for proper XY focus navigation -->
        <Grid x:Name="MainNavContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nav Bar Row -->
            <Grid x:Name="OnexNavRow" Grid.Row="0" Background="Transparent" Margin="16,3,16,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <!-- LT indicator -->
                <Border x:Name="OnexLtHint" Grid.Column="0" Background="#404040" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Uid="OnexCaption0" Text="LT" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                </Border>

                <!-- Navigation Tabs - StackPanel for proper horizontal XY navigation -->
                <!-- XYFocusKeyboardNavigation="Disabled" prevents vertical nav within, allows left/right -->
                <StackPanel x:Name="MainNavPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2"
                            XYFocusKeyboardNavigation="Disabled"
                            KeyDown="MainNavPanel_KeyDown">
                    <!-- Tab order: Main, Performance, Display, Controls, Fan, Lossless, Profiles, System -->
                    <!-- Tab icons: Fluent System Icons (MIT, microsoft/fluentui-system-icons, 24px filled)
                         rendered as PathIcon in a 18x18 Viewbox. Fan has no Fluent equivalent, so it
                         uses the Material Design Icons "fan" glyph (also a filled silhouette, so it
                         matches the filled Fluent set). -->
                    <RadioButton x:Uid="OnexCaption1" x:Name="QuickNavItem" Tag="Quick" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" ToolTipService.ToolTip="Main">
                        <RadioButton.Content>
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <PathIcon Data="M13.4508 2.53318C12.6128 1.82618 11.3872 1.82618 10.5492 2.53318L3.79916 8.22772C3.29241 8.65523 3 9.28447 3 9.94747V19.2526C3 20.2191 3.7835 21.0026 4.75 21.0026H7.75C8.7165 21.0026 9.5 20.2191 9.5 19.2526V15.25C9.5 14.5707 10.0418 14.018 10.7169 14.0004H13.2831C13.9582 14.018 14.5 14.5707 14.5 15.25V19.2526C14.5 20.2191 15.2835 21.0026 16.25 21.0026H19.25C20.2165 21.0026 21 20.2191 21 19.2526V9.94747C21 9.28447 20.7076 8.65523 20.2008 8.22772L13.4508 2.53318Z"/>
                            </Viewbox>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton x:Uid="OnexCaption2" x:Name="OnboardingNavItem" Tag="Onboarding" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" ToolTipService.ToolTip="Setup">
                        <RadioButton.Content>
                            <Grid>
                                <!-- FontSize 15 (was 17): the filled CompletedSolid disc reads heavier than the
                                     other tabs' 18×18 line icons, so it was visibly larger — trimmed to match. -->
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEC61;" FontSize="15" VerticalAlignment="Center"/>
                                <!-- Warning badge shown while required setup is incomplete (toggled from code-behind) -->
                                <FontIcon x:Name="OnboardingNavBadge" FontFamily="Segoe MDL2 Assets" Glyph="&#xEB90;" FontSize="9"
                                          Foreground="#FFA500" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,-2,-2,0" Visibility="Collapsed"/>
                                <!-- Green dot shown when a newer ONEXTweaks release is available (the Setup tab also
                                     hosts in-app updates). Bottom-right so it never collides with the yellow warning. -->
                                <Ellipse x:Name="OnboardingUpdateBadge" Width="8" Height="8" Fill="#32D74B"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,-1,-1" Visibility="Collapsed"/>
                            </Grid>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton x:Uid="OnexCaption3" x:Name="PerformanceNavItem" Tag="Performance" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" ToolTipService.ToolTip="Performance">
