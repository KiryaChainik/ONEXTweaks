                    <RadioButton x:Uid="OnexCaption5" x:Name="LegionNavItem" Tag="Legion" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" ToolTipService.ToolTip="Controls">
                        <RadioButton.Content>
                            <!-- BitmapIcon (not Image): ShowAsMonochrome recolors the PNG's opaque pixels
                                 using the inherited Foreground, so it dims to grey/brightens to white on
                                 hover/checked exactly like the other tabs' vector icons.
                                 Sizing: the PNG is cropped to the bare controller silhouette (96x66, no
                                 padding) and the Viewbox is 20x18 rather than 18x18. A controller is much
                                 wider than tall, so a square 18x18 Viewbox caps it on WIDTH and leaves the
                                 glyph only ~10px high — visibly smaller than the roughly square sibling
                                 icons. Giving it 20 of width lets Uniform scale off the height instead
                                 (min(20/96, 18/66) = 0.208 -> 20x13.8), matching the others' optical size
                                 while the 18px height keeps the nav row aligned. Setting an explicit size on
                                 the BitmapIcon itself does nothing here: inside a Viewbox only the aspect
                                 ratio survives, the Viewbox rescales whatever size it declares. -->
                            <Viewbox Width="20" Height="18" VerticalAlignment="Center">
                                <BitmapIcon UriSource="ms-appx:///Assets/ButtonIcons/controller_xboxseries.png" ShowAsMonochrome="True"/>
                            </Viewbox>
                        </RadioButton.Content>
