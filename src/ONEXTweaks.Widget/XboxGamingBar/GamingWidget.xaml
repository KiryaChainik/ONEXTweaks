                                            <x:String>Left Click</x:String><x:String>Right Click</x:String><x:String>Middle Click</x:String>
                                            <x:String>Scroll Up</x:String><x:String>Scroll Down</x:String><x:String>Scroll Left</x:String><x:String>Scroll Right</x:String>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="LegionButtonM2KeyboardPanel" Visibility="Collapsed" Margin="0,8,0,0" Orientation="Horizontal" XYFocusKeyboardNavigation="Enabled">
                                        <StackPanel x:Name="LegionButtonM2KeyTags" Orientation="Horizontal"/>
                                        <Button x:Uid="OnexCaption1382" x:Name="LegionButtonM2KeyPickerButton" Width="100" Content="+ Key  ▾" Style="{StaticResource KeyPickerButtonStyle}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="LegionButtonM2MacroPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" XYFocusKeyboardNavigation="Enabled">
                                            <StackPanel x:Name="LegionButtonM2MacroButtonTags" Orientation="Horizontal"/>
                                            <ComboBox x:Name="LegionButtonM2MacroButtonComboBox" Width="130" ItemTemplate="{StaticResource GamepadActionItemTemplate}"
                                                      Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0"
                                                      XYFocusUp="{x:Bind LegionButtonM2TypeComboBox}">
                                                <x:String>+ Button</x:String>
                                                <x:String>LS Click</x:String><x:String>LS Up</x:String><x:String>LS Down</x:String><x:String>LS Left</x:String><x:String>LS Right</x:String>
                                                <x:String>RS Click</x:String><x:String>RS Up</x:String><x:String>RS Down</x:String><x:String>RS Left</x:String><x:String>RS Right</x:String>
                                                <x:String>D-Pad Up</x:String><x:String>D-Pad Down</x:String><x:String>D-Pad Left</x:String><x:String>D-Pad Right</x:String>
                                                <x:String>A</x:String><x:String>B</x:String><x:String>X</x:String><x:String>Y</x:String>
                                                <x:String>LB</x:String><x:String>LT</x:String><x:String>RB</x:String><x:String>RT</x:String>
                                                <x:String>Select</x:String><x:String>Start</x:String>
                                                <x:String>Xbox Button</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <ComboBox x:Name="LegionButtonM2MacroModeComboBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                  ItemTemplate="{StaticResource MacroModeItemTemplate}"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0"
                                                  XYFocusUp="{x:Bind LegionButtonM2MacroButtonComboBox}"
                                                  SelectionChanged="LegionButtonM2MacroModeComboBox_SelectionChanged">
                                            <x:String>Once</x:String>
                                            <x:String>Repeat while held</x:String>
                                            <x:String>Hold (press again to release)</x:String>
                                            <x:String>Hold + Repeat (press again to stop)</x:String>
                                        </ComboBox>
                                        <Grid x:Name="LegionButtonM2MacroDelayRow" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption1383" Text="Delay (ms)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                            <Slider x:Name="LegionButtonM2MacroDelaySlider" Grid.Column="1" Margin="8,0"
                                                    Minimum="10" Maximum="500" Value="80" StepFrequency="10"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    XYFocusUp="{x:Bind LegionButtonM2MacroModeComboBox}"
                                                    XYFocusDown="{x:Bind LegionButtonM2MacroPressSlider}"
                                                    ValueChanged="LegionButtonM2MacroDelaySlider_ValueChanged"/>
                                            <TextBlock x:Name="LegionButtonM2MacroDelayValueText" Grid.Column="2" Text="80" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                        </Grid>
                                        <Grid x:Name="LegionButtonM2MacroPressRow" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption1384" Text="Press (ms)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                            <Slider x:Name="LegionButtonM2MacroPressSlider" Grid.Column="1" Margin="8,0"
                                                    Minimum="10" Maximum="500" Value="40" StepFrequency="10"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    XYFocusUp="{x:Bind LegionButtonM2MacroDelaySlider}"
                                                    ValueChanged="LegionButtonM2MacroPressSlider_ValueChanged"/>
                                            <TextBlock x:Name="LegionButtonM2MacroPressValueText" Grid.Column="2" Text="40" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                </Border>

                                <TextBlock x:Uid="OnexCaption1385" Text="Macros simulate rapid, automated button presses and may be flagged by some games&#x27; anti-cheat systems."
                                           FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- M3 Button — hidden on MSI Claw (button does not exist) -->
                                <StackPanel Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1386" Text="M3" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ComboBox x:Name="LegionButtonM3TypeComboBox" Grid.Column="1" Margin="0,0,8,0"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Gamepad</x:String><x:String>Keyboard</x:String><x:String>Mouse</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="LegionButtonM3ComboBox" Grid.Column="2" ItemTemplate="{StaticResource GamepadActionItemTemplate}"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Disabled</x:String>
                                            <x:String>LS Click</x:String><x:String>LS Up</x:String><x:String>LS Down</x:String><x:String>LS Left</x:String><x:String>LS Right</x:String>
                                            <x:String>RS Click</x:String><x:String>RS Up</x:String><x:String>RS Down</x:String><x:String>RS Left</x:String><x:String>RS Right</x:String>
                                            <x:String>D-Pad Up</x:String><x:String>D-Pad Down</x:String><x:String>D-Pad Left</x:String><x:String>D-Pad Right</x:String>
                                            <x:String>A</x:String><x:String>B</x:String><x:String>X</x:String><x:String>Y</x:String>
                                            <x:String>LB</x:String><x:String>LT</x:String><x:String>RB</x:String><x:String>RT</x:String>
                                            <x:String>Select</x:String><x:String>Start</x:String>
                                            <x:String>Xbox Button</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="LegionButtonM3MouseComboBox" Grid.Column="2" Visibility="Collapsed"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Left Click</x:String><x:String>Right Click</x:String><x:String>Middle Click</x:String>
                                            <x:String>Scroll Up</x:String><x:String>Scroll Down</x:String><x:String>Scroll Left</x:String><x:String>Scroll Right</x:String>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="LegionButtonM3KeyboardPanel" Visibility="Collapsed" Margin="40,8,0,0" Orientation="Horizontal">
                                        <StackPanel x:Name="LegionButtonM3KeyTags" Orientation="Horizontal"/>
                                        <Button x:Uid="OnexCaption1387" x:Name="LegionButtonM3KeyPickerButton" Width="100" Content="+ Key  ▾" Style="{StaticResource KeyPickerButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Front Buttons moved to Controller Emulation section -->
                                <!-- Front Buttons moved to Controller Emulation section (ControllerEmulationContent) -->

                                <!-- Gamepad Button Remapping -->
                                <Grid Margin="0,16,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption1388" Text="Re-Map Specific Buttons to Another Button" FontSize="14" Foreground="{StaticResource HintTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button x:Uid="OnexCaption1389" x:Name="LegionGamepadResetAllButton" Grid.Column="1" Content="Reset All Re-Mappings Below"
                                            Style="{StaticResource ModernButtonStyle}" Padding="8,4" FontSize="11"
                                            Background="#3C3C3C" Foreground="#AAAAAA"/>
                                </Grid>

                                <!-- Existing remappings (framed, visually separated from the create area below) -->
                                <Border Background="#1E2A3E" BorderBrush="#3D5A80" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel x:Name="LegionGamepadRemappedSummary">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Uid="OnexCaption1390" Text="Remapped: " FontSize="13" FontWeight="SemiBold" Foreground="#4AB3F4" VerticalAlignment="Center"
                                                   x:Name="LegionGamepadRemappedLabel" Visibility="Collapsed"/>
                                        <TextBlock x:Uid="OnexCaption1391" Text="None" FontSize="12" Foreground="#555555" VerticalAlignment="Center"
                                                   x:Name="LegionGamepadNoRemapsLabel"/>
                                    </StackPanel>
                                    <!-- Non-virtualizing StackPanel (rows built in code). The old
                                         ItemsControl+ItemsWrapGrid virtualized; clearing it on every
                                         edit tore down the gamepad focus scope and bounced focus to the
                                         tab strip. Plain StackPanel .Children (like the key-tag panels)
                                         does not. -->
                                    <StackPanel x:Name="LegionGamepadRemappedTags" Margin="0,4,0,0"/>
                                </StackPanel>
                                </Border>

                                <!-- Create new remappings (framed) -->
                                <Border Background="#1E2A3E" BorderBrush="#3D5A80" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Uid="OnexCaption1392" Text="Create new remappings" FontSize="13" FontWeight="SemiBold" Foreground="#4AB3F4" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Button selector -->
                                        <ComboBox x:Name="LegionGamepadButtonSelectorComboBox" Width="100" Margin="0,0,8,0" ItemTemplate="{StaticResource GamepadActionItemTemplate}"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>LS Click</x:String><x:String>LS Up</x:String><x:String>LS Down</x:String><x:String>LS Left</x:String><x:String>LS Right</x:String>
                                            <x:String>RS Click</x:String><x:String>RS Up</x:String><x:String>RS Down</x:String><x:String>RS Left</x:String><x:String>RS Right</x:String>
                                            <x:String>D-Pad Up</x:String><x:String>D-Pad Down</x:String><x:String>D-Pad Left</x:String><x:String>D-Pad Right</x:String>
                                            <x:String>A</x:String><x:String>B</x:String><x:String>X</x:String><x:String>Y</x:String>
                                            <x:String>LB</x:String><x:String>LT</x:String><x:String>RB</x:String><x:String>RT</x:String>
                                            <x:String>Start</x:String><x:String>Select</x:String>
                                        </ComboBox>
                                        <!-- Type dropdown -->
                                        <ComboBox x:Name="LegionGamepadTypeComboBox" Grid.Column="1" Margin="0,0,8,0"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Gamepad</x:String><x:String>Keyboard</x:String><x:String>Mouse</x:String>
                                        </ComboBox>
                                        <!-- Gamepad action dropdown -->
                                        <ComboBox x:Name="LegionGamepadActionComboBox" Grid.Column="2" ItemTemplate="{StaticResource GamepadActionItemTemplate}"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Disabled</x:String>
                                            <x:String>LS Click</x:String><x:String>LS Up</x:String><x:String>LS Down</x:String><x:String>LS Left</x:String><x:String>LS Right</x:String>
                                            <x:String>RS Click</x:String><x:String>RS Up</x:String><x:String>RS Down</x:String><x:String>RS Left</x:String><x:String>RS Right</x:String>
                                            <x:String>D-Pad Up</x:String><x:String>D-Pad Down</x:String><x:String>D-Pad Left</x:String><x:String>D-Pad Right</x:String>
                                            <x:String>A</x:String><x:String>B</x:String><x:String>X</x:String><x:String>Y</x:String>
                                            <x:String>LB</x:String><x:String>LT</x:String><x:String>RB</x:String><x:String>RT</x:String>
                                            <x:String>Select</x:String><x:String>Start</x:String>
                                            <x:String>Xbox Button</x:String>
                                        </ComboBox>
                                        <!-- Mouse action dropdown (hidden by default) -->
                                        <ComboBox x:Name="LegionGamepadMouseComboBox" Grid.Column="2" Visibility="Collapsed"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Left Click</x:String><x:String>Right Click</x:String><x:String>Middle Click</x:String>
                                            <x:String>Scroll Up</x:String><x:String>Scroll Down</x:String><x:String>Scroll Left</x:String><x:String>Scroll Right</x:String>
                                        </ComboBox>
                                    </Grid>
                                    <!-- Keyboard panel (shown when Keyboard type selected) -->
                                    <StackPanel x:Name="LegionGamepadKeyboardPanel" Visibility="Collapsed" Margin="0,8,0,0" Orientation="Horizontal">
                                        <StackPanel x:Name="LegionGamepadKeyTags" Orientation="Horizontal"/>
                                        <Button x:Uid="OnexCaption1393" x:Name="LegionGamepadKeyPickerButton" Width="100" Content="+ Key  ▾" Click="LegionGamepadKeyPicker_Click" Style="{StaticResource KeyPickerButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Gyro Settings Section (hidden on devices without HID gyro support) -->
                        <StackPanel x:Name="GyroSection">
                        <!-- Gyro Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AD;" FontSize="16"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="OnexCaption1394" Text="Gyro" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Expand toggle: always available (gyro is editable outside of games too,
                                         same as the "Vibration & Deadzone" card) -->
                                    <ToggleButton x:Name="GyroSettingsExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="GyroSettingsExpandToggle_Click">
                                        <FontIcon x:Name="GyroSettingsExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="GyroSettingsContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                <!-- Two columns: pickers left, sliders right. Full-width sliders were far
                                     wider than they need to be and pushed everything else off screen.
                                     Order in the left column is deliberate: Target / Button / Activation
                                     are what gets changed often, engine and accelerometer are set once. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ── Left column: pickers ─────────────────────────────────── -->
                                    <StackPanel Grid.Column="0" Spacing="12">

                                    <!-- Gyro Target -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1395" Text="Target" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ComboBox x:Name="LegionGyroTargetComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  XYFocusDown="{x:Bind LegionGyroActivationButtonComboBox}"
                                                  XYFocusRight="{x:Bind LegionGyroSensitivityXSlider}"
                                                  SelectedIndex="0">
                                            <x:String>Disabled</x:String>
                                            <x:String>Left Stick</x:String>
                                            <x:String>Right Stick</x:String>
                                            <x:String>Mouse</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Gyro Activation Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1396" Text="Button" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ComboBox x:Name="LegionGyroActivationButtonComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  XYFocusUp="{x:Bind LegionGyroTargetComboBox}"
                                                  XYFocusDown="{x:Bind LegionGyroActivationModeComboBox}"
                                                  XYFocusRight="{x:Bind LegionGyroSensitivityXSlider}"
                                                  SelectedIndex="0">
                                            <!-- The Claw has exactly these beyond the Xbox layout: the
                                                 two shoulder pairs and M1/M2. The list used to carry
                                                 the Legion Go's Y1/Y2/M2/M3, which the Claw does not
                                                 have — and IsGyroButtonPressed has no case for them,
                                                 so choosing one left the gyro permanently inactive. -->
                                            <x:String>None</x:String>
                                            <x:String>LB</x:String>
                                            <x:String>LT</x:String>
                                            <x:String>RB</x:String>
                                            <x:String>RT</x:String>
                                            <x:String>M1</x:String>
                                            <x:String>M2</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Gyro Activation Mode -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1397" Text="Activation" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ComboBox x:Name="LegionGyroActivationModeComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  XYFocusUp="{x:Bind LegionGyroActivationButtonComboBox}"
                                                  XYFocusDown="{x:Bind LegionGyroMappingTypeComboBox}"
                                                  XYFocusRight="{x:Bind LegionGyroSensitivityYSlider}"
                                                  SelectedIndex="0">
                                            <x:String>Hold</x:String>
                                            <x:String>Toggle</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Gyro Engine — repurposed from the old Legion "Mapping" (Instant/Continuous)
                                         control. On the MSI Claw the Legion firmware command is a no-op, so this
                                         channel (LegionGyroMappingType, still persisted per controller-profile) now
                                         selects the software gyro→stick engine in ClawButtonMonitor.ApplyGyroToStick:
                                           0 = Adaptive                  → One-Euro speed-adaptive smoothing
                                           1 = Linear                    → 1:1, no software low-pass
                                           2 = Precision (MA inspired)   → sqrt accel curve + MA-style One-Euro (DEFAULT) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1398" Text="Gyro Engine" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ComboBox x:Name="LegionGyroMappingTypeComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="LegionGyroMappingTypeComboBox_EngineModeChanged"
                                                  XYFocusUp="{x:Bind LegionGyroActivationModeComboBox}"
                                                  XYFocusDown="{x:Bind GyroWorldSpaceToggle}"
                                                  XYFocusRight="{x:Bind LegionGyroDeadzoneSlider}"
                                                  SelectedIndex="2">
                                            <x:String>Adaptive</x:String>
                                            <x:String>Linear</x:String>
                                            <x:String>Precision (MA inspired)</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Accelerometer = the gravity-relative ("world space") gyro: the
                                         horizontal axis becomes the rotation about gravity instead of about
                                         the device. Independent of the engine above, applied before any
                                         engine curve. Widget-local/global. The starting value is
                                         PER-MODEL (on everywhere, off on the Claw 8 EX) and comes from
                                         the helper's DeviceGyroWorldSpaceDefault capability; IsOn="True"
                                         below is only the pre-connect placeholder. See
                                         RestoreClawGyroWorldSpace, ApplyClawGyroWorldSpaceDeviceDefault
                                         and ClawButtonMonitor.ResolveGyroAxes. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1399" Text="Accelerometer" VerticalAlignment="Center"
                                                   Foreground="#AAAAAA" FontSize="14"/>
                                        <ToggleSwitch x:Name="GyroWorldSpaceToggle" Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      HorizontalAlignment="Left"
                                                      OnContent="" OffContent="" IsOn="True"
                                                      XYFocusUp="{x:Bind LegionGyroMappingTypeComboBox}"
                                                      XYFocusDown="{x:Bind LegionGyroInvertXToggle}"
                                                      XYFocusRight="{x:Bind LegionGyroSmoothingSlider}"
                                                      Toggled="GyroWorldSpaceToggle_Toggled"/>
                                    </Grid>

                                    <!-- Invert X / Y — same label+control rows as everything else in this
                                         column. They used to sit full width below both columns, where
                                         D-pad navigation could not reach them: nothing pointed at them and
                                         spatial navigation found no candidate below the right column's
                                         sliders. The chain is wired explicitly here instead. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1400" Text="Invert X" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ToggleSwitch x:Name="LegionGyroInvertXToggle" Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      HorizontalAlignment="Left"
                                                      OnContent="" OffContent="" IsOn="False"
                                                      XYFocusUp="{x:Bind GyroWorldSpaceToggle}"
                                                      XYFocusDown="{x:Bind LegionGyroInvertYToggle}"
                                                      XYFocusRight="{x:Bind LegionGyroSmoothingSlider}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1401" Text="Invert Y" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ToggleSwitch x:Name="LegionGyroInvertYToggle" Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      HorizontalAlignment="Left"
                                                      OnContent="" OffContent="" IsOn="False"
                                                      XYFocusUp="{x:Bind LegionGyroInvertXToggle}"
                                                      XYFocusDown="{x:Bind LegionGyroBoostButtonComboBox}"
                                                      XYFocusRight="{x:Bind LegionGyroSmoothingSlider}"/>
                                    </Grid>

                                    <!-- Hold-boost button — the trigger for the Hold-boost slider in the
                                         right column. Same index scheme and same list as the activation
                                         button above; both are read from the DirectInput state, so both
                                         can offer exactly what appears there. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1402" Text="Boost button" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                                        <ComboBox x:Name="LegionGyroBoostButtonComboBox"
                                            DropDownOpened="GyroHint_ComboOpened" DropDownClosed="GyroHint_ComboClosed"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  XYFocusUp="{x:Bind LegionGyroInvertYToggle}"
                                                  XYFocusDown="{x:Bind LegionCalibrateGyroButton}"
                                                  XYFocusRight="{x:Bind LegionGyroBoostFactorSlider}"
                                                  SelectedIndex="0">
                                            <x:String>None</x:String>
                                            <x:String>LB</x:String>
                                            <x:String>LT</x:String>
                                            <x:String>RB</x:String>
                                            <x:String>RT</x:String>
                                            <x:String>M1</x:String>
                                            <x:String>M2</x:String>
                                        </ComboBox>
                                    </Grid>

                                    </StackPanel>

                                    <!-- ── Right column: sliders ────────────────────────────────── -->
                                    <StackPanel Grid.Column="2" Spacing="12">

                                <!-- Gyro Sensitivity X -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1403" Text="Sensitivity X" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="LegionGyroSensitivityXValue"
                                                   Text="70"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroSensitivityXSlider"
                                            FocusEngaged="GyroHint_Engaged" FocusDisengaged="GyroHint_Disengaged"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="100"
                                            Value="70"
                                            StepFrequency="1"
                                            XYFocusUp="{x:Bind LegionGyroTargetComboBox}"
                                            XYFocusLeft="{x:Bind LegionGyroTargetComboBox}"/>
                                </StackPanel>

                                <!-- Gyro Sensitivity Y -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1404" Text="Sensitivity Y" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="LegionGyroSensitivityYValue"
                                                   Text="70"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroSensitivityYSlider"
                                            FocusEngaged="GyroHint_Engaged" FocusDisengaged="GyroHint_Disengaged"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="100"
                                            Value="70"
                                            StepFrequency="1"
                                            XYFocusUp="{x:Bind LegionGyroSensitivityXSlider}"
                                            XYFocusLeft="{x:Bind LegionGyroActivationButtonComboBox}"/>
                                </StackPanel>

                                <!-- Gyro gate — the INPUT threshold in °/s: motion slower than this is
                                     discarded outright (no value shift). The slider carries tenths, so
                                     0..100 means 0.0..10.0 °/s; Motion Assistant's own 0.01 sits at the
                                     bottom of the range, which the old whole-number scale (minimum 1)
                                     could not express at all. Default 0 = nothing is gated. Resting
                                     drift belongs to the bias path, not here — turning this up to hide
                                     it costs exactly the slow-aiming range. -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1405" Text="Gyro gate" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Uid="OnexCaption1406" x:Name="LegionGyroDeadzoneValue"
                                                   Text="0.0°/s"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroDeadzoneSlider"
                                            FocusEngaged="GyroHint_Engaged" FocusDisengaged="GyroHint_Disengaged"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            Value="0"
                                            StepFrequency="1"
                                            XYFocusUp="{x:Bind LegionGyroSensitivityYSlider}"
                                            XYFocusDown="{x:Bind LegionGyroAntiDeadzoneSlider}"
                                            XYFocusLeft="{x:Bind LegionGyroActivationModeComboBox}"/>
                                </StackPanel>

                                <!-- Anti-deadzone — the OUTPUT floor, opposite end of the pipeline from
                                     the gate above: a gyro-only movement shorter than this radius is
                                     lifted to it, so it clears the GAME's own stick deadzone instead of
                                     being eaten by it. Only while the physical stick is at rest; once
                                     the player pushes the stick there is nothing to lift. Per-game
                                     because every game ships a different stick deadzone. 20 = MA. -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1407" Text="Anti-deadzone" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="LegionGyroAntiDeadzoneValue"
                                                   Text="20%"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroAntiDeadzoneSlider"
                                            FocusEngaged="GyroHint_Engaged" FocusDisengaged="GyroHint_Disengaged"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="50"
                                            Value="20"
                                            StepFrequency="1"
                                            XYFocusUp="{x:Bind LegionGyroDeadzoneSlider}"
                                            XYFocusLeft="{x:Bind LegionGyroMappingTypeComboBox}"/>
                                </StackPanel>

                                <!-- Gyro Smoothing — One-Euro min-cutoff, per engine mode (higher = smoother).
                                     Only Adaptive + MA filter; disabled for Direct (HC 1:1). Value stored per
                                     mode in LocalSettings; the active-mode value is pushed to the helper. -->
                                <StackPanel x:Name="LegionGyroSmoothingPanel">
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1408" Text="Smoothing" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="LegionGyroSmoothingValue"
                                                   Text="50"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroSmoothingSlider"
                                            FocusEngaged="GyroHint_Engaged" FocusDisengaged="GyroHint_Disengaged"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            Value="50"
                                            StepFrequency="1"
                                            XYFocusUp="{x:Bind LegionGyroAntiDeadzoneSlider}"
                                            XYFocusLeft="{x:Bind GyroWorldSpaceToggle}"
                                            XYFocusDown="{x:Bind LegionGyroBoostFactorSlider}"/>
                                </StackPanel>

                                <!-- Hold-boost factor — gyro sensitivity while the boost button (left
                                     column) is held, in percent of normal. Below 100 it slows the gyro
                                     down, which is the aim-down-sights case; above 100 it speeds it up
                                     for quick turns. Inert at 100, and inert entirely while the button
                                     is "None", so the pair can be left alone. -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption1409" Text="Hold-boost" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock x:Name="LegionGyroBoostFactorValue"
                                                   Text="100%"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroBoostFactorSlider"
                                            FocusEngaged="GyroHint_Engaged" FocusDisengaged="GyroHint_Disengaged"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="10" Maximum="300"
                                            Value="100"
                                            StepFrequency="5"
                                            XYFocusUp="{x:Bind LegionGyroSmoothingSlider}"
                                            XYFocusLeft="{x:Bind LegionGyroBoostButtonComboBox}"
                                            XYFocusDown="{x:Bind LegionCalibrateGyroButton}"/>
                                </StackPanel>

                                    </StackPanel>
                                </Grid>

                                <!-- Focus hint. One shared line for the whole card rather than a caption
                                     under every control: the column is navigated with the D-pad, and a
                                     block that appears and disappears per control would move every focus
                                     target below it. MinHeight reserves the two lines it can need, so the
                                     layout never shifts as focus travels. Filled by GyroHint_GotFocus. -->
                                <TextBlock x:Name="LegionGyroFocusHint"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#C8C8C8"
                                           TextWrapping="Wrap"
                                           MinHeight="28"
                                           Margin="0,8,0,0"/>

                                <!-- Gyro calibration (Legion) / gyro recenter (MSI Claw). Label and
                                     status text are set per device in SetGyroSectionVisibility —
                                     the two devices need different actions here, see the comment
                                     there. These values are the Legion wording. -->
                                <StackPanel Margin="0,4,0,0">
                                    <Button x:Uid="OnexCaption1410" x:Name="LegionCalibrateGyroButton"
                                            Content="Calibrate gyro"
                                            Style="{StaticResource ModernButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            XYFocusUp="{x:Bind LegionGyroBoostButtonComboBox}"
                                            Click="LegionCalibrateGyroButton_Click"/>
                                    <TextBlock x:Uid="OnexCaption1411" x:Name="LegionCalibrateGyroStatus"
                                               Text="Hold the controllers still and press the button — bias is captured by the controller firmware."
                                               FontSize="11"
                                               Foreground="#C8C8C8"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <!-- End Gyro Section -->

                        <!-- Vibration & Deadzone Card (collapsible; placed below Button Remapping
                             for a clean vertical controller flow). Shown on MSI Claw via
                             InitializeMsiClawSettings; content collapsed by default like the others. -->
                        <Border x:Name="ControllerFeedbackCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
