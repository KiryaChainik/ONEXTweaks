                                            <ComboBoxItem x:Uid="OnexCaption1078" Content="Mixed (L+R averaged)" Tag="Mixed"/>
                                            <ComboBoxItem x:Uid="OnexCaption1079" Content="Handheld (device IMU)" Tag="Handheld"/>
                                        </ComboBox>

                                        <!-- IMU Axis Mapping — per-axis source selector (with optional flip).
                                             Applies to both gyro and accel so the output vectors stay coherent. -->
                                        <TextBlock x:Uid="OnexCaption1080" Text="IMU axis mapping" FontSize="12" Foreground="#CCCCCC" Margin="0,12,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption1081" Grid.Column="0" Text="X→" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox x:Name="ViiperGyroAxisMapXComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,6,0" FontSize="12">
                                                <ComboBoxItem x:Uid="OnexCaption1082" Content="X"  Tag="X"/>
                                                <ComboBoxItem x:Uid="OnexCaption1083" Content="Y"  Tag="Y"/>
                                                <ComboBoxItem x:Uid="OnexCaption1084" Content="Z"  Tag="Z"/>
                                                <ComboBoxItem x:Uid="OnexCaption1085" Content="-X" Tag="-X"/>
                                                <ComboBoxItem x:Uid="OnexCaption1086" Content="-Y" Tag="-Y"/>
                                                <ComboBoxItem x:Uid="OnexCaption1087" Content="-Z" Tag="-Z"/>
