                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="PrepareForUninstallButton_Click"/>

                                    <!-- Enable Debug Tools Toggle -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption666" Text="Enable Debug Tools" FontSize="14" Foreground="#FF6B6B"/>
                                            <TextBlock x:Uid="OnexCaption667" Text="Enables Debug log level + PawnIO diagnostic tools" FontSize="11" Foreground="{StaticResource HintTextBrush}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="EnableDebugToolsToggle"
                                                      Grid.Column="1"
                                                      OnContent="" OffContent=""
                                                      IsOn="False"
                                                      Toggled="EnableDebugToolsToggle_Toggled"/>
                                    </Grid>

                                    <!-- VIIPER Emulation Backend Toggle (experimental — debug menu only) -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Uid="OnexCaption668" Text="Use VIIPER emulation (recommended)" FontSize="14" Foreground="#FFC107"/>
                                            </StackPanel>
                                            <TextBlock x:Uid="OnexCaption669" Text="Replaces the legacy ViGEm controller emulation with VIIPER (USBIP-based). Requires usbip-win2. Toggling restarts controller emulation." FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock x:Uid="OnexCaption670" x:Name="UsbipPrereqStatusLine"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource HintTextBrush}"
                                                       Text="usbip-win2 driver: checking..."/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ViiperEmulationToggle"
                                                      Grid.Column="1"
                                                      OnContent="" OffContent=""
                                                      IsOn="False"/>
                                    </Grid>

                                    <!-- USBIP prerequisite card, visible only when VIIPER toggle is on and usbip-win2 is not installed -->
                                    <Border x:Name="UsbipInstallCard"
                                            Visibility="Collapsed"
                                            Background="#3A2A10"
                                            BorderBrush="#FFC107"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock x:Uid="OnexCaption671" Text="⚠ usbip-win2 required" FontSize="13" FontWeight="SemiBold" Foreground="#FFC107"/>
                                            <TextBlock x:Uid="OnexCaption672" Text="VIIPER emulation needs the usbip-win2 kernel driver. Download + install the signed driver, reboot, then come back here."
                                                       FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                            <Button x:Uid="OnexCaption673" x:Name="UsbipInstallCardBtn"
                                                    Content="Install usbip-win2"
                                                    Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    Click="OnbUsbipInstall_Click"/>
                                            <HyperlinkButton x:Uid="OnexCaption674" x:Name="UsbipInstallLink"
                                                             Margin="0,4,0,0"
                                                             Content="Or open usbip-win2 releases"
                                                             NavigateUri="https://github.com/vadimgrn/usbip-win2/releases"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Fan curve: drop the 0–40 % scale break (debug menu only). -->
                                    <Border Background="#14000000" BorderBrush="#3D5A80" BorderThickness="1"
                                            CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption675" Text="Fan curve: allow 1–39 %" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#4AB3F4"/>
                                                <TextBlock x:Uid="OnexCaption676" Text="The custom fan curve normally only rests at 0 (off) or 40 % and above, and the graph is drawn with a break across that gap. The reason: on both the Claw 8 AI+ and the Claw 8 EX the fan sits on its minimum-spin plateau below ~40, so 20 and 40 measured the same RPM — a slider that promises a difference it cannot deliver."
                                                           FontSize="11" Foreground="#C8C8C8"
                                                           TextWrapping="Wrap" Margin="0,2,0,6"/>
                                                <TextBlock x:Uid="OnexCaption677" Text="Turn this on to lift the restriction: every value 1–39 becomes settable and the axis is drawn straight. Nothing about the EC write changes — those values were always sent as-is. Switching it back off snaps the curve onto the allowed values again."
                                                           FontSize="11" Foreground="#C8C8C8"
                                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="MsiFanNoScaleBreakToggle"
                                                          Grid.Column="1"
                                                          OnContent="" OffContent=""
                                                          IsOn="False"
                                                          VerticalAlignment="Center"
                                                          Toggled="MsiFanNoScaleBreakToggle_Toggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Per-game gyro engine (Auto / Virtual / Firmware). -->
                                    <Border Background="#14000000" BorderBrush="#3D5A80" BorderThickness="1"
                                            CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Uid="OnexCaption678" Text="Per-game gyro engine" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#4AB3F4"/>
                                            <TextBlock x:Uid="OnexCaption679" Text="Which engine a per-game controller profile&#x27;s gyro uses. Auto reads the sensor over the COM Sensor API — the one path that works on the Claw 8 AI+ and the Claw 8 EX alike, confirmed on real hardware on both. If the Sensor API finds nothing, Auto falls back to the WinRT sensor by itself. Applies immediately."
                                                       FontSize="11" Foreground="#C8C8C8"
                                                       TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <TextBlock x:Uid="OnexCaption680" Text="The other entries are for testing: &#x27;Virtual (software)&#x27; forces the WinRT sensor (which finds nothing on the EX, whose gyro reports a different type ID), &#x27;Firmware (SensorModule)&#x27; leaves motion to the controller itself, and &#x27;Virtual (Sensor API)&#x27; pins the COM source with no fallback."
                                                       FontSize="11" Foreground="#C8C8C8"
                                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ClawGyroSourceComboBox"
                                                      Width="220" HorizontalAlignment="Left"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="ClawGyroSourceComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="OnexCaption681" Content="Auto (Sensor API)" Tag="0" IsSelected="True"/>
                                                <ComboBoxItem x:Uid="OnexCaption682" Content="Virtual (software)" Tag="1"/>
                                                <ComboBoxItem x:Uid="OnexCaption683" Content="Firmware (SensorModule)" Tag="2"/>
                                                <ComboBoxItem x:Uid="OnexCaption684" Content="Virtual (Sensor API)" Tag="3"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- PawnIO Debug Tools (visible when Debug Tools enabled) -->
                                    <StackPanel x:Name="PawnIODebugTools" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Background="#402020" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock x:Uid="OnexCaption685" Text="PawnIO SMU Tools" FontSize="14" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                                                <TextBlock x:Uid="OnexCaption686" Text="Direct SMU commands - changes apply immediately" FontSize="11" Foreground="{StaticResource HintTextBrush}" Margin="0,2,0,8"/>

                                                <!-- CPU Info -->
                                                <TextBlock x:Uid="OnexCaption687" x:Name="PawnIOCpuInfoText" Text="CPU: Not detected" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,8"/>

                                                <!-- Curve Optimizer All -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption688" Text="Curve Optimizer (All Cores)" FontSize="13" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Uid="OnexCaption689" Text="Undervolt: negative, Overvolt: positive" FontSize="10" Foreground="{StaticResource HintTextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="PawnIOCoAllValue" Grid.Column="1" Text="0" FontSize="13" Foreground="#4CAF50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="-" Width="32" Height="32" Click="PawnIOCoAllMinus_Click" Margin="0,0,4,0"/>
                                                        <Button Content="+" Width="32" Height="32" Click="PawnIOCoAllPlus_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Curve Optimizer iGPU -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption690" Text="Curve Optimizer (iGPU)" FontSize="13" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Uid="OnexCaption691" Text="Undervolt: negative, Overvolt: positive" FontSize="10" Foreground="{StaticResource HintTextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="PawnIOCoGfxValue" Grid.Column="1" Text="0" FontSize="13" Foreground="#4CAF50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="-" Width="32" Height="32" Click="PawnIOCoGfxMinus_Click" Margin="0,0,4,0"/>
                                                        <Button Content="+" Width="32" Height="32" Click="PawnIOCoGfxPlus_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- iGPU Clock -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption692" Text="iGPU Clock (MHz)" FontSize="13" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Uid="OnexCaption693" Text="Set iGPU frequency" FontSize="10" Foreground="{StaticResource HintTextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="PawnIOGfxClkValue" Grid.Column="1" Text="800" FontSize="13" Foreground="#4CAF50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="-" Width="32" Height="32" Click="PawnIOGfxClkMinus_Click" Margin="0,0,4,0"/>
                                                        <Button Content="+" Width="32" Height="32" Click="PawnIOGfxClkPlus_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tctl Temperature -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption694" Text="Tctl Temp Limit (°C)" FontSize="13" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Uid="OnexCaption695" Text="CPU temperature limit" FontSize="10" Foreground="{StaticResource HintTextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="PawnIOTctlValue" Grid.Column="1" Text="95" FontSize="13" Foreground="#4CAF50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="-" Width="32" Height="32" Click="PawnIOTctlMinus_Click" Margin="0,0,4,0"/>
                                                        <Button Content="+" Width="32" Height="32" Click="PawnIOTctlPlus_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Apply Buttons -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Uid="OnexCaption696" x:Name="PawnIOApplyButton"
                                                            Grid.Column="0"
                                                            Content="Apply All"
                                                            HorizontalAlignment="Stretch"
                                                            Background="#4CAF50"
                                                            Click="PawnIOApplyButton_Click"/>
                                                    <Button x:Uid="OnexCaption697" x:Name="PawnIOResetButton"
                                                            Grid.Column="2"
                                                            Content="Reset to 0"
                                                            HorizontalAlignment="Stretch"
                                                            Click="PawnIOResetButton_Click"/>
                                                </Grid>

                                                <!-- Status Text -->
                                                <TextBlock x:Name="PawnIODebugStatusText"
                                                           Text=""
                                                           FontSize="11"
                                                           Foreground="#A0A0A0"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Intel thermal tasks (DIAGNOSTIC ONLY, visible when Debug Tools enabled).
                                         NOT a fix: on Lunar Lake the fan "panic" is an EC firmware latch that no
                                         software lever releases (only a full shutdown does). Stopping the Intel
                                         IPF/DTT tasks does not calm a latched fan and can make it worse. This is
                                         kept purely to inspect / experiment with the Intel thermal stack state.
                                         Note: disabling the TFN1 fan participant is unsupported on some OS builds,
                                         so "Stop" may only stop the services there. -->
                                    <StackPanel x:Name="IntelThermalDebugTools" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Background="#402020" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock x:Uid="OnexCaption698" Text="Intel thermal stack (IPF/DTT) — diagnostic only" FontSize="14" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                                                <TextBlock x:Uid="OnexCaption699" Text="Does NOT fix the fan panic. The panic is an EC firmware latch that only a full shutdown clears. For investigation only — stopping these tasks can make a stuck fan worse." FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Uid="OnexCaption700" x:Name="IntelThermalStopButton"
                                                            Content="Stop Intel tasks"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            FontSize="11" Padding="10,4"
                                                            Click="IntelThermalStopButton_Click"/>
                                                    <Button x:Uid="OnexCaption701" x:Name="IntelThermalStartButton"
                                                            Content="Start Intel tasks"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            FontSize="11" Padding="10,4"
                                                            Click="IntelThermalStartButton_Click"/>
                                                    <Button x:Uid="OnexCaption702" x:Name="IntelThermalRefreshButton"
                                                            Content="Refresh"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            FontSize="11" Padding="10,4"
                                                            Click="IntelThermalRefreshButton_Click"/>
                                                </StackPanel>
                                                <TextBlock x:Uid="OnexCaption703" x:Name="IntelThermalStatusText"
                                                           Margin="0,8,0,0"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="#A0A0A0"
                                                           Text="Press Refresh to read the Intel thermal stack status."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Fan max test / scaling check (DIAGNOSTIC, visible when Debug Tools enabled).
                                         Forces the EC full-speed override (block 152.7) so we can compare the real
                                         fan RPM against our table max (100 % = EC byte 150). If Full Blast is clearly
                                         louder / higher RPM than Aggressive@100 %, then 150 is NOT the absolute max
                                         and our 0-100 % scaling tops out below the hardware ceiling. -->
                                    <StackPanel x:Name="FanMaxTestDebugTools" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Background="#402020" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock x:Uid="OnexCaption704" Text="Fan max test (Full Blast) — diagnostic only" FontSize="14" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                                                <TextBlock x:Uid="OnexCaption705" Text="Forces the EC full-speed override to check whether 100% (EC 150) is really the absolute fan max. Turn ON, wait a few seconds, Read RPM; compare with Aggressive@100%. Turn OFF afterwards." FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Uid="OnexCaption706" x:Name="FanFullBlastOnButton"
                                                            Content="Full Blast ON"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            FontSize="11" Padding="10,4"
                                                            Click="FanFullBlastOnButton_Click"/>
                                                    <Button x:Uid="OnexCaption707" x:Name="FanFullBlastOffButton"
                                                            Content="Full Blast OFF"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            FontSize="11" Padding="10,4"
                                                            Click="FanFullBlastOffButton_Click"/>
                                                    <Button x:Uid="OnexCaption708" x:Name="FanReadRpmButton"
                                                            Content="Read RPM"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            FontSize="11" Padding="10,4"
                                                            Click="FanReadRpmButton_Click"/>
                                                </StackPanel>
                                                <TextBlock x:Uid="OnexCaption709" x:Name="FanFullBlastStatusText"
                                                           Margin="0,8,0,0"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="#A0A0A0"
                                                           Text="Press Read RPM to read the live fan speed."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Fan override probe (DIAGNOSTIC, visible when Debug Tools enabled).
                                         Hunts for a PROPORTIONAL fan-duty register: writes a raw byte to an EC
                                         data block (default 152) and reads it back. Sweep the slider and listen
                                         for a level response between firmware-quiet and Full Blast. WARNING:
                                         writing arbitrary EC blocks is experimental — keep to block 152 unless
                                         you know what a block does. -->
                                    <StackPanel x:Name="FanProbeDebugTools" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Background="#402020" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock x:Uid="OnexCaption710" Text="Fan override probe — diagnostic only" FontSize="14" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                                                <TextBlock x:Uid="OnexCaption711" Text="Writes a raw byte to an EC block (default 152) to find a proportional fan-duty register. Sweep + Write, then listen. Set value back to 0 when done." FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock x:Uid="OnexCaption712" Text="Block" FontSize="12" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="FanProbeBlockText" Text="152" Width="56" Margin="8,0,0,0"/>
                                                    <TextBlock x:Uid="OnexCaption713" Text="Value" FontSize="12" Foreground="#C0C0C0" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                    <TextBlock x:Uid="OnexCaption714" x:Name="FanProbeValueLabel" Text="0 (0x00)" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <Slider x:Name="FanProbeValueSlider" Minimum="0" Maximum="255" Value="0"
                                                        ValueChanged="FanProbeValueSlider_ValueChanged"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button x:Uid="OnexCaption715" Content="Write" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4" Click="FanProbeWriteButton_Click"/>
                                                    <Button Content="152=0"   Margin="8,0,0,0" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="8,4" Click="FanProbeP0_Click"/>
                                                    <Button Content="152=50"  Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="8,4" Click="FanProbeP50_Click"/>
                                                    <Button Content="152=100" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="8,4" Click="FanProbeP100_Click"/>
                                                    <Button Content="152=150" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="8,4" Click="FanProbeP150_Click"/>
                                                    <Button x:Uid="OnexCaption716" Content="0x80|40" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="8,4" Click="FanProbeEn40_Click"/>
                                                    <Button x:Uid="OnexCaption717" Content="0x80|80" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="8,4" Click="FanProbeEn80_Click"/>
                                                </StackPanel>
                                                <TextBlock x:Uid="OnexCaption718" x:Name="FanProbeStatusText"
                                                           Margin="0,8,0,0"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="#A0A0A0"
                                                           Text="Write a value, then listen. Read-back confirms what landed in the EC."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Update Status Text -->
                                    <TextBlock x:Name="UpdateStatusText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="#A0A0A0"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"/>

                                    <!-- Update Button (shown when update available) -->
                                    <Button x:Uid="OnexCaption719" x:Name="UpdateButton"
                                            Content="Update"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Background="#107C10"
                                            Click="UpdateButton_Click"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Navigation Infos Card (controller shortcuts reference) -->
                        <Border x:Name="OnexNavigationGuideCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <ToggleButton x:Name="ProTipsExpandButton" IsChecked="False"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="Transparent" BorderThickness="0" Padding="0,4"
                                  Click="ProTipsExpandButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption720" Text="Navigation guide" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Uid="OnexCaption721" Text="Touch, gamepad and slider controls"
                                                       Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    <FontIcon Grid.Column="1" VerticalAlignment="Center" x:Name="ProTipsExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                </Grid>
                            </ToggleButton>
                                <StackPanel x:Name="ProTipsContent" Visibility="Collapsed" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- About Card (Collapsible) -->
                        <Border x:Name="OnexAboutCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <ToggleButton x:Name="AboutExpandButton" IsChecked="False"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="Transparent" BorderThickness="0" Padding="0,4"
                                  Click="AboutExpandButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE897;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption722" Text="About" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption723" Text="Version and credits"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <FontIcon Grid.Column="1" VerticalAlignment="Center" x:Name="AboutExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                </Grid>
                            </ToggleButton>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="AboutContent" Visibility="Collapsed" Margin="0,12,0,0" Spacing="12">
                                    <TextBlock x:Uid="OnexCaption724" x:Name="OnexAboutPurposeText"
                                               Text="ONEXTweaks brings performance, display, fan, lighting and controller settings to your ONEXPLAYER Game Bar widget."
                                               FontSize="14" TextWrapping="Wrap"/>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption725" Text="Widget version" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="OnexCaption726" x:Name="AboutVersionText" Grid.Column="1" Text="Unknown" FontSize="14" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption727" Text="Author" FontSize="14"/>
                                        <TextBlock x:Uid="OnexCaption728" x:Name="OnexAboutAuthorText" Grid.Column="1" Text="KiryaChainik" FontSize="14" FontWeight="SemiBold"/>
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Uid="OnexCaption729" Text="How the parts work together" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="OnexCaption730" x:Name="OnexAboutComponentsText" FontSize="12" TextWrapping="Wrap"
                                            Text="Widget — the interface, tiles and profile editors.&#10;Bridge — actions, controller input and communication with Windows.&#10;Power Agent — applies and reads hardware power limits.&#10;Optional tools — VIIPER and HidHide for a virtual controller; RTSS for its overlay and FPS limiter."/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Uid="OnexCaption731" Text="Special Thanks" FontSize="14" FontWeight="SemiBold"/>
                                        <HyperlinkButton x:Name="OnexClawTweaksThanksLink" Click="OnexClawTweaksThanks_Click" ToolTipService.ToolTip="https://github.com/enterTheVoidCode/ClawTweaks"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="8,6" MinHeight="36">
                                            <TextBlock x:Uid="OnexCaption732" Text="ClawTweaks — enterTheVoidCode (Riff_Lash)" TextWrapping="Wrap" FontSize="14"/>
                                        </HyperlinkButton>
                                        <TextBlock x:Name="OnexAboutLinkStatus" Text="" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="OnexCaption733" x:Name="OnexAboutCreditsText" FontSize="12" TextWrapping="Wrap"
                                                   Text="Built on the ClawTweaks / GoTweaks foundation. Thanks also to the GoTweaks and Handheld Companion authors and contributors."/>
                                    </StackPanel>
                                    <StackPanel x:Name="OnexSupportAuthorSection" Spacing="8" HorizontalAlignment="Left">
                                        <TextBlock x:Uid="OnexSupportAuthorCaption" x:Name="OnexSupportAuthorCaption"
                                                   Text="Support author" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Image x:Uid="OnexSupportAuthorQr" x:Name="OnexSupportAuthorQr"
                                               Source="ms-appx:///Assets/support-author-qr.png" Width="240" Height="240"
                                               Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Support author QR code"/>
                                    </StackPanel>
                                    <!-- Retain the dormant legacy field without offering an inactive upstream updater. -->
                                    <ToggleSwitch x:Name="AutoUpdateCheckToggle" Visibility="Collapsed" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- DRIVERS TAB (MSI + Intel driver/firmware updates) -->
                <ScrollViewer x:Name="DriverScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="12,6,12,10">
                        <Border x:Name="DriverUpdatesCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="16" Margin="0,0,8,0"
                                              Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption734" Text="MSI Claw Driver Updates" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption735" Text="Driver &amp; firmware updates (MSI + Intel)"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="DriverUpdatesContent" Visibility="Visible" Spacing="6" Margin="0,8,0,0">
                                    <!-- Machine info -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="OnexCaption736" Grid.Row="0" Grid.Column="0" Text="Model" FontSize="13" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriverUpdatesModel" Text="—" FontSize="13" Foreground="#E0E0E0" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="OnexCaption737" Grid.Row="1" Grid.Column="0" Text="Installed BIOS" FontSize="13" Foreground="#AAAAAA" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DriverUpdatesBios" Text="—" FontSize="13" Foreground="#E0E0E0" Margin="0,4,0,0"/>
                                    </Grid>

                                    <!-- Actions row -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="OnexCaption738" x:Name="DriverUpdatesCheckButton"
                                                Content="Check for updates"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesCheckButton_Click"/>
                                        <Button x:Uid="OnexCaption739" x:Name="DriverUpdatesOpenPageButton"
                                                Content="Open MSI driver page"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesOpenPageButton_Click"/>
                                        <Button x:Uid="OnexCaption740" x:Name="DriverUpdatesIntelDsaButton"
                                                Content="Intel DSA"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesIntelDsaButton_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Uid="OnexCaption741" x:Name="DriverUpdatesStatusText"
                                               Text="Tap &#x27;Check for updates&#x27; to scan installed driver versions."
                                               FontSize="11"
                                               Foreground="{StaticResource HintTextBrush}"
                                               TextWrapping="Wrap"/>


                                    <CheckBox x:Uid="OnexCaption742" x:Name="DriverUpdatesUpdateOnStartCheckbox"
                                              Content="Check for driver updates on start"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#AAAAAA"
                                              Checked="DriverUpdatesUpdateOnStartCheckbox_Changed"
                                              Unchecked="DriverUpdatesUpdateOnStartCheckbox_Changed"/>
                                    <CheckBox x:Uid="OnexCaption743" x:Name="DriverUpdatesModdedWifiCheckbox"
                                              Content="Use modded Wi-Fi driver (theboss619) — at your own risk"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#AAAAAA"
                                              KeyDown="DriverUpdatesModdedWifiCheckbox_KeyDown"
                                              Checked="DriverUpdatesModdedWifiCheckbox_Changed"
                                              Unchecked="DriverUpdatesModdedWifiCheckbox_Changed"/>
                                    <CheckBox x:Uid="OnexCaption744" x:Name="DriverUpdatesIntelBetaCheckbox"
                                              Content="Also offer Intel beta graphics drivers (not WHQL certified)"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#AAAAAA"
                                              Checked="DriverUpdatesIntelBetaCheckbox_Changed"
                                              Unchecked="DriverUpdatesIntelBetaCheckbox_Changed"/>

                                    <ItemsControl x:Name="DriverUpdatesList" Visibility="Collapsed"
                                                  XYFocusKeyboardNavigation="Enabled">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A1A2E" CornerRadius="4" Padding="8,6" Margin="0,3,0,0">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding CategoryIcon}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16"
                                                                   Foreground="#7A9EC8"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" XYFocusKeyboardNavigation="Enabled">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="#E0E0E0" TextWrapping="Wrap"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Beta badge: only Intel rows can carry it, and only while the
                                                                         user opted into beta drivers. Amber outline rather than a
                                                                         filled pill so it reads as a caveat next to the status,
                                                                         not as a second status. -->
                                                                    <Border Background="#3A2A10" BorderBrush="#FFB060" BorderThickness="1"
                                                                            CornerRadius="10" Padding="7,1" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding BetaBadgeVisibility}">
                                                                        <TextBlock x:Uid="OnexCaption745" Text="BETA" FontSize="9" FontWeight="SemiBold" Foreground="#FFB060"/>
                                                                    </Border>
                                                                    <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                <Run Text="{Binding Category}"/><Run Text=" • "/><Run Text="{Binding Severity}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                <Run x:Uid="OnexCaption746" Text="Installed:"/><Run Text=" "/><Run Text="{Binding InstalledVersion}"/><Run Text="  →  "/><Run x:Uid="OnexCaption747" Text="Latest:"/><Run Text=" "/><Run Text="{Binding Version}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Highlights}"
                                                                       FontSize="10" Foreground="#AA77CC"
                                                                       FontStyle="Italic"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding HighlightsVisibility}"/>
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding ReleaseDate, FallbackValue=''}" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <!-- KeyDown: these live in a DataTemplate, so there is no
                                                                         fixed control to point XYFocus at. The handler walks
                                                                         the realized rows instead — see DriverRowButton_KeyDown. -->
                                                                    <Button Content="{Binding MuteButtonLabel}"
                                                                            Tag="{Binding IgnoreKey}"
                                                                            Visibility="{Binding MuteButtonVisibility}"
                                                                            Style="{StaticResource ModernButtonStyle}"
                                                                            FontSize="11"
                                                                            Padding="10,4"
                                                                            KeyDown="DriverRowButton_KeyDown"
                                                                            Click="DriverMuteButton_Click"/>
                                                                    <Button Content="{Binding InstallButtonLabel}"
                                                                            Tag="{Binding DownloadUrl}"
                                                                            Visibility="{Binding InstallButtonVisibility}"
                                                                            Style="{StaticResource ModernButtonStyle}"
                                                                            FontSize="11"
                                                                            Padding="10,4"
                                                                            KeyDown="DriverRowButton_KeyDown"
                                                                            Click="DriverInstallButton_Click"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Installer files already downloaded for this driver:
                                                                 re-run (downgrade to) or delete to free space. -->
                                                            <muxc:Expander Visibility="{Binding CachedInstallersVisibility}"
                                                                           Margin="0,6,0,0"
                                                                           HorizontalAlignment="Stretch"
                                                                           HorizontalContentAlignment="Stretch"
                                                                           IsExpanded="False">
                                                                <muxc:Expander.Header>
                                                                    <TextBlock Text="{Binding CachedInstallersHeader}" FontSize="11" Foreground="#9098A0"/>
                                                                </muxc:Expander.Header>
                                                                <ItemsControl ItemsSource="{Binding CachedInstallers}"
                                                                              XYFocusKeyboardNavigation="Enabled">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,3,0,0" ColumnSpacing="8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#D0D0D0" TextWrapping="Wrap"/>
                                                                                    <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="#808890" TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                    <Button Content="{Binding RunButtonLabel}"
                                                                                            Tag="{Binding}"
                                                                                            Style="{StaticResource ModernButtonStyle}"
                                                                                            FontSize="11"
                                                                                            Padding="10,4"
                                                                                            Click="DriverCachedRunButton_Click"/>
                                                                                    <Button x:Uid="OnexCaption748" Content="Delete"
                                                                                            Tag="{Binding}"
                                                                                            Style="{StaticResource ModernButtonStyle}"
                                                                                            FontSize="11"
                                                                                            Padding="10,4"
                                                                                            Click="DriverCachedDeleteButton_Click"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </muxc:Expander>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- DISPLAY TAB (Intel IGCL) — saved in the Performance & Display profile -->
                <!-- ClawTweaks 1.0.1 release-derived Display, own ONEXPLAYER backend. -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="DisplayScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" BringIntoViewOnFocusChange="True">
    <ScrollViewer.Content>
        <StackPanel x:Name="DisplayMainStack" Padding="16,8,16,16" Spacing="12">
            <StackPanel.Children>
                <StackPanel x:Name="DisplayTopGroup">
                    <StackPanel.Children>
                        <TextBlock x:Uid="OnexCaption749" Text="Intel Graphics Software Settings" Style="{StaticResource CardTitleStyle}" Visibility="Collapsed" />
                        <Border x:Name="DisplayProfileModeBadge" Visibility="Collapsed" Background="#FF37260C" BorderBrush="#FFA06E28" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2" HorizontalAlignment="Left">
                            <Border.Child>
                                <TextBlock x:Uid="OnexCaption750" x:Name="DisplayProfileModeText" Text="Global Profile" FontSize="11" Foreground="#FFFFAA46" />
                            </Border.Child>
                        </Border>
                    </StackPanel.Children>
                </StackPanel>
                <Border x:Name="DisplayTabHost" Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="PerfColorDetail" Visibility="Visible">
                        <StackPanel.Children>
                            <Grid Margin="0,4">
                                <Grid.Children>
                                    <Border CornerRadius="8" Background="#20000000">
                                        <Border.Child>
                                            <Image x:Name="DisplayReferenceImage" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinHeight="133" MaxHeight="203" Stretch="UniformToFill" Tapped="DisplayReferenceImage_Tapped" />
                                        </Border.Child>
                                    </Border>
                                    <Button x:Uid="OnexCaption751" x:Name="DisplayRefPrevButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Width="34" Height="34" Padding="0" CornerRadius="17" Background="#90000000" BorderThickness="0" Click="DisplayRefPrevButton_Click" ToolTipService.ToolTip="Previous image">
                                        <Button.Content>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="14" Foreground="#FFFFFFFF" />
                                        </Button.Content>
                                    </Button>
                                    <Button x:Uid="OnexCaption752" x:Name="DisplayRefNextButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Width="34" Height="34" Padding="0" CornerRadius="17" Background="#90000000" BorderThickness="0" Click="DisplayRefNextButton_Click" ToolTipService.ToolTip="Next image">
                                        <Button.Content>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="14" Foreground="#FFFFFFFF" />
                                        </Button.Content>
                                    </Button>
                                    <StackPanel x:Name="DisplayRefDots" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                </Grid.Children>
                            </Grid>
                            <Border Margin="0,10,0,0">
                                <Border.Child>
                                    <StackPanel Spacing="10">
                                        <StackPanel.Children>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.Children>
                                                    <StackPanel x:Name="DisplayColorColLeft" Spacing="12" Grid.Column="0">
                                                        <StackPanel.Children>
                                                            <StackPanel x:Name="DisplaySaturationRow">
                                                                <StackPanel.Children>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Children>
                                                                            <TextBlock x:Uid="OnexCaption753" Text="Saturation" Style="{StaticResource CardCaptionStyle}" Margin="0" VerticalAlignment="Center" />
                                                                            <TextBlock x:Name="DisplaySaturationValueText" Text="50" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                                                        </Grid.Children>
                                                                    </Grid>
                                                                    <Slider x:Name="DisplaySaturationSlider" Style="{StaticResource LightMediaSliderStyle}" Minimum="0" Maximum="100" Value="50" StepFrequency="1" ValueChanged="DisplaySlider_ValueChanged" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <StackPanel.Children>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Children>
                                                                            <TextBlock x:Uid="OnexCaption754" Text="Hue" Style="{StaticResource CardCaptionStyle}" Margin="0" VerticalAlignment="Center" />
                                                                            <TextBlock x:Name="DisplayHueValueText" Text="0" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                                                        </Grid.Children>
                                                                    </Grid>
                                                                    <Slider x:Name="DisplayHueSlider" Style="{StaticResource LightMediaSliderStyle}" Minimum="-180" Maximum="180" Value="0" StepFrequency="1" ValueChanged="DisplaySlider_ValueChanged" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <StackPanel.Children>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Children>
                                                                            <TextBlock x:Uid="OnexCaption755" Text="Contrast" Style="{StaticResource CardCaptionStyle}" Margin="0" VerticalAlignment="Center" />
                                                                            <TextBlock x:Name="DisplayContrastValueText" Text="50" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                                                        </Grid.Children>
                                                                    </Grid>
                                                                    <Slider x:Name="DisplayContrastSlider" Style="{StaticResource LightMediaSliderStyle}" Minimum="0" Maximum="100" Value="50" StepFrequency="1" ValueChanged="DisplaySlider_ValueChanged" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                    <StackPanel x:Name="DisplayColorColRight" Spacing="12" Grid.Column="2">
                                                        <StackPanel.Children>
                                                            <StackPanel>
                                                                <StackPanel.Children>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Children>
                                                                            <TextBlock x:Uid="OnexCaption756" Text="Brightness" Style="{StaticResource CardCaptionStyle}" Margin="0" VerticalAlignment="Center" />
                                                                            <TextBlock x:Name="DisplayBrightnessValueText" Text="50" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                                                        </Grid.Children>
                                                                    </Grid>
                                                                    <Slider x:Name="DisplayBrightnessSlider" Style="{StaticResource LightMediaSliderStyle}" Minimum="0" Maximum="100" Value="50" StepFrequency="1" ValueChanged="DisplaySlider_ValueChanged" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <StackPanel.Children>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Children>
                                                                            <TextBlock x:Uid="OnexCaption757" Text="Gamma" Style="{StaticResource CardCaptionStyle}" Margin="0" VerticalAlignment="Center" />
                                                                            <TextBlock x:Name="DisplayGammaValueText" Text="1.00" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                                                        </Grid.Children>
                                                                    </Grid>
                                                                    <Slider x:Name="DisplayGammaSlider" Style="{StaticResource LightMediaSliderStyle}" Minimum="30" Maximum="280" Value="100" StepFrequency="1" ValueChanged="DisplaySlider_ValueChanged" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                            <StackPanel x:Name="DisplaySharpnessRow">
                                                                <StackPanel.Children>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.Children>
                                                                            <TextBlock x:Uid="OnexCaption758" Text="Adaptive Sharpness" Style="{StaticResource CardCaptionStyle}" Margin="0" VerticalAlignment="Center" />
                                                                            <TextBlock x:Uid="OnexCaption759" x:Name="DisplaySharpnessValueText" Text="Off" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                                                        </Grid.Children>
                                                                    </Grid>
                                                                    <Slider x:Name="DisplaySharpnessSlider" Style="{StaticResource LightMediaSliderStyle}" Minimum="0" Maximum="5" Value="0" StepFrequency="1" ValueChanged="DisplaySlider_ValueChanged" />
                                                                    <TextBlock x:Uid="OnexCaption760" x:Name="OnexSharpnessHint" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Text="0 — Off. Levels 1–5 sharpen SDR edges. For example, 1 is subtle and 5 is strong." />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </Grid.Children>
                                            </Grid>
                                            <Button x:Uid="OnexCaption761" x:Name="DisplayResetButton" Content="Reset to neutral" Margin="0,4,0,0" HorizontalAlignment="Stretch" Click="DisplayResetButton_Click" />
                                        </StackPanel.Children>
                                    </StackPanel>
                                </Border.Child>
                            </Border>
                        </StackPanel.Children>
                    </StackPanel>
                </Border>
                
                
            </StackPanel.Children>
        </StackPanel>
    </ScrollViewer.Content>
</ScrollViewer>

                <!-- FAN TAB (MSI Claw) — the Fan Control card is reparented here at runtime -->
                <ScrollViewer x:Name="FanScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16" Spacing="12">
                        <!-- The MSI Claw Fan Control card lives here permanently (no runtime reparenting). -->
                        <StackPanel x:Name="FanTabContent">
                            <!-- MSI Claw (Lunar Lake) Fan Control Card — shown only on MSI Claw -->
                            <Border x:Name="MsiFanCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock x:Uid="OnexCaption762" Text="Fan Control" Style="{StaticResource CardTitleStyle}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Same badge as the performance and controller cards, driven by the
                                                     scope the HELPER reports rather than by the widget's own game
                                                     state — the fan is the one setting where those two can differ
                                                     for 25 s at a time. Colours come from ApplyProfileStatusBadge. -->
                                                <Border x:Name="MsiFanScopeBadge"
                                                        Background="#37260C" BorderBrush="#A06E28" BorderThickness="1"
                                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock x:Uid="OnexCaption763" x:Name="MsiFanScopeBadgeText"
                                                               Text="Global Profile"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#FFAA46"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="MsiFanEnableToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      VerticalAlignment="Center"
                                                      Toggled="MsiFanEnableToggle_Toggled"
                                                      KeyDown="MsiFanEnableToggle_KeyDown"/>
                                    </Grid>

                                    <StackPanel x:Name="MsiFanContent" Margin="0,10,0,0" Visibility="Collapsed"
                                                XYFocusKeyboardNavigation="Enabled">
                                        <!-- One row: Separate CPU/GPU toggle on the LEFT, Preset picker on the RIGHT.
                                             Default OFF = one curve drives both fans. When ON, a Fan 1 / Fan 2 selector
                                             (below) switches which fan the graph edits — MSI-style per-fan curves.
                                             The toggle sits first in the row so the D-Pad can reach it. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption764" Grid.Column="0" Text="Separate Fan 1 / Fan 2" FontSize="13" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleSwitch x:Name="MsiFanSeparateToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"
                                                          MinWidth="0"
                                                          OnContent="" OffContent=""
                                                          VerticalAlignment="Center"
                                                          Toggled="MsiFanSeparateToggle_Toggled"/>
                                            <TextBlock x:Uid="OnexCaption765" Grid.Column="3" Text="Preset" FontSize="13" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="MsiFanPresetComboBox"
                                                      Grid.Column="4"
                                                      Width="160"
                                                      SelectionChanged="MsiFanPresetComboBox_SelectionChanged"
                                                      KeyDown="MsiFanPresetComboBox_KeyDown">
                                                <ComboBoxItem x:Uid="OnexCaption766" Content="MSI Default" Tag="0" IsSelected="True"/>
                                                <ComboBoxItem x:Uid="OnexCaption767" Content="Quiet Idle" Tag="1"/>
                                                <ComboBoxItem x:Uid="OnexCaption768" Content="Cooling · Early Ramp" Tag="2"/>
                                                <ComboBoxItem x:Uid="OnexCaption769" Content="Custom" Tag="3"/>
                                                <ComboBoxItem x:Uid="OnexCaption770" Content="EC Sport default (debug)" Tag="4"/>
                                            </ComboBox>
                                        </Grid>
                                        <!-- Per-fan selector (shown only when Separate is on). Right-aligned to line
                                             up under the Preset picker. IsTabStop + the parent's XYFocusKeyboardNavigation
                                             make it reachable by D-Pad. -->
                                        <StackPanel x:Name="MsiFanSelectPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                            <ComboBox x:Name="MsiFanSelectComboBox"
                                                      HorizontalAlignment="Right"
                                                      Width="160"
                                                      IsTabStop="True"
                                                      SelectionChanged="MsiFanSelectComboBox_SelectionChanged"
                                                      KeyDown="MsiFanSelectComboBox_KeyDown">
                                                <ComboBoxItem x:Uid="OnexCaption771" Content="Fan 1 (CPU)" IsSelected="True"/>
                                                <ComboBoxItem x:Uid="OnexCaption772" Content="Fan 2 (GPU)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- One dark panel holds the live readout, the bar graph and Apply, so the
                                             readout/Apply read as part of the graph instead of floating loose. -->
                                        <Border Background="#1A1A1A" CornerRadius="6" Padding="10,8,10,10" Margin="0,10,0,0">
                                          <StackPanel>

                                        <!-- Live readout on ONE line so it stays visible when the graph takes focus
                                             (focusing scrolls the graph up; a 2-line header was pushed off top). Short
                                             "CPU:" label frees the width for both fans + live duty %. Fan 2 (GPU) is
                                             hidden until the EC reports a valid reading. -->
                                        <StackPanel x:Name="MsiFanReadoutPanel" Orientation="Horizontal" Margin="2,0,0,6" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption773" Text="CPU:" FontSize="13" Foreground="#B0B0B0"/>
                                            <TextBlock x:Uid="OnexCaption774" x:Name="MsiFanTempLabel" Text="--°C" Margin="4,0,0,0" FontSize="13" Foreground="#FF8800" FontWeight="SemiBold"/>
                                            <TextBlock Text="·" Margin="10,0,10,0" FontSize="13" Foreground="#808080"/>
                                            <TextBlock x:Uid="OnexCaption775" Text="Fan 1:" FontSize="13" Foreground="#B0B0B0"/>
                                            <TextBlock x:Uid="OnexCaption776" x:Name="MsiFanRpmLabel" Text="0 RPM" Margin="4,0,0,0" FontSize="13" Foreground="#00AAFF" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="MsiFan1DutyLabel" Text="" Margin="4,0,0,0" FontSize="13" Foreground="#7FC8E8"/>
                                            <StackPanel x:Name="MsiFan2Panel" Orientation="Horizontal" Visibility="Collapsed">
                                                <TextBlock Text="·" Margin="10,0,10,0" FontSize="13" Foreground="#808080"/>
                                                <TextBlock x:Uid="OnexCaption777" Text="Fan 2:" FontSize="13" Foreground="#B0B0B0"/>
                                                <TextBlock x:Uid="OnexCaption778" x:Name="MsiFan2RpmLabel" Text="0 RPM" Margin="4,0,0,0" FontSize="13" Foreground="#00AAFF" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="MsiFan2DutyLabel" Text="" Margin="4,0,0,0" FontSize="13" Foreground="#7FC8E8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- The settle countdown used to have a second home here, above the graph.
                                             It was written before the cooldown OVERLAY existed; now the overlay
                                             covers the whole graph, states the same thing in a much larger type
                                             and explains the lock as well, so this line only repeated it. -->

                                        <!-- Unsaved-edits indicator. Shown (and pulsing) only while there are
                                             pending fan edits — same dirty state that lights the Apply button.
                                             Sits where the fan-scope badge used to be; the scope badge itself
                                             moved down next to the Apply button. -->
                                        <Border x:Name="MsiFanUnsavedBadge" Background="#10344A" BorderBrush="#00AAFF" BorderThickness="1"
                                                CornerRadius="4" Padding="8,3" Margin="2,0,0,8" HorizontalAlignment="Left"
                                                Visibility="Collapsed">
                                            <Border.Resources>
                                                <Storyboard x:Name="MsiFanUnsavedBlink" RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="MsiFanUnsavedBadge"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.4" Duration="0:0:0.7"/>
                                                </Storyboard>
                                            </Border.Resources>
                                            <TextBlock x:Uid="OnexCaption779" Text="Unsaved changes"
                                                       FontSize="15" FontWeight="SemiBold" Foreground="#5CC9F0"/>
                                        </Border>

                                        <!-- MSI-style bars: fan % per fixed breakpoint; the temperature is the label under each bar -->
                                        <Grid Height="310">
                                            <!-- Focusable wrapper so the graph is reachable by controller
                                                 (Canvas itself is a Panel and cannot be a tab stop). -->
                                            <ContentControl x:Name="MsiFanCurveFocus"
                                                            IsTabStop="True"
                                                            UseSystemFocusVisuals="True"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            GotFocus="MsiFanCurveCanvas_GotFocus"
                                                            LostFocus="MsiFanCurveCanvas_LostFocus"
                                                            KeyDown="MsiFanCurveCanvas_KeyDown">
                                                <Canvas x:Name="MsiFanCurveCanvas"
                                                        Background="Transparent"
                                                        PointerPressed="MsiFanCurveCanvas_PointerPressed"
                                                        PointerMoved="MsiFanCurveCanvas_PointerMoved"
                                                        PointerReleased="MsiFanCurveCanvas_PointerReleased"
                                                        PointerCaptureLost="MsiFanCurveCanvas_PointerReleased"
                                                        SizeChanged="MsiFanCurveCanvas_SizeChanged">
                                                    <!-- "Beyond MSI" zone: above MSI's 75 % (RefDuty) cap (only when extended range is on) -->
                                                    <Rectangle x:Name="MsiFanBeyondBand" Fill="#1EF0603C" IsHitTestVisible="False"/>
                                                    <!-- Retained (collapsed) from the old line-graph layout so code refs stay valid -->
                                                    <Polygon x:Name="MsiFanCurveFill" Visibility="Collapsed"/>
                                                    <Polyline x:Name="MsiFanCurvePolyline" Visibility="Collapsed"/>
                                                    <!-- MSI max (75 % = RefDuty) reference line + label -->
                                                    <Line x:Name="MsiFanMsiMaxLine" Stroke="#88F0603C" StrokeThickness="1" StrokeDashArray="3,3" IsHitTestVisible="False"/>
                                                    <TextBlock x:Uid="OnexCaption780" x:Name="MsiFanMsiMaxLabel" Text="MSI max 75%" FontSize="12" Foreground="#F0A090" IsHitTestVisible="False"/>
                                                    <!-- Broken-axis marker: zigzag across the plot where the 0..floor dead zone is compressed -->
                                                    <Polyline x:Name="MsiFanAxisBreak" Stroke="#66AEBECF" StrokeThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                                                    <Line x:Name="MsiFanTempIndicatorLine"
                                                          Stroke="#FF8800" StrokeThickness="2" StrokeDashArray="4,2"
                                                          Visibility="Collapsed"/>
                                                </Canvas>
                                            </ContentControl>

                                            <!-- Cooldown lock. Sits ON the graph, because the small orange line
                                                 under the RPM readout was read past: people went on dragging bars
                                                 during the settle window and ended up with edits they then had to
                                                 apply on top of a change that had not landed yet. Covering the
                                                 canvas is also what blocks the pointer - no hit test reaches
                                                 through it - so the lock and the message are one element. -->
                                            <Border x:Name="MsiFanCooldownOverlay"
                                                    Background="#E6101A2A" BorderBrush="#FFAA46" BorderThickness="2"
                                                    CornerRadius="8" Visibility="Collapsed">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Margin="20" Spacing="6">
                                                    <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="28" Foreground="#FFAA46"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Uid="OnexCaption781" x:Name="MsiFanCooldownHeadline"
                                                               Text="Fan curve changing"
                                                               FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="MsiFanCooldownCountdown"
                                                               Text=""
                                                               FontSize="34" FontWeight="Bold" Foreground="#FFAA46"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Uid="OnexCaption782" Text="Editing is locked until the change has been written."
                                                               FontSize="13" Foreground="#C8C8C8"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Bottom row: fan-scope badge on the LEFT (Sync / which fan is being
                                             edited), Apply button on the RIGHT, on the same line.
                                             Apply pending curve/temp edits to the EC. Lit + focusable only when
                                             there are unsaved manual edits (protects the fan/EC from a write on
                                             every drag); disabled + skipped by the D-Pad focus chain otherwise.
                                             It only appears on a change, so it pulses while pending to catch the eye. -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Fan settings status — Sync (both fans one curve) vs which fan the
                                                 graph is editing. Blue/cyan badge (fan accent), distinct from the
                                                 orange global / green game profile badges. -->
                                            <Border x:Name="MsiFanStatusBadge" Grid.Column="0"
                                                    Background="#10344A" BorderBrush="#00AAFF" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption783" x:Name="MsiFanStatusText" Text="Fan 1 &amp; 2 · Sync"
                                                           FontSize="15" FontWeight="SemiBold" Foreground="#5CC9F0"/>
                                            </Border>
                                            <!-- The scope rides ON the Apply button because the fan is the
                                                 one setting written by an explicit Apply — the user has to
                                                 see where it lands at the moment they press it. -->
                                            <Button x:Name="MsiFanApplyButton"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="False"
                                                    IsTabStop="False"
                                                    Opacity="0.45"
                                                    Background="#1F6FEB"
                                                    Foreground="White"
                                                    Style="{StaticResource StandaloneButtonStyle}"
                                                    Click="MsiFanApplyButton_Click"
                                                    KeyDown="MsiFanApplyButton_KeyDown">
                                                <Button.Resources>
                                                    <Storyboard x:Name="MsiFanApplyBlink" RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="MsiFanApplyButton"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.5" Duration="0:0:0.7"/>
                                                    </Storyboard>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Uid="OnexCaption784" Text="Apply fan curve" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#x2192;" Margin="6,0,6,0" VerticalAlignment="Center" Opacity="0.75"/>
                                                    <TextBlock x:Uid="OnexCaption785" x:Name="MsiFanApplyScopeText" Text="Global"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                          </StackPanel>
                                        </Border>

                                        <!-- Verify the values actually written to the EC against the graph -->
                                        <StackPanel Margin="0,10,0,0">
                                            <Button x:Uid="OnexCaption786" x:Name="MsiFanCheckButton"
                                                    Content="Check applied values"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource StandaloneButtonStyle}"
                                                    Click="MsiFanCheckButton_Click"
                                                    KeyDown="MsiFanCheckButton_KeyDown"/>
                                            <TextBlock x:Name="MsiFanCheckStatus"
                                                       Margin="0,6,0,0"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="#A0A0A0"
                                                       Text=""/>
                                        </StackPanel>

                                        <!-- Extended range: unlock fan % above MSI's 75 % (RefDuty) cap. Sits below the
                                             graph/verify block: it is a rarely-touched escape hatch, not part of
                                             the everyday edit-then-apply flow above. -->
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption787" Text="Extended range (&gt;75%)" FontSize="13" Foreground="#E0E0E0"/>
                                                <TextBlock x:Uid="OnexCaption788" Text="Allow fan % beyond what MSI does" FontSize="11" Foreground="#C8C8C8"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="MsiFanExtendedRangeToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"
                                                          VerticalAlignment="Center"
                                                          Toggled="MsiFanExtendedRangeToggle_Toggled"/>
                                        </Grid>
                                        <TextBlock x:Uid="OnexCaption789" Margin="0,8,0,0"
                                                   FontSize="11" Foreground="#A0A0A0" TextWrapping="Wrap"
                                                   Text="Custom curve: drag a bar up/down for its fan %. With a controller: D-Pad left/right to pick a bar, A to grab, D-Pad up/down to adjust, A/B to release. The temperatures under the bars are the firmware&#x27;s own breakpoints and are shown for reference — like MSI Center M, only the fan % is adjustable. The curve is written to the EC (both fans). Turn this off to return to MSI&#x27;s firmware control."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- TINY CENTER M TAB (MSI Claw hardware controller config, Center-M-conform).
                     Four collapsible sections, all collapsed by default: LED, charge limit,
                     stick/trigger deadzones and the hardware gyro. The LED + charge-limit cards
                     moved here verbatim from the System tab (same controls, same handlers) so
                     everything that talks to the controller hardware lives in one place. -->
                <ScrollViewer x:Name="TinyCenterMScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">
                        <TextBlock x:Uid="OnexCaption790" Text="Tiny Center M" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock x:Uid="OnexCaption791" Text="Hardware controller settings, written straight to the controller and kept in sync with MSI Center M."
                                   FontSize="13" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TcmStatusText" FontSize="13" Foreground="#FFC107" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,10"/>

                        <!-- ═══ 1. LED lighting ═══════════════════════════════════════════ -->
                        <!-- Controller LED Color (MSI Claw) — placed directly below Charge Limit.
                             Visibility is enabled by code on MSI Claw. -->
                        <Border x:Name="MsiLedColorCard" x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon column is a Grid, not a horizontal StackPanel: a StackPanel
                                         sizes to content, which would stop the caption below from
                                         wrapping. Same construction for every captioned section header. -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption792" Text="Controller LED Color" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Uid="OnexCaption793" Text="Set the controller LED color."
                                                       Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <ToggleButton x:Name="MsiLedExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  IsEnabled="True"
                                                  VerticalAlignment="Top"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="MsiLedExpandButton_Click">
                                        <FontIcon x:Name="MsiLedExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="MsiLedContent" Visibility="Collapsed" Margin="0,12,0,0"
                                            XYFocusKeyboardNavigation="Enabled">

                                    <!-- ── Sync all zones ─────────────────────────────────────────────── -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption794" Text="Sync right stick, left stick &amp; buttons" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock x:Uid="OnexCaption795" Text="Off lets you give the right stick, left stick and buttons their own individual colors and effects."
                                                       FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="MsiLedSyncToggle" Grid.Column="1"
                                                      OnContent="" OffContent="" IsOn="True"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Toggled="MsiLedSyncToggle_Toggled"/>
                                    </Grid>

                                    <!-- ── Zone selector (only when NOT synced) ───────────────────────── -->
                                    <StackPanel x:Name="MsiLedZoneRow" Margin="0,0,0,12" Visibility="Collapsed">
                                        <TextBlock x:Uid="OnexCaption796" Text="Zone" FontSize="12" Foreground="#DDDDDD" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="MsiLedZoneCombo" Width="280" HorizontalAlignment="Left"
                                                  SelectionChanged="MsiLedZoneCombo_SelectionChanged">
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Image Source="ms-appx:///Assets/ButtonIcons/xbox_stick_r.png" Width="20" Height="20"/>
                                                    <TextBlock x:Uid="OnexCaption797" Text="Right stick" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Image Source="ms-appx:///Assets/ButtonIcons/xbox_stick_l.png" Width="20" Height="20"/>
                                                    <TextBlock x:Uid="OnexCaption798" Text="Left stick" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Image Source="ms-appx:///Assets/ButtonIcons/xbox_button_color_a.png" Width="20" Height="20"/>
                                                    <Image Source="ms-appx:///Assets/ButtonIcons/xbox_button_color_b.png" Width="20" Height="20"/>
                                                    <Image Source="ms-appx:///Assets/ButtonIcons/xbox_button_color_x.png" Width="20" Height="20"/>
                                                    <Image Source="ms-appx:///Assets/ButtonIcons/xbox_button_color_y.png" Width="20" Height="20"/>
                                                    <TextBlock x:Uid="OnexCaption799" Text="Buttons" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ── Mode selector (per zone) ───────────────────────────────────── -->
                                    <TextBlock x:Uid="OnexCaption800" Text="Mode" FontSize="12" Foreground="#DDDDDD" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MsiLedModeCombo" Width="280" HorizontalAlignment="Left"
                                              SelectionChanged="MsiLedModeCombo_SelectionChanged">
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE790;" FontSize="16"/><TextBlock x:Uid="OnexCaption801" Text="Static" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE706;" FontSize="16"/><TextBlock x:Uid="OnexCaption802" Text="Breathing" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE895;" FontSize="16"/><TextBlock x:Uid="OnexCaption803" Text="Color Cycle" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE72C;" FontSize="16"/><TextBlock x:Uid="OnexCaption804" Text="Wave" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE83F;" FontSize="16"/><TextBlock x:Uid="OnexCaption805" Text="Battery" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>

                                    <!-- ── Color (Static / Breathing-solid): swatch opens the colour wheel ── -->
                                    <StackPanel x:Name="MsiLedColorRow" Margin="0,14,0,0">
                                        <TextBlock x:Uid="OnexCaption806" Text="Color" FontSize="12" Foreground="#DDDDDD" Margin="0,0,0,4"/>
                                        <Button x:Name="MsiLedColorSwatchButton" Padding="2" BorderThickness="1"
                                                BorderBrush="#55FFFFFF" Background="#22FFFFFF" HorizontalAlignment="Left">
                                            <Border x:Name="MsiLedColorSwatch" Width="56" Height="28" CornerRadius="3" Background="#FFFFFF"/>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <muxc:ColorPicker x:Name="MsiLedColorPicker"
                                                                      ColorSpectrumShape="Ring"
                                                                      IsAlphaEnabled="False" IsAlphaSliderVisible="False"
                                                                      IsColorSliderVisible="False"
                                                                      IsHexInputVisible="False" IsColorChannelTextInputVisible="False"
                                                                      IsMoreButtonVisible="False"
                                                                      Loaded="MsiLedPicker_Loaded"
                                                                      ColorChanged="MsiLedColorPicker_ColorChanged"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                    <!-- ── Rainbow toggle (Breathing + Wave) ──────────────────────────── -->
                                    <Grid x:Name="MsiLedRainbowRow" Margin="0,14,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption807" Text="Rainbow" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock x:Uid="OnexCaption808" x:Name="MsiLedRainbowCaption" Text="On = rainbow. Off = your colour(s)."
                                                       FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="MsiLedRainbowToggle" Grid.Column="1"
                                                      OnContent="" OffContent="" IsOn="False"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Toggled="MsiLedRainbowToggle_Toggled"/>
                                    </Grid>

                                    <!-- ── Wave custom colours: 4 swatches (Wave, Rainbow off) ────────── -->
                                    <StackPanel x:Name="MsiLedWaveSwatchRow" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Button x:Name="MsiLedWaveSwatchButton0" Padding="2" BorderThickness="1" BorderBrush="#55FFFFFF" Background="#22FFFFFF">
                                            <Border x:Name="MsiLedWaveSwatch0" Width="40" Height="28" CornerRadius="3" Background="#FF0000"/>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <muxc:ColorPicker x:Name="MsiLedWavePicker0" Tag="0" ColorSpectrumShape="Ring"
                                                                      IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsColorSliderVisible="False"
                                                                      IsHexInputVisible="False" IsColorChannelTextInputVisible="False"
                                                                      IsMoreButtonVisible="False" Loaded="MsiLedPicker_Loaded" ColorChanged="MsiLedWavePicker_ColorChanged"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="MsiLedWaveSwatchButton1" Padding="2" BorderThickness="1" BorderBrush="#55FFFFFF" Background="#22FFFFFF">
                                            <Border x:Name="MsiLedWaveSwatch1" Width="40" Height="28" CornerRadius="3" Background="#FFFF00"/>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <muxc:ColorPicker x:Name="MsiLedWavePicker1" Tag="1" ColorSpectrumShape="Ring"
                                                                      IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsColorSliderVisible="False"
                                                                      IsHexInputVisible="False" IsColorChannelTextInputVisible="False"
                                                                      IsMoreButtonVisible="False" Loaded="MsiLedPicker_Loaded" ColorChanged="MsiLedWavePicker_ColorChanged"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="MsiLedWaveSwatchButton2" Padding="2" BorderThickness="1" BorderBrush="#55FFFFFF" Background="#22FFFFFF">
                                            <Border x:Name="MsiLedWaveSwatch2" Width="40" Height="28" CornerRadius="3" Background="#00FF00"/>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <muxc:ColorPicker x:Name="MsiLedWavePicker2" Tag="2" ColorSpectrumShape="Ring"
                                                                      IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsColorSliderVisible="False"
                                                                      IsHexInputVisible="False" IsColorChannelTextInputVisible="False"
                                                                      IsMoreButtonVisible="False" Loaded="MsiLedPicker_Loaded" ColorChanged="MsiLedWavePicker_ColorChanged"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="MsiLedWaveSwatchButton3" Padding="2" BorderThickness="1" BorderBrush="#55FFFFFF" Background="#22FFFFFF">
                                            <Border x:Name="MsiLedWaveSwatch3" Width="40" Height="28" CornerRadius="3" Background="#0000FF"/>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <muxc:ColorPicker x:Name="MsiLedWavePicker3" Tag="3" ColorSpectrumShape="Ring"
                                                                      IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsColorSliderVisible="False"
                                                                      IsHexInputVisible="False" IsColorChannelTextInputVisible="False"
                                                                      IsMoreButtonVisible="False" Loaded="MsiLedPicker_Loaded" ColorChanged="MsiLedWavePicker_ColorChanged"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                    <!-- ── Speed (Breathing / Color Cycle / Wave) ─────────────────────── -->
                                    <StackPanel x:Name="MsiLedSpeedRow" Margin="0,14,0,0" Visibility="Collapsed">
                                        <TextBlock x:Uid="OnexCaption809" Text="Speed" FontSize="12" Foreground="#DDDDDD" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="MsiLedSpeedCombo" Width="280" HorizontalAlignment="Left"
                                                  SelectionChanged="MsiLedSpeedCombo_SelectionChanged">
                                            <ComboBoxItem x:Uid="OnexCaption810" Content="Slow"/>
                                            <ComboBoxItem x:Uid="OnexCaption811" Content="Medium"/>
                                            <ComboBoxItem x:Uid="OnexCaption812" Content="Fast"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ── Direction (Wave) ───────────────────────────────────────────── -->
                                    <StackPanel x:Name="MsiLedDirectionRow" Margin="0,14,0,0" Visibility="Collapsed">
                                        <TextBlock x:Uid="OnexCaption813" Text="Direction" FontSize="12" Foreground="#DDDDDD" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="MsiLedDirectionCombo" Width="280" HorizontalAlignment="Left"
                                                  SelectionChanged="MsiLedDirectionCombo_SelectionChanged">
                                            <ComboBoxItem x:Uid="OnexCaption814" Content="Clockwise"/>
                                            <ComboBoxItem x:Uid="OnexCaption815" Content="Counter-clockwise"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ── Color Cycle note (shown only in Color Cycle mode) ──────────── -->
                                    <TextBlock x:Uid="OnexCaption816" x:Name="MsiLedCycleNote" Visibility="Collapsed" Margin="0,14,0,0"
                                               Text="Color Cycle sweeps smoothly through a colour spectrum. Custom cycle colours are coming in a follow-up."
                                               FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>

                                    <!-- ── Brightness — GLOBAL (applies to ALL zones); visually separated ── -->
                                    <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,0"/>
                                    <TextBlock x:Uid="OnexCaption817" x:Name="MsiLedBrightnessLabel" Text="Brightness"
                                               FontSize="12" Foreground="#DDDDDD" Margin="0,12,0,0"/>
                                    <TextBlock x:Uid="OnexCaption818" Text="Applies to all zones" FontSize="11"
                                               Foreground="{StaticResource HintTextBrush}" Margin="0,0,0,2"/>
                                    <Slider x:Name="MsiLedBrightnessSlider" Minimum="0" Maximum="100"
                                            Width="280" HorizontalAlignment="Left"
                                            XYFocusUp="{x:Bind MsiLedSpeedCombo}"
                                            ValueChanged="MsiLedBrightnessSlider_ValueChanged"/>

                                    <!-- ── Battery note (shown only in Battery mode) ──────────────────── -->
                                    <TextBlock x:Uid="OnexCaption819" x:Name="MsiLedBatteryNote" Visibility="Collapsed" Margin="0,10,0,0"
                                               Text="Battery: the LED hue follows the charge level (≥90% blue → &lt;20% purple), updated when it crosses a 10% band. The slider above sets its brightness."
                                               FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>

                                    <!-- Legacy compat control — kept Collapsed so its existing code-behind
                                         handler keeps compiling (the old battery toggle is superseded by the
                                         Battery mode above). -->
                                    <ToggleSwitch x:Name="LedColorBySocToggle" Visibility="Collapsed"
                                                  OnContent="" OffContent="" IsOn="False" Toggled="LedColorBySocToggle_Toggled"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 2. Charge limit ══════════════════════════════════════════ -->
                        <!-- Charge Limit Card (MSI Claw A1M / A2VM) -->
                        <Border x:Name="MsiChargeLimitCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Header: title + expand toggle. The enable toggle lives inside the
                                     collapsible body (there is a separate Quick Settings tile that shows
                                     the charge limit), so the header stays clean when collapsed. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE83F;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption820" Text="Charge Limit" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Uid="OnexCaption821" Text="Limit battery charging to extend long-term lifespan"
                                                       Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <ToggleButton x:Name="ChargeLimitExpandButton" Grid.Column="1" IsChecked="False"
                                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4"
                                                  Click="ChargeLimitExpandButton_Click" UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="ChargeLimitExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible content -->
                                <StackPanel x:Name="MsiChargeLimitContent" Visibility="Collapsed" Margin="0,12,0,0">
                                <!-- Enable toggle (moved out of the header) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption822" Text="Enable charge limit" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock x:Uid="OnexCaption823" Text="Stop charging once the battery reaches the level below."
                                                   FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MsiChargeLimitToggle"
                                                  Grid.Column="1"
                                                  OnContent="" OffContent=""
                                                  IsOn="False"
                                                  Toggled="MsiChargeLimitToggle_Toggled"/>
                                </Grid>
                                <!-- Percentage selection — shown when toggle is on -->
                                <StackPanel x:Name="MsiChargeLimitPercentPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock x:Uid="OnexCaption824" Text="Charge to at most" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MsiChargeLimitValue" Text="80%"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="14" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="MsiChargeLimitSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="30" Maximum="100"
                                            StepFrequency="5" SmallChange="5" LargeChange="10" TickFrequency="10"
                                            TickPlacement="Outside" SnapsTo="StepValues"
                                            Value="80"
                                            XYFocusUp="{x:Bind MsiChargeLimitToggle}"
                                            XYFocusDown="{x:Bind MsiChargeLimitVerifyButton}"
                                            ValueChanged="MsiChargeLimitSlider_ValueChanged"/>

                                    <!-- Read-back / verification row (reads the actual EC value) -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MsiChargeLimitStatusText" Grid.Column="0"
                                                   Text="" FontSize="11" Foreground="{StaticResource HintTextBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Uid="OnexCaption825" x:Name="MsiChargeLimitVerifyButton" Grid.Column="1"
                                                Content="Verify" FontSize="12" Padding="12,4"
                                                Click="MsiChargeLimitVerifyButton_Click"/>
                                    </Grid>

                                    <TextBlock x:Uid="OnexCaption826" Text="Note: the limit is enforced by the controller (EC) itself, so it keeps working while the Claw is asleep or shut down but plugged in. The EC value can be cleared by an EC reset, BIOS update or a full battery drain — use Verify to re-check the live value after sleep / hibernation."
                                               FontSize="11" Foreground="#FF8C00"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 3. Stick & trigger deadzones / limits ════════════════════ -->
                        <Border x:Name="TcmSticksCard" x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption827" Text="Stick &amp; Trigger Settings" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Uid="OnexCaption828" Text="Deadzones and limits for both sticks and triggers, written straight to the controller."
                                                       Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <ToggleButton x:Name="TcmSticksExpandButton" Grid.Column="1" IsChecked="False"
                                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4"
                                                  Click="TcmSticksExpandButton_Click" UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="TcmSticksExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <StackPanel x:Name="TcmSticksContent" Visibility="Collapsed" Margin="0,12,0,0"
                                            XYFocusKeyboardNavigation="Enabled">
                                    <!-- Slider drags only STAGE a change; this button is what actually writes
                                         firmware + profile.rec and bounces Center M. Hence it sits on top. -->
                                    <Button x:Name="TcmApplyButton" Click="TcmApply_Click" IsEnabled="False"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="12,10" Margin="0,0,0,8"
                                            XYFocusUp="{x:Bind TcmSticksExpandButton}"
                                            XYFocusDown="{x:Bind TcmResetButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock x:Uid="OnexCaption829" x:Name="TcmApplyText" Text="No unsaved changes"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- One reset for sticks AND triggers. Stages the MSI factory values like any
                                         other edit, so it still goes through Apply above. -->
                                    <Button x:Uid="OnexCaption830" x:Name="TcmResetButton" Content="Reset sticks &amp; triggers to default"
                                            Click="TcmResetAll_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,6"
                                            XYFocusUp="{x:Bind TcmApplyButton}"
                                            XYFocusDown="{x:Bind TcmLSDZSlider}"/>

                                    <!-- Sticks and triggers in two columns, left-hand controls on the left and right-hand on the
                                         right, so the panel mirrors the device you are holding. Each cell is one group: its own
                                         header plus that group's two sliders.

                                         D-pad wiring follows the same idea. DOWN walks a column (left stick -> left trigger),
                                         LEFT/RIGHT jumps to the SAME control on the other hand — inner deadzone to inner deadzone,
                                         limit to limit. That is the comparison anyone actually makes here, and it means a value can
                                         be matched on both sides without travelling through everything in between. -->
                                    <Grid Margin="0,16,0,0" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Image Source="ms-appx:///Assets/ButtonIcons/xbox_stick_l.png" Width="20" Height="20" Margin="0,0,8,0"/>
                                                <TextBlock x:Uid="OnexCaption831" Text="Left stick" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid><TextBlock x:Uid="OnexCaption832" Text="Inner deadzone"/><TextBlock x:Name="TcmLSDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmLSDZSlider" Tag="LSDZ" Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmResetButton}" XYFocusDown="{x:Bind TcmLSEDZSlider}" XYFocusRight="{x:Bind TcmRSDZSlider}"/>
                                            <Grid Margin="0,8,0,0"><TextBlock x:Uid="OnexCaption833" Text="Outer threshold"/><TextBlock x:Name="TcmLSEDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmLSEDZSlider" Tag="LSEDZ" Minimum="75" Maximum="100" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmLSDZSlider}" XYFocusDown="{x:Bind TcmLTDZSlider}" XYFocusRight="{x:Bind TcmRSEDZSlider}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Image Source="ms-appx:///Assets/ButtonIcons/xbox_stick_r.png" Width="20" Height="20" Margin="0,0,8,0"/>
                                                <TextBlock x:Uid="OnexCaption834" Text="Right stick" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid><TextBlock x:Uid="OnexCaption835" Text="Inner deadzone"/><TextBlock x:Name="TcmRSDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmRSDZSlider" Tag="RSDZ" Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmResetButton}" XYFocusDown="{x:Bind TcmRSEDZSlider}" XYFocusLeft="{x:Bind TcmLSDZSlider}"/>
                                            <Grid Margin="0,8,0,0"><TextBlock x:Uid="OnexCaption836" Text="Outer threshold"/><TextBlock x:Name="TcmRSEDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmRSEDZSlider" Tag="RSEDZ" Minimum="75" Maximum="100" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmRSDZSlider}" XYFocusDown="{x:Bind TcmRTDZSlider}" XYFocusLeft="{x:Bind TcmLSEDZSlider}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Image Source="ms-appx:///Assets/ButtonIcons/xbox_lt.png" Width="20" Height="20" Margin="0,0,8,0"/>
                                                <TextBlock x:Uid="OnexCaption837" Text="Left trigger" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid><TextBlock x:Uid="OnexCaption838" Text="Deadzone"/><TextBlock x:Name="TcmLTDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmLTDZSlider" Tag="LTDZ" Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmLSEDZSlider}" XYFocusDown="{x:Bind TcmLTEDZSlider}" XYFocusRight="{x:Bind TcmRTDZSlider}"/>
                                            <Grid Margin="0,8,0,0"><TextBlock x:Uid="OnexCaption839" Text="Limit"/><TextBlock x:Name="TcmLTEDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <!-- Limit floor is 3 %: on-device 2026-07-27 everything from 3 to 100 applies cleanly, below
                                                 that the trigger no longer behaves. The write path is byte-identical to MSI's, so this is
                                                 a firmware limit, not ours. -->
                                            <Slider x:Name="TcmLTEDZSlider" Tag="LTEDZ" Minimum="3" Maximum="100" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmLTDZSlider}" XYFocusRight="{x:Bind TcmRTEDZSlider}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Image Source="ms-appx:///Assets/ButtonIcons/xbox_rt.png" Width="20" Height="20" Margin="0,0,8,0"/>
                                                <TextBlock x:Uid="OnexCaption840" Text="Right trigger" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid><TextBlock x:Uid="OnexCaption841" Text="Deadzone"/><TextBlock x:Name="TcmRTDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmRTDZSlider" Tag="RTDZ" Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmRSEDZSlider}" XYFocusDown="{x:Bind TcmRTEDZSlider}" XYFocusLeft="{x:Bind TcmLTDZSlider}"/>
                                            <Grid Margin="0,8,0,0"><TextBlock x:Uid="OnexCaption842" Text="Limit"/><TextBlock x:Name="TcmRTEDZValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                            <Slider x:Name="TcmRTEDZSlider" Tag="RTEDZ" Minimum="3" Maximum="100" StepFrequency="1" SmallChange="1" ValueChanged="TcmSlider_ValueChanged"
                                                    XYFocusUp="{x:Bind TcmRTDZSlider}" XYFocusLeft="{x:Bind TcmLTEDZSlider}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 4. Hardware gyro (detect + disable only) ═════════════════ -->
                        <!-- The firmware gyro is MSI Center M's own motion feature, living in EEPROM
                             0x0029 bit0 (RE-verified on A2VM). It runs inside the controller and keeps
                             running independently of ONEXTweaks' virtual gyro, which is why the two can
                             fight. This section only READS that bit and offers a one-way off switch —
                             there is deliberately no enable path, turning it back on stays Center M's job. -->
                        <Border x:Name="TcmGyroCard" x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AD;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption843" Text="Hardware Gyro (global)" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Uid="OnexCaption844" Text="MSI&#x27;s firmware gyro, applied globally — enable it, pick right stick or mouse, and how it turns on. Per-game gyro is set in the Controller tab."
                                                       Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <ToggleButton x:Name="TcmGyroExpandButton" Grid.Column="1" IsChecked="False"
                                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4"
                                                  Click="TcmGyroExpandButton_Click" UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="TcmGyroExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <StackPanel x:Name="TcmGyroContent" Visibility="Collapsed" Margin="0,12,0,0"
                                            XYFocusKeyboardNavigation="Enabled">
                                    <!-- Apply sits at the very top so pending changes are always visible without scrolling. -->
                                    <Button x:Name="TcmGyroApplyButton" Click="TcmGyroApply_Click" IsEnabled="False"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="12,10" Margin="0,0,0,8"
                                            XYFocusUp="{x:Bind TcmGyroExpandButton}"
                                            XYFocusDown="{x:Bind TcmGyroEnableToggle}">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock x:Uid="OnexCaption845" x:Name="TcmGyroApplyText" Text="No unsaved changes"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Live state read from the controller (0x0029 bit0). -->
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption846" Text="Current state" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TcmGyroStateText" Text="—"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#C8C8C8"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,4">
                                        <TextBlock x:Uid="OnexCaption847" Text="Enable firmware gyro" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Uid="OnexCaption848" x:Name="TcmGyroEnableToggle" HorizontalAlignment="Right" MinWidth="0"
                                                      OnContent="On" OffContent="Off" Toggled="TcmGyro_Changed"
                                                      XYFocusUp="{x:Bind TcmGyroApplyButton}"
                                                      XYFocusDown="{x:Bind TcmGyroOutputCombo}"/>
                                    </Grid>

                                    <StackPanel x:Name="TcmGyroConfigPanel">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption849" Text="Output" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="TcmGyroOutputCombo" Grid.Column="1" MinWidth="150"
                                                      Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0"
                                                      SelectionChanged="TcmGyroCombo_Changed"
                                                      XYFocusUp="{x:Bind TcmGyroEnableToggle}"
                                                      XYFocusDown="{x:Bind TcmGyroActivationCombo}">
                                                <ComboBoxItem x:Uid="OnexCaption850" Content="Right stick" Tag="stick"/>
                                                <ComboBoxItem x:Uid="OnexCaption851" Content="Mouse"       Tag="mouse"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption852" Text="Activation" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="TcmGyroActivationCombo" Grid.Column="1" MinWidth="150"
                                                      Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0"
                                                      SelectionChanged="TcmGyroCombo_Changed"
                                                      XYFocusUp="{x:Bind TcmGyroOutputCombo}"
                                                      XYFocusDown="{x:Bind TcmGyroButtonCombo}">
                                                <ComboBoxItem x:Uid="OnexCaption853" Content="Always on"        Tag="always"/>
                                                <ComboBoxItem x:Uid="OnexCaption854" Content="Hold a button"    Tag="hold"/>
                                                <ComboBoxItem x:Uid="OnexCaption855" Content="Toggle a button"  Tag="toggle"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid x:Name="TcmGyroButtonRow" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption856" Text="Hold button" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="TcmGyroButtonCombo" Grid.Column="1" MinWidth="150"
                                                      Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0"
                                                      SelectionChanged="TcmGyroCombo_Changed"
                                                      XYFocusUp="{x:Bind TcmGyroActivationCombo}"
                                                      XYFocusDown="{x:Bind TcmGyroSensSlider}">
                                                <ComboBoxItem x:Uid="OnexCaption857" Content="L2" Tag="L2"/>
                                                <ComboBoxItem x:Uid="OnexCaption858" Content="R2" Tag="R2"/>
                                                <ComboBoxItem x:Uid="OnexCaption859" Content="M1" Tag="M1"/>
                                                <ComboBoxItem x:Uid="OnexCaption860" Content="M2" Tag="M2"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,14,0,0"><TextBlock x:Uid="OnexCaption861" Text="Sensitivity"/><TextBlock x:Name="TcmGyroSensValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="TcmGyroSensSlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1"
                                                ValueChanged="TcmGyroSlider_Changed"
                                                XYFocusUp="{x:Bind TcmGyroButtonCombo}" XYFocusDown="{x:Bind TcmGyroDzSlider}"/>
                                        <Grid Margin="0,8,0,0"><TextBlock x:Uid="OnexCaption862" Text="Deadzone"/><TextBlock x:Name="TcmGyroDzValue" Text="—" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="TcmGyroDzSlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1"
                                                ValueChanged="TcmGyroSlider_Changed"
                                                XYFocusUp="{x:Bind TcmGyroSensSlider}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SCALING TAB -->
                <ScrollViewer x:Name="ScalingScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Status Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption863" Text="Lossless Scaling Status" Style="{StaticResource CardTitleStyle}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Button x:Uid="OnexCaption864" x:Name="ShowLosslessScalingWindowButton"
                                            Grid.Column="1"
                                            Content="Show Window"
                                            Margin="0,0,8,0"
                                            Visibility="Collapsed"
                                            Click="ShowLosslessScalingWindowButton_Click"
                                            XYFocusUp="{x:Bind ScalingNavItem}"/>
                                    <Button x:Name="LaunchLosslessScalingButton"
                                            Grid.Column="2"
                                            Visibility="Collapsed"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Click="LaunchLosslessScalingButton_Click"
                                            XYFocusUp="{x:Bind ScalingNavItem}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock x:Uid="OnexCaption865" Text="Launch" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="OnexCaption866" x:Name="LosslessScalingStatusText"
                                           Text="Not Installed"
                                           FontSize="14"
                                           Foreground="#A0A0A0"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Current Profile Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Uid="OnexCaption867" Text="Current Profile" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption868" x:Name="LosslessScalingCurrentProfileText"
                                                   Text="Default"
                                                   FontSize="14"
                                                   Foreground="#00C8FF"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Uid="OnexCaption869" x:Name="LosslessScalingCreateProfileButton"
                                            Grid.Column="1"
                                            Content="Create Profile"
                                            VerticalAlignment="Center"
                                            IsEnabled="False"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Click="LosslessScalingCreateProfileButton_Click"
                                            XYFocusUp="{x:Bind ScalingNavItem}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Scale Toggle Button -->
                        <ToggleButton x:Name="LosslessScalingEnabledToggle"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="False"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource StandaloneToggleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <PathIcon Data="M5 5.27368C5 3.56682 6.82609 2.48151 8.32538 3.2973L20.687 10.0235C22.2531 10.8756 22.2531 13.124 20.687 13.9762L8.32538 20.7024C6.82609 21.5181 5 20.4328 5 18.726V5.27368Z"/>
                                </Viewbox>
                                <TextBlock x:Uid="OnexCaption870" Text="Lossless Scaling" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Apply and Restart Button -->
                        <Button x:Uid="OnexCaption871" x:Name="LosslessScalingSaveSettingsButton"
                                Content="Apply and Restart"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                IsEnabled="False"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Style="{StaticResource StandaloneButtonStyle}"
                                Click="LosslessScalingSaveSettingsButton_Click"/>

                        <!-- Reset Profile Button -->
                        <Button x:Uid="OnexCaption872" x:Name="LosslessScalingResetProfileButton"
                                Content="Reset to Defaults"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                IsEnabled="False"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Style="{StaticResource StandaloneButtonStyle}"
                                Click="LosslessScalingResetProfileButton_Click"/>

                        <!-- AutoScale Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption873" Text="AutoScale" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption874" Text="Automatically detect and scale games"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingAutoScaleToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                                <StackPanel Visibility="{Binding ElementName=LosslessScalingAutoScaleToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock x:Uid="OnexCaption875" Text="AutoScale Delay (s)"
                                                   FontSize="14"
                                                   Foreground="#A0A0A0"/>
                                        <TextBlock x:Name="LosslessScalingAutoScaleDelayValueText"
                                                   Text="{Binding ElementName=LosslessScalingAutoScaleDelaySlider, Path=Value}"
                                                   FontSize="14"
                                                   Foreground="#00C8FF"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingAutoScaleDelaySlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="10"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Scaling Type Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption876" Text="Scaling Algorithm" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ComboBox x:Uid="OnexCaption877" x:Name="LosslessScalingScalingTypeComboBox"
                                          PlaceholderText="Select Type"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="LosslessScalingScalingTypeComboBox_SelectionChanged">
                                    <x:String>Off</x:String>
                                    <x:String>LS1</x:String>
                                    <x:String>FSR</x:String>
                                    <x:String>NIS</x:String>
                                    <x:String>SGSR</x:String>
                                    <x:String>BCAS</x:String>
                                    <x:String>Anime4K</x:String>
                                    <x:String>xBR</x:String>
                                    <x:String>Sharp Bilinear</x:String>
                                    <x:String>Integer</x:String>
                                    <x:String>Nearest Neighbor</x:String>
                                </ComboBox>

                                <!-- Sharpness Slider (for FSR, NIS, SGSR, BCAS) -->
                                <StackPanel x:Name="LosslessScalingSharpnessPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption878" Text="Sharpness" FontSize="12" Foreground="#A0A0A0"/>
                                        <TextBlock x:Name="LosslessScalingSharpnessValueText"
                                                   Text="{Binding ElementName=LosslessScalingSharpnessSlider, Path=Value}"
                                                   FontSize="12"
                                                   Foreground="#00C8FF"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingSharpnessSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            TickFrequency="10"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>

                                <!-- FSR Optimize Toggle (FSR only) -->
                                <Grid x:Name="LosslessScalingFSROptimizePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption879" Grid.Column="0" Text="Optimize" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="LosslessScalingFSROptimizeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>

                                <!-- LS1 Type (LS1 only) — BALANCED vs PERFORMANCE -->
                                <StackPanel x:Name="LosslessScalingLS1TypePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock x:Uid="OnexCaption880" Text="LS1 Type" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                    <ComboBox x:Uid="OnexCaption881" x:Name="LosslessScalingLS1TypeComboBox"
                                              PlaceholderText="Select Type"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}">
                                        <x:String>BALANCED</x:String>
                                        <x:String>PERFORMANCE</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Resize Before Scale (any non-Off scaling type) -->
                                <Grid x:Name="LosslessScalingResizeBeforePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption882" Text="Resize Before Scale" FontSize="12" Foreground="#A0A0A0"/>
                                        <TextBlock x:Uid="OnexCaption883" Text="Snap window to integer ratio before upscale"
                                                   FontSize="11" Foreground="#707070"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingResizeBeforeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>

                                <!-- Anime4K Settings -->
                                <StackPanel x:Name="LosslessScalingAnime4KPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock x:Uid="OnexCaption884" Text="Size" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                    <ComboBox x:Uid="OnexCaption885" x:Name="LosslessScalingAnime4KSizeComboBox"
                                              PlaceholderText="Select Size"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}">
                                        <x:String>Small</x:String>
                                        <x:String>Medium</x:String>
                                        <x:String>Large</x:String>
                                        <x:String>Very Large</x:String>
                                        <x:String>Ultra Large</x:String>
                                    </ComboBox>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption886" Grid.Column="0" Text="VRS" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="LosslessScalingAnime4KVRSToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsEnabled="False"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Scale Mode Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption887" Text="Scale Mode" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ComboBox x:Uid="OnexCaption888" x:Name="LosslessScalingScaleModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="LosslessScalingScaleModeComboBox_SelectionChanged">
                                    <x:String>Auto</x:String>
                                    <x:String>Custom</x:String>
                                </ComboBox>

                                <!-- Auto Mode Settings -->
                                <StackPanel x:Name="LosslessScalingAutoModePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock x:Uid="OnexCaption889" Text="Aspect" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                    <ComboBox x:Uid="OnexCaption890" x:Name="LosslessScalingAspectRatioComboBox"
                                              PlaceholderText="Select Aspect"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}">
                                        <x:String>Aspect Ratio</x:String>
                                        <x:String>Fullscreen</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Custom Mode Settings -->
                                <StackPanel x:Name="LosslessScalingCustomModePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock x:Uid="OnexCaption891" Text="Scale Factor" FontSize="12" Foreground="#A0A0A0"/>
                                        <TextBlock x:Name="LosslessScalingScaleFactorValueText"
                                                   Text="{Binding ElementName=LosslessScalingScaleFactorSlider, Path=Value}"
                                                   FontSize="12"
                                                   Foreground="#00C8FF"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingScaleFactorSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="5"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Frame Generation Type Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption892" Text="Frame Generation" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ComboBox x:Uid="OnexCaption893" x:Name="LosslessScalingFrameGenTypeComboBox"
                                          PlaceholderText="Select Type"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <x:String>Off</x:String>
                                    <x:String>LSFG1</x:String>
                                    <x:String>LSFG2</x:String>
                                    <x:String>LSFG3</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- LSFG3 Settings Card -->
                        <Border x:Name="LSFG3SettingsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption894" Text="LSFG3 Settings" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- LSFG3 Mode -->
                                <TextBlock x:Uid="OnexCaption895" Text="Mode" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                <ComboBox x:Uid="OnexCaption896" x:Name="LosslessScalingLSFG3ModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,12"
                                          SelectionChanged="LosslessScalingLSFG3ModeComboBox_SelectionChanged">
                                    <x:String>FIXED</x:String>
                                    <x:String>ADAPTIVE</x:String>
                                </ComboBox>

                                <!-- LSFG3 Multiplier (hidden when Adaptive) -->
                                <StackPanel x:Name="LosslessScalingLSFG3MultiplierPanel">
                                    <TextBlock x:Uid="OnexCaption897" Text="Multiplier" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                    <ComboBox x:Uid="OnexCaption898" x:Name="LosslessScalingLSFG3MultiplierComboBox"
                                              PlaceholderText="Select Multiplier"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Margin="0,0,0,12">
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                        <x:String>4</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <!-- LSFG3 Target FPS -->
                                <Grid>
                                    <TextBlock x:Uid="OnexCaption899" Text="Target FPS" FontSize="12" Foreground="#A0A0A0"/>
                                    <TextBlock x:Name="LosslessScalingLSFG3TargetValueText"
                                               Text="{Binding ElementName=LosslessScalingLSFG3TargetSlider, Path=Value}"
                                               FontSize="12"
                                               Foreground="#00C8FF"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LosslessScalingLSFG3TargetSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="30" Maximum="240"
                                        TickFrequency="10"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,12"/>

                                <!-- Flow Scale -->
                                <Grid>
                                    <TextBlock x:Uid="OnexCaption900" Text="Flow Scale" FontSize="12" Foreground="#A0A0A0"/>
                                    <TextBlock x:Name="LosslessScalingFlowScaleValueText"
                                               Text="{Binding ElementName=LosslessScalingFlowScaleSlider, Path=Value}"
                                               FontSize="12"
                                               Foreground="#00C8FF"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LosslessScalingFlowScaleSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="25" Maximum="100"
                                        TickFrequency="5"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,12"/>

                                <!-- Size Toggle (Performance/Balanced) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption901" Text="Performance Mode" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock x:Uid="OnexCaption902" Text="Lighter model for less input lag"
                                                   FontSize="11"
                                                   Foreground="#A0A0A0"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingSizeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- LSFG2 Settings Card -->
                        <Border x:Name="LSFG2SettingsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption903" Text="LSFG2 Settings" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- LSFG2 Mode -->
                                <TextBlock x:Uid="OnexCaption904" Text="Mode" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                <ComboBox x:Uid="OnexCaption905" x:Name="LosslessScalingLSFG2ModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <x:String>X2</x:String>
                                    <x:String>X3</x:String>
                                    <x:String>X4</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Sync & Display Card (added 2026-05-01) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption906" Text="Sync &amp; Display" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- Sync Mode -->
                                <TextBlock x:Uid="OnexCaption907" Text="Sync Mode" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                <ComboBox x:Uid="OnexCaption908" x:Name="LosslessScalingSyncModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,12">
                                    <x:String>OFF</x:String>
                                    <x:String>DEFAULT</x:String>
                                    <x:String>VSYNC1</x:String>
                                    <x:String>VSYNC2</x:String>
                                    <x:String>VSYNC3</x:String>
                                    <x:String>VSYNC4</x:String>
                                </ComboBox>

                                <!-- Max Frame Latency -->
                                <Grid>
                                    <TextBlock x:Uid="OnexCaption909" Text="Max Frame Latency" FontSize="12" Foreground="#A0A0A0"/>
                                    <TextBlock x:Name="LosslessScalingMaxFrameLatencyValueText"
                                               Text="{Binding ElementName=LosslessScalingMaxFrameLatencySlider, Path=Value}"
                                               FontSize="12"
                                               Foreground="#00C8FF"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LosslessScalingMaxFrameLatencySlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0" Maximum="4"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,12"/>

                                <!-- HDR Support -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption910" Text="HDR Support" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock x:Uid="OnexCaption911" Text="Preserve HDR through scaling/FG"
                                                   FontSize="11" Foreground="#A0A0A0"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingHdrSupportToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>

                                <!-- G-Sync Support -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption912" Text="G-Sync / VRR Support" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock x:Uid="OnexCaption913" Text="Improves pacing on VRR displays"
                                                   FontSize="11" Foreground="#A0A0A0"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingGsyncSupportToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capture & Overlay Card (added 2026-05-01) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption914" Text="Capture &amp; Overlay" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- Capture API -->
                                <TextBlock x:Uid="OnexCaption915" Text="Capture API" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                <ComboBox x:Uid="OnexCaption916" x:Name="LosslessScalingCaptureApiComboBox"
                                          PlaceholderText="Select API"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,12">
                                    <x:String>DXGI</x:String>
                                    <x:String>WGC</x:String>
                                    <x:String>GDI</x:String>
                                </ComboBox>
                                <TextBlock x:Uid="OnexCaption917" Text="WGC = best compat, DXGI = lower latency, GDI = legacy"
                                           FontSize="11" Foreground="#707070" Margin="0,0,0,8"/>

                                <!-- Draw FPS overlay -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption918" Text="Draw FPS Overlay" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock x:Uid="OnexCaption919" Text="LS draws fps counter on top-left of scaled output"
                                                   FontSize="11" Foreground="#A0A0A0"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingDrawFpsToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Conflict Warning Card -->
                        <Border Style="{StaticResource CardStyle}" x:Name="LSConflictWarningBorder" Visibility="Collapsed" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption920" Text="Conflict Detected"
                                           Style="{StaticResource CardTitleStyle}"
                                           Foreground="#FFA500"/>
                                <TextBlock x:Uid="OnexCaption921" x:Name="LSConflictWarningText"
                                           Text="AMD Fluid Motion Frames has been automatically disabled because it conflicts with Lossless Scaling Frame Generation."
                                           FontSize="12"
                                           Foreground="#FFA500"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- LEGION TAB -->
                <ScrollViewer x:Name="LegionScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Virtual Controller master toggle — top of the Controller tab. Slim standalone
                             card (no expander): turns the virtual controller + mouse runtime on/off. Hidden
                             in-game and while unsupported (same gate as the other controller cards). -->
                        <Border x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" x:Name="VirtualControllerMasterCard" Style="{StaticResource CardStyle}"
                                BorderBrush="{StaticResource ThemeAccentBrush}" Visibility="Collapsed">
                            <StackPanel>
                                <!-- MSI Center M conflict warning -->
                                <Border x:Name="MsiCenterControllerWarning" Background="#2A1800" BorderBrush="#FFA500"
                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#FFA500" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <TextBlock x:Uid="OnexCaption922" Text="MSI Center M is active — controller emulation and gyro unavailable. Disable it via the MSI Center tile in the Quick Tab."
                                                   FontSize="11" Foreground="#FFA500" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Steam Xbox Extended Feature Support driver warning -->
                                <Border x:Name="SteamXboxDriverWarning" Background="#220000" BorderBrush="#FF5050"
                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="13" Foreground="#FF5050" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                        <TextBlock x:Uid="OnexCaption923" Grid.Column="1" FontSize="11" Foreground="#FF5050" TextWrapping="Wrap"
                                                   Text="Steam&#x27;s &quot;Xbox Extended Feature Support&quot; driver is active. It intercepts HID reports and prevents virtual controller emulation. Disable it in Steam → Settings → Controller → uncheck &quot;Xbox Extended Feature Support&quot;."/>
                                    </Grid>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption924" Text="Main Controller Mode" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock x:Uid="OnexCaption925" x:Name="ControllerEmulationStatusText"
                                                   Text="Main mode for all games. Hardware = native XInput + firmware remaps. Virtual = emulated pad, gyro, Mouse Mode &amp; macros. Per game: enable the Controller Profile to set the opposite mode as an exception."
                                                   FontSize="11" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- User-facing standard-mode picker. Drives the DefaultControllerMode
                                         setting; the helper derives ControllerEmulationEnabled and mirrors
                                         it back into the (now hidden) master toggle that the gating logic
                                         still reads. Each item carries a round status dot matching the
                                         Controller Status card colours: blue = Hardware, green = Virtual. -->
                                    <ComboBox x:Name="DefaultControllerModeComboBox"
                                              Grid.Column="1" MinWidth="170"
                                              VerticalAlignment="Center"
                                              IsEnabled="False">
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Width="12" Height="12" Fill="#2E9BFF" VerticalAlignment="Center"/>
                                                <TextBlock x:Uid="OnexCaption926" Text="Hardware Controller" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Width="12" Height="12" Fill="#00C853" VerticalAlignment="Center"/>
                                                <TextBlock x:Uid="OnexCaption927" Text="Virtual Controller" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                    <!-- Hidden mirror of the standard mode as a bool ("virtual pad should
                                         run"). Kept so the existing IsVirtualControllerActive gating and
                                         focus wiring stay unchanged; the helper drives its value. -->
                                    <ToggleSwitch x:Name="ControllerEmulationEnabledToggle"
                                                  Grid.Column="1" IsOn="False"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"
                                                  Visibility="Collapsed"
                                                  Toggled="ControllerEmulationEnabledToggle_Toggled"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Per-Game Controller Profile Card — same layout as the Performance tab's
                             "Per Game performance & display profile" card (ActiveProfileCard): a
                             large far-left game icon, title, then badge + detected-game text row. -->
                        <Border x:Name="OnexDeferredImportedLegionScrollViewer1" x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Game-art backdrop — see the identical block on the Performance
                                         tab's ActiveProfileCard, including the margin/radius geometry
                                         and why the veil has a 60% floor. These two must stay identical;
                                         they are the same component on two tabs. -->
                                    <Border x:Name="ControllerProfileCardArt"
                                            Grid.Column="0" Grid.ColumnSpan="3"
                                            Margin="-10" CornerRadius="4"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <ImageBrush x:Name="ControllerProfileCardArtBrush"
                                                        Stretch="UniformToFill"
                                                        AlignmentY="Center"/>
                                        </Border.Background>
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#B3101B3A" Offset="0.0"/>
                                                    <GradientStop Color="#99101B3A" Offset="0.55"/>
                                                    <GradientStop Color="#C7101B3A" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <!-- Far-left: game icon, sized to the card. Collapsed (zero width)
                                         when no game runs, so the text gets the full width. -->
                                    <Image x:Name="LegionControllerProfileGameIcon"
                                           Grid.Column="0"
                                           Width="48" Height="48"
                                           Margin="0,0,12,0"
                                           Stretch="UniformToFill"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                    <!-- Typography and spacing are kept IDENTICAL to the Performance tab's
                                         ActiveProfileCard on purpose (user, 2026-08-01): same title size
                                         and weight, same badge padding, same row margin, same caption
                                         size and colour. Do not swap these back to CardTitleStyle /
                                         CardCaptionStyle - those are 18pt bold and 14pt grey and made
                                         the two cards look like different components. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Uid="OnexCaption928" Text="Per-Game Controller Profile"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"/>
                                        <!-- Badge + detected game on one row: badge left, game status to its right. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                            <Border x:Name="ControllerProfileModeBadge"
                                                    Background="#37260C"
                                                    BorderBrush="#A06E28"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock x:Uid="OnexCaption929" x:Name="ControllerProfileModeText"
                                                           Text="Global Profile"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFAA46"/>
                                            </Border>
                                            <!-- White plate + black text, identical to the Performance
                                                 tab's DetectedGameBadge — see there for why. No marquee
                                                 here: this card has no clipped canvas and long titles
                                                 have always simply wrapped out of view. -->
                                            <Border x:Name="LegionControllerProfileGameBadge"
                                                    Background="#FFFFFF"
                                                    CornerRadius="4" Padding="8,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock x:Uid="OnexCaption930" x:Name="LegionControllerProfileGameText"
                                                           Text="No app/game detected"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#000000"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="200"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="LegionControllerProfileToggle"
                                                  Grid.Column="2"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsOn="False"
                                                  IsEnabled="False"
                                                  VerticalAlignment="Top"
                                                  Toggled="LegionControllerProfileToggle_Toggled"/>
                                </Grid>
                                <TextBlock x:Uid="OnexCaption931" x:Name="PerGameProfileHelpText"
                                           Text="Start a game to enable a per-game controller profile."
                                           Style="{StaticResource CardCaptionStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="Collapsed"/>

                                <!-- The "this game has its own controller profile …" hint was removed
                                     (user, 2026-08-01): the game art across the card now carries that
                                     message, and the badge already names the profile being edited. -->

                                <!-- Per-game capture scope: user picks which categories the per-game
                                     profile should override. Unchecked categories stay global even
                                     when the master Per-Game Controller Profile toggle is on. -->
                                <!-- Per-game capture checkboxes: hidden on MSI Claw.
                                     NintendoLayout + ButtonMappings are forced to true in code (ProfileCustomization.cs).
                                     Named controls kept for code-behind compat. -->
                                <StackPanel Visibility="Collapsed">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption932" Grid.Column="0"
                                                   Text="Customize per-game capture"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="LegionControllerProfileScopeExpandToggle"
                                                      Grid.Column="1"
                                                      IsChecked="False"
                                                      VerticalAlignment="Center"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="LegionControllerProfileScopeExpandToggle_Click">
                                            <FontIcon x:Name="LegionControllerProfileScopeExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                        </ToggleButton>
                                    </Grid>
                                    <StackPanel x:Name="LegionControllerProfileScopeContent" Margin="0,8,0,0">
                                        <CheckBox x:Uid="OnexCaption933" x:Name="ProfileSaveNintendoLayoutCheckBox"
                                                  Content="Nintendo Layout" IsChecked="True"
                                                  Checked="ProfileSettingsCheckBox_Changed"
                                                  Unchecked="ProfileSettingsCheckBox_Changed"/>
                                        <CheckBox x:Uid="OnexCaption934" x:Name="ProfileSaveVibrationCheckBox"
                                                  Content="Vibration" IsChecked="False"
                                                  Checked="ProfileSettingsCheckBox_Changed"
                                                  Unchecked="ProfileSettingsCheckBox_Changed"/>
                                        <CheckBox x:Uid="OnexCaption935" x:Name="ProfileSaveLightingCheckBox"
                                                  Content="Lighting" IsChecked="False"
                                                  Checked="ProfileSettingsCheckBox_Changed"
                                                  Unchecked="ProfileSettingsCheckBox_Changed"/>
                                        <CheckBox x:Uid="OnexCaption936" x:Name="ProfileSaveButtonMappingsCheckBox"
                                                  Content="Button Mappings" IsChecked="True"
                                                  Checked="ProfileSettingsCheckBox_Changed"
                                                  Unchecked="ProfileSettingsCheckBox_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        
                        <!-- Front Buttons Card (was "Virtual Controller & Mouse"). Keeps the same x:Names
                             (ControllerEmulationCard / *ExpandButton / *Content / *ExpandIcon) so the expand,
                             gating and code-behind wiring are unchanged. -->
                        <Border x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" x:Name="ControllerEmulationCard" Style="{StaticResource CardStyle}"
                                BorderBrush="{StaticResource ThemeAccentBrush}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEECA;" FontSize="16"
                                                      Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Uid="OnexCaption937" Text="Front Buttons" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Preview line: names what the two front buttons do, so the collapsed
                                             card still says what is configured in here. -->
                                        <TextBlock x:Uid="OnexCaption938" Text="Choose what pressing the MSI button does, and which widget the Quick Settings button jumps to."
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ControllerEmulationExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="ControllerEmulationExpandButton_Click"
                                                  XYFocusUp="{x:Bind LegionNavItem}">
                                        <FontIcon x:Name="ControllerEmulationExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <StackPanel x:Name="ControllerEmulationContent" Visibility="Collapsed" Margin="0,12,0,0">

                                <!-- ── Left MSI Button (Front) — single + double-click grouped in one card ── -->
                                <Border Background="#14FFFFFF" CornerRadius="8" Padding="12,10,12,12"
                                        BorderThickness="1" BorderBrush="#22FFFFFF" Margin="0,0,0,12">
                                  <StackPanel x:Name="LeftMsiButtonCard">
                                    <TextBlock x:Uid="OnexCaption939" Text="MSI Button" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#CCCCCC" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption940" Text="Single&#10;click" VerticalAlignment="Center"
                                                   Foreground="#AAAAAA" FontSize="12"/>
                                        <ComboBox x:Name="LegionButtonDesktopTypeComboBox" Grid.Column="1" Margin="0,0,8,0"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="1">
                                            <x:String>Keyboard</x:String>
                                            <x:String>Action</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="LegionButtonDesktopComboBox" Grid.Column="2"
                                                  Visibility="Collapsed"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Disabled</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="LegionButtonDesktopMouseComboBox" Grid.Column="2"
                                                  Visibility="Collapsed"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Left Click</x:String>
                                        </ComboBox>
                                        <ComboBox x:Uid="OnexCaption941" x:Name="LegionButtonDesktopActionComboBox" Grid.Column="2"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  PlaceholderText="Select action..."/>
                                    </Grid>
                                    <StackPanel x:Name="LegionButtonDesktopKeyboardPanel" Visibility="Visible" Margin="70,8,0,0" Orientation="Horizontal">
                                        <StackPanel x:Name="LegionButtonDesktopKeyTags" Orientation="Horizontal"/>
                                        <Button x:Uid="OnexCaption942" x:Name="LegionButtonDesktopKeyPickerButton" Width="100" Content="+ Key  ▾" Style="{StaticResource KeyPickerButtonStyle}"/>
                                    </StackPanel>

                                    <!-- divider between single- and double-click inside the card -->
                                    <Border Height="1" Background="#1AFFFFFF" Margin="0,12,0,2"/>

                                    <!-- Optional double-click action for the Left MSI button -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption943" Grid.Column="0" Text="Double-click action" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="LeftMsiDoubleClickToggle" Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Toggled="LeftMsiDoubleClickToggle_Toggled"/>
                                    </Grid>
                                    <StackPanel x:Name="LeftMsiDoubleClickPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock x:Uid="OnexCaption944" Text="Runs a second action on a quick double-press."
                                                   Foreground="#808080" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <!-- Mode selector (Keyboard / Action) — mirrors the single-click row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption945" Text="Double&#10;click" VerticalAlignment="Center"
                                                       Foreground="#AAAAAA" FontSize="12"/>
                                            <ComboBox x:Name="LeftMsiDoubleTypeComboBox" Grid.Column="1" Margin="0,0,8,0"
                                                      Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="1"
                                                      SelectionChanged="LeftMsiDoubleType_SelectionChanged">
                                                <x:String>Keyboard</x:String>
                                                <x:String>Action</x:String>
                                            </ComboBox>
                                            <ComboBox x:Uid="OnexCaption946" x:Name="LeftMsiDoubleActionComboBox" Grid.Column="2" HorizontalAlignment="Stretch"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      PlaceholderText="Select double-click action..."
                                                      SelectionChanged="LeftMsiDoubleAction_SelectionChanged"/>
                                        </Grid>
                                        <StackPanel x:Name="LeftMsiDoubleKeyboardPanel" Visibility="Collapsed" Margin="70,8,0,0" Orientation="Horizontal">
                                            <StackPanel x:Name="LeftMsiDoubleKeyTags" Orientation="Horizontal"/>
                                            <Button x:Uid="OnexCaption947" x:Name="LeftMsiDoubleKeyPickerButton" Tag="LeftMsiDouble" Width="100" Content="+ Key  ▾" Click="ExtraKeyPicker_Click" Style="{StaticResource KeyPickerButtonStyle}"/>
                                        </StackPanel>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption948" Text="Detection window" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Uid="OnexCaption949" x:Name="LeftMsiDoubleDelayValue" Grid.Column="1" Text="220 ms"
                                                       Foreground="{StaticResource SystemAccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="LeftMsiDoubleDelaySlider" Minimum="150" Maximum="600" StepFrequency="10" Value="220"
                                                ValueChanged="LeftMsiDoubleDelay_ValueChanged"/>
                                        <Border Background="#20000000" CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                                            <TextBlock x:Uid="OnexCaption950" x:Name="LeftMsiDoubleDetectText" Text="Press the Left MSI button to test…"
