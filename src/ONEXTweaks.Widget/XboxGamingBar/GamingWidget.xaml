<Border x:Name="TDPModeCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Header: title + ComboBox always visible + expand toggle -->
                                <!-- TDP Mode row hidden — only Slider/Custom mode used; ComboBox kept for code-behind compat -->
                                <Grid Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="OnexCaption256" Text="TDP Mode" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Uid="OnexCaption257" Text="Controls power and thermal profile"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="TDPModeComboBox"
                                              MinWidth="140"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              SelectedIndex="5"
                                              SelectionChanged="TDPModeComboBox_SelectionChanged"
                                              XYFocusUp="{x:Bind PerformanceOverlayComboBox}"
                                              XYFocusDown="{x:Bind TDPSlider}"
                                              XYFocusRight="{x:Bind TDPSettingsExpandButton}">
                                        <ComboBoxItem x:Uid="OnexCaption258" Content="Max (30W)"          Tag="0"/>
                                        <ComboBoxItem x:Uid="OnexCaption259" Content="Standard (25W)"     Tag="1"/>
                                        <ComboBoxItem x:Uid="OnexCaption260" Content="Balanced (17W)"     Tag="2"/>
                                        <ComboBoxItem x:Uid="OnexCaption261" Content="Battery (12W)"      Tag="3"/>
                                        <ComboBoxItem x:Uid="OnexCaption262" Content="Super Battery (8W)" Tag="4"/>
                                        <ComboBoxItem x:Uid="OnexCaption263" Content="Slider"             Tag="255"/>
                                    </ComboBox>
                                    <ToggleButton x:Name="TDPSettingsExpandButton"
                                                  Grid.Column="2"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="TDPSettingsExpandButton_Click"
                                                  XYFocusUp="{x:Bind OSDCustomizeExpandButton}"
                                                  XYFocusDown="{x:Bind TDPSlider}"
                                                  XYFocusLeft="{x:Bind TDPModeComboBox}"
                                                  UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="TDPSettingsExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible TDP Settings Content -->
                                <StackPanel x:Name="TDPSettingsContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <!-- Separator -->
                                    <Border Height="1" Background="#3A3A3A" Margin="0,16,0,16"/>

                                    <!-- Device TDP Limits Section -->
                                    <TextBlock x:Uid="OnexCaption264" Text="Device TDP Limits" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,8"/>

                                    <!-- Warning -->
                                    <Border Background="#3D2A1A" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;"
                                                       Grid.Column="0"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="#FFA500"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,8,0"/>
                                            <TextBlock x:Uid="OnexCaption265" Grid.Column="1"
                                                       Text="Increasing TDP beyond your device&#x27;s thermal limits may cause overheating or throttling."
                                                       Foreground="#FFB74D"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <!-- Minimum TDP -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Uid="OnexCaption266" Text="Minimum TDP"
                                                   FontSize="14"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="OnexCaption267" x:Name="TDPLimitsMinValue"
                                                   Text="4W"
                                                   FontSize="14"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="TDPLimitsMinSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="4" Maximum="30"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="4"
                                            ValueChanged="TDPLimitsMinSlider_ValueChanged"
                                            XYFocusUp="{x:Bind TDPSettingsExpandButton}"
                                            XYFocusDown="{x:Bind TDPLimitsMaxSlider}"
                                            />

                                    <!-- Maximum TDP -->
                                    <Grid Margin="0,12,0,8">
                                        <TextBlock x:Uid="OnexCaption268" Text="Maximum TDP"
                                                   FontSize="14"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="OnexCaption269" x:Name="TDPLimitsMaxValue"
                                                   Text="30W"
                                                   FontSize="14"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Maximum is a placeholder until the helper reports the PL1
                                         ceiling; see the note on TDPSlider. -->
                                    <Slider x:Name="TDPLimitsMaxSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="4" Maximum="100"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="30"
                                            ValueChanged="TDPLimitsMaxSlider_ValueChanged"
                                            XYFocusUp="{x:Bind TDPLimitsMinSlider}"
                                            XYFocusDown="{x:Bind TDPBoostFPPTSlider}"
                                            />

                                    <!-- Separator -->
                                    <Border Height="1" Background="#3A3A3A" Margin="0,16,0,16"/>

                                    <!-- TDP Boost Settings Section -->
                                    <TextBlock x:Uid="OnexCaption270" Text="TDP Boost Settings" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,8"/>

                                    <!-- Info -->
                                    <Border Background="#1A2A3D" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE946;"
                                                       Grid.Column="0"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="#4CAF50"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,8,0"/>
                                            <TextBlock x:Uid="OnexCaption271" Grid.Column="1"
                                                       Text="Sets PL2 (boost limit) directly to the chosen wattage. Must be higher than PL1 — automatically raised to PL1+1W if set too low."
                                                       Foreground="#A0D4A0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <!-- PL2-Boost -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Uid="OnexCaption272" Text="PL2-Boost"
                                                   FontSize="14"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="OnexCaption273" x:Name="TDPBoostFPPTValue"
                                                   Text="3W"
                                                   FontSize="14"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Maximum is a placeholder until the helper reports the PL2
                                         ceiling; see the note on TDPSlider. -->
                                    <Slider x:Name="TDPBoostFPPTSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="10" Maximum="100"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            ValueChanged="TDPBoostFPPTSlider_ValueChanged"
                                            XYFocusUp="{x:Bind TDPLimitsMaxSlider}"
                                            XYFocusDown="{x:Bind UseCustomTDPPresetsToggle}"
                                            />

                                    <!-- Separator -->
                                    <Border Height="1" Background="#3A3A3A" Margin="0,16,0,16"/>

                                    <!-- Custom TDP Presets Section -->
                                    <TextBlock x:Uid="OnexCaption274" Text="Custom TDP Presets" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,8"/>

                                    <!-- Use Custom Presets Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption275" Text="Use Custom Presets" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock x:Uid="OnexCaption276" Text="Override default TDP values for modes"
                                                       FontSize="11" Foreground="{StaticResource HintTextBrush}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="UseCustomTDPPresetsToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Toggled="UseCustomTDPPresetsToggle_Toggled"
                                                      XYFocusUp="{x:Bind TDPBoostFPPTSlider}"/>
                                    </Grid>

                                    <!-- Presets List (shown when custom presets enabled) -->
                                    <StackPanel x:Name="TDPPresetsListPanel" Spacing="8" Visibility="Collapsed" Margin="0,12,0,0">
                                        <!-- Use Lenovo Modes checkbox (Legion devices only) -->
                                        <Grid x:Name="UseLenovoModesPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption277" Text="Use Lenovo Modes" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock x:Uid="OnexCaption278" Text="Use hardware modes for Quiet/Balanced/Performance"
                                                           FontSize="11" Foreground="{StaticResource HintTextBrush}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="UseLenovoModesToggle"
                                                          Grid.Column="1"
                                                          IsOn="True"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          Toggled="UseLenovoModesToggle_Toggled"/>
                                        </Grid>
                                        <!-- Preset items will be dynamically generated -->
                                        <ItemsControl x:Name="TDPPresetsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TdpWatts}"
                                                                       FontSize="14"
                                                                       Foreground="#4CAF50"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock x:Uid="OnexCaption279" Text="W"
                                                                       FontSize="14"
                                                                       Foreground="#4CAF50"
                                                                       FontWeight="SemiBold"
                                                                       Margin="2,0,0,0"/>
                                                        </StackPanel>
                                                        <Button x:Uid="OnexCaption280" Grid.Column="2"
                                                                Content="Edit"
                                                                FontSize="12"
                                                                Padding="8,4"
                                                                Margin="4,0"
                                                                Background="#2A2A2A"
                                                                Foreground="#FFFFFF"
                                                                Click="TDPPresetEditButton_Click"
                                                                Tag="{Binding}"/>
                                                        <Button Grid.Column="3"
                                                                FontSize="12"
                                                                Padding="8,4"
                                                                Background="#2A2A2A"
                                                                Click="TDPPresetDeleteButton_Click"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF6B6B"/>
                                                        </Button>
                                                        <TextBlock x:Uid="OnexCaption281" Grid.Column="3"
                                                                   Text="Default"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource HintTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0"
                                                                   Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add Preset Section -->
                                        <Border Background="#1A1A1A" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="OnexCaption282" Text="Add New Preset" FontSize="13" Foreground="#A0A0A0"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Uid="OnexCaption283" x:Name="NewPresetNameTextBox"
                                                             Grid.Column="0"
                                                             PlaceholderText="Preset name"
                                                             FontSize="13"
                                                             Padding="8,6"
                                                             Margin="0,0,8,0"/>
                                                    <muxc:NumberBox x:Name="NewPresetTDPNumberBox"
                                                               Grid.Column="1"
                                                               Value="30"
                                                               Minimum="4"
                                                               Maximum="100"
                                                               SpinButtonPlacementMode="Compact"
                                                               FontSize="13"/>
                                                </Grid>
                                                <CheckBox x:Uid="OnexCaption284" x:Name="NewPresetTDPBoostCheckBox"
                                                          Content="Enable TDP Boost"
                                                          FontSize="13"
                                                          Foreground="#FFFFFF"/>
                                                <Button x:Uid="OnexCaption285" x:Name="AddPresetButton"
                                                        Content="Add Preset"
                                                        FontSize="13"
                                                        Padding="16,6"
                                                        HorizontalAlignment="Left"
                                                        Background="#4CAF50"
                                                        Foreground="#FFFFFF"
                                                        Click="AddPresetButton_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reset to Defaults Button -->
                                        <Button x:Uid="OnexCaption286" x:Name="ResetTDPPresetsButton"
                                                Content="Reset to Defaults"
                                                FontSize="12"
                                                Padding="12,6"
                                                HorizontalAlignment="Left"
                                                Background="#2A2A2A"
                                                Foreground="#A0A0A0"
                                                Click="ResetTDPPresetsButton_Click"/>
                                    </StackPanel>

                                    <!-- Edit Preset Dialog (inline, hidden by default) -->
                                    <Border x:Name="EditPresetDialog"
                                            Background="#252525"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,12,0,0"
                                            Visibility="Collapsed">
                                        <StackPanel Spacing="12">
                                            <TextBlock x:Uid="OnexCaption287" Text="Edit Preset" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption288" Grid.Column="0" Text="Name:" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="EditPresetNameTextBox"
                                                         Grid.Column="1"
                                                         FontSize="13"
                                                         Padding="8,6"/>
                                            </Grid>
                                            <Grid x:Name="EditPresetTDPPanel">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption289" Grid.Column="0" Text="TDP (W):" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                                <muxc:NumberBox x:Name="EditPresetTDPNumberBox"
                                                           Grid.Column="1"
                                                           Minimum="4"
                                                           Maximum="100"
                                                           SpinButtonPlacementMode="Compact"
                                                           FontSize="13"/>
                                            </Grid>
                                            <Grid x:Name="EditPresetTDPBoostPanel">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="OnexCaption290" Grid.Column="0" Text="TDP Boost:" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                                <CheckBox x:Uid="OnexCaption291" x:Name="EditPresetTDPBoostCheckBox"
                                                          Grid.Column="1"
                                                          Content="Enable TDP Boost"
                                                          FontSize="13"
                                                          Foreground="#FFFFFF"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button x:Uid="OnexCaption292" Content="Cancel"
                                                        FontSize="13"
                                                        Padding="16,6"
                                                        Background="#2A2A2A"
                                                        Foreground="#A0A0A0"
                                                        Click="EditPresetCancelButton_Click"/>
                                                <Button x:Uid="OnexCaption293" Content="Save"
                                                        FontSize="13"
                                                        Padding="16,6"
                                                        Background="#4CAF50"
                                                        Foreground="#FFFFFF"
                                                        Click="EditPresetSaveButton_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
