                                    </Grid>
                                </ToggleButton>

                                <!-- Collapsible content: sort dropdown + the dynamically built profile cards -->
                                <StackPanel x:Name="PerfSavedProfilesContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption440" Text="Sort by" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        <!--
                                            Sort dropdown for the saved-profiles list. Selection is
                                            persisted to LocalSettings["ProfileSortMode"] so it
                                            survives across widget re-opens. Tags are read by the
                                            C# code-behind in UpdateAllGameProfilesDisplay to drive ordering.
                                        -->
                                        <ComboBox x:Name="ProfileSortComboBox"
                                                  Grid.Column="1"
                                                  Width="150"
                                                  SelectionChanged="ProfileSortComboBox_SelectionChanged"
                                                  KeyDown="ProfileSortComboBox_KeyDown"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="OnexCaption441" Tag="name" Content="Name (A→Z)" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="OnexCaption442" Tag="modified" Content="Last Modified"/>
                                            <ComboBoxItem x:Uid="OnexCaption443" Tag="tdp" Content="TDP (high → low)"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Container for dynamically created game profile cards.
                                         XYFocusKeyboardNavigation=Enabled is required for the D-pad to
                                         enter code-created content at all — see the expander pattern
                                         used by the other collapsible sections. -->
                                    <StackPanel x:Name="AllGameProfilesContainer"
                                                XYFocusKeyboardNavigation="Enabled"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
<Border x:Name="PowerSourceProfileCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE83F;" FontSize="16" Margin="0,0,8,0"
                                                  Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- No icons in this heading: the plug and battery marks belong
                                                 where a single power state is NAMED (badges, split columns).
                                                 Here both states are named in one sentence, so the icons only
                                                 broke the line up. The "Off means ..." caption is gone as well
                                                 - the switch is labelled Split, and off is the absence of it. -->
                                            <TextBlock x:Uid="OnexCaption444" Text="Use extra profile for battery and plugged in sessions"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Reachable by D-pad through the explicit KeyDown chain in
                                         GamingWidget.CpuAdvanced.cs, not through XYFocus hints: the two
                                         neighbouring cards route their Up/Down there too, and mixing the
                                         two mechanisms is what left this toggle unreachable (its XYFocusUp
                                         pointed at the nav rail while the card above jumped straight past
                                         it to Profile Settings). -->
                                    <ToggleSwitch x:Name="PowerSourceProfileToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}" Width="47"
                                                  KeyDown="PowerSourceProfileToggle_KeyDown"/>
                                </Grid>
                                <!-- Indented so it reads as a note ABOUT the setting above rather than
                                     as a second setting of its own. -->
                                <TextBlock x:Uid="OnexCaption445" x:Name="PowerSourceProfileScopeText"
                                           Margin="16,8,0,0"
                                           FontSize="11"
                                           Foreground="#AAAAAA"
                                           TextWrapping="Wrap"
                                           Text="Scope: Global profile"/>
                            </StackPanel>
                        </Border>
</StackPanel>
                </ScrollViewer>

                <!-- GAME TAB -->
                <ScrollViewer x:Name="GameScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Profiles content moved into the Performance tab. This tab is hidden (see TabSettings) and kept as an empty template for a future tab. -->

                        <!-- Hidden legacy elements from the removed "Current Game" card. Retained (Collapsed)
                             so the existing code-behind that updates them still compiles; the live
                             "current game" display is now the ActiveProfileCard at the top of the Performance tab. -->
                        <Image     x:Name="CurrentGameIcon"          Visibility="Collapsed" IsHitTestVisible="False"/>
                        <TextBlock x:Uid="OnexCaption446" x:Name="RunningGameText"          Visibility="Collapsed" Text="No game detected"/>
                        <TextBlock x:Name="CurrentGameProfileStatus" Visibility="Collapsed"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- ONBOARDING / SETUP TAB -->
                <ScrollViewer x:Name="OnboardingScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16"
                                XYFocusKeyboardNavigation="Enabled">
                        <!-- App version & updates — collapsible, at the very top. Lists the latest and
                             previous release so the user can jump forward or roll back. -->
                        <muxc:Expander x:Name="AppUpdateExpander" Margin="0,0,0,10"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                       CornerRadius="8"
                                       IsExpanded="False" Expanding="AppUpdateExpander_Expanding">
                            <!-- Accent frame around the whole expander (header + content), collapsed and expanded. -->
                            <muxc:Expander.Resources>
                                <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="ThemeAccentBrush"/>
                                <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="ThemeAccentBrush"/>
                                <Thickness x:Key="ExpanderHeaderBorderThickness">1</Thickness>
                                <Thickness x:Key="ExpanderContentDownBorderThickness">1</Thickness>
                            </muxc:Expander.Resources>
                            <muxc:Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="#5B8DEF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="OnexCaption447" Text="App version &amp; updates" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </muxc:Expander.Header>
                            <StackPanel>
                                <!-- Version line + small refresh icon (clearly distinct from the Download &amp; install action) -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption448" x:Name="AppUpdateCurrentVersionText" Grid.Column="0" Text="Installed version: …"
                                               FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button x:Uid="OnexCaption449" x:Name="AppUpdateRefreshBtn" Grid.Column="1" Click="AppUpdateRefresh_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6" Width="34" Height="34"
                                            VerticalAlignment="Top" ToolTipService.ToolTip="Reload releases">
                                        <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#5B8DEF"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="OnexCaption450" Text="Only versions newer than yours are shown (no downgrades). Experimental test builds are flagged. The signed helper downloads and runs the installer — a PowerShell window shows the progress."
                                           FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Release cards (each with a Download &amp; install button) — directly below the header
                                     so the install action sits near the top. Built in code-behind (GamingWidget.AppUpdate.cs). -->
                                <StackPanel x:Name="AppReleasesContainer"/>

                                <!-- Spinner + status: directly under the cards so progress is visible right where you tapped install -->
                                <Border x:Name="AppUpdateProgressPanel" Visibility="Collapsed"
                                        Background="#1A1A2E" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing x:Name="AppUpdateSpinner" Grid.Column="0" IsActive="False" Width="22" Height="22"
                                                      Foreground="#5B8DEF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="AppUpdateStatusText" Grid.Column="1" Text="" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#E6E6E6" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </muxc:Expander>

                        <muxc:Expander x:Name="SetupExpander"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       CornerRadius="8"
                                       IsExpanded="False">
                            <muxc:Expander.Resources>
                                <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="ThemeAccentBrush"/>
                                <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="ThemeAccentBrush"/>
                                <Thickness x:Key="ExpanderHeaderBorderThickness">1</Thickness>
                                <Thickness x:Key="ExpanderContentDownBorderThickness">1</Thickness>
                            </muxc:Expander.Resources>
                            <muxc:Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D7;" FontSize="14" Foreground="#5B8DEF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="OnexCaption451" Text="Setup &amp; Onboarding" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </muxc:Expander.Header>
                            <StackPanel>
                        <TextBlock x:Uid="OnexCaption452" Text="ONEXTweaks needs a few small tools. One click checks what&#x27;s present and installs anything missing."
                                   FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- Step 1: Required tools — one button runs the proven check/installer for all four -->
                        <Border Background="#1A1A2E" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption453" Text="1. Required tools" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Uid="OnexCaption454" Text="Install the missing ones with CTW Center — it links to each vendor&#x27;s own installer. This page only shows what is already there."
                                           FontSize="10" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <!-- Backend-switch notice (replaces the old usbip blurb): shown as a headline and
                                     blinking accent so the move off the discontinued ViGEm backend is unmissable. -->
                                <TextBlock x:Uid="OnexCaption455" x:Name="OnbBackendBlink" Loaded="OnbBackendBlink_Loaded"
                                           Text="We&#x27;re switching from the discontinued ViGEm to VIIPER (USBIP)"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#5B8DEF"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>

                                <!-- usbip-win2 FIRST: VIIPER backend driver. The button re-checks; installing it
                                     is CTW Center's job (see ViGEmBusHelper.Install on why the helper stopped). -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption456" x:Name="OnbUsbipStatus" Text="usbip-win2: Checking..." FontSize="11" Foreground="{StaticResource HintTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Uid="OnexCaption457" x:Name="OnbUsbipInstallBtn" Grid.Column="1" Content="Re-check"
                                            Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                            Click="OnbUsbipInstall_Click"/>
                                </Grid>
                                <TextBlock x:Uid="OnexCaption458" Text="USB/IP kernel driver powering the default VIIPER controller emulation (button remapping, gyro-as-stick, Mouse Mode). Install it through CTW Center, then reboot once."
                                           FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,1,0,8"/>

                                <Border Background="#15151F" BorderBrush="#33333F" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock x:Uid="OnexCaption459" Text="These are checked together. „Re-check tools“ asks again after you installed something."
                                                   FontSize="10" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                        <!-- Read-only per-tool status (refreshed after the run) + what each tool does -->
                                        <TextBlock x:Uid="OnexCaption460" x:Name="OnbHidHideStatus" Text="HidHide: Checking..."  FontSize="11" Foreground="{StaticResource HintTextBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Uid="OnexCaption461" Text="Hides the Claw&#x27;s built-in controller while emulation runs, so games see only the virtual pad — prevents double input."
                                                   FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,1,0,0"/>

                                        <TextBlock x:Uid="OnexCaption462" x:Name="OnbRtssStatus"    Text="RTSS: Checking..."     FontSize="11" Foreground="{StaticResource HintTextBrush}" Margin="0,8,0,0"/>
                                        <TextBlock x:Uid="OnexCaption463" Text="RivaTuner Statistics Server. Draws the on-screen overlay (FPS, TDP, temps) and enforces the FPS limiter."
                                                   FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,1,0,0"/>

                                        <TextBlock x:Uid="OnexCaption464" x:Name="OnbPawnIOStatus"  Text="PawnIO: Checking..."   FontSize="11" Foreground="{StaticResource HintTextBrush}" Margin="0,8,0,0"/>
                                        <TextBlock x:Uid="OnexCaption465" Text="Kernel sensor driver. Exposes CPU/GPU power and temperature to the overlay — without it the power readout stays at 0 W."
                                                   FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,1,0,0"/>

                                        <!-- Re-detect every tool and refresh the rows above. -->
                                        <Button x:Uid="OnexCaption466" x:Name="OnbRunSetupBtn" Content="Re-check tools"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Style="{StaticResource ModernButtonStyle}" FontSize="13" Padding="10,8" Margin="0,12,0,0"
                                                Click="OnbRunSetup_Click"/>
                                        <!-- Live progress: spinner + text while the setup runs in the background -->
                                        <StackPanel x:Name="OnbSetupProgressPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                            <ProgressRing x:Name="OnbSetupSpinner" IsActive="False" Width="16" Height="16"
                                                          Foreground="#5B8DEF" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                            <TextBlock x:Name="OnbSetupProgress" Text="" FontSize="11" Foreground="#AAAAAA"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Uid="OnexCaption467" Text="HidHide, RTSS and PawnIO are official, signed third-party tools installed via winget; usbip-win2 is the signed vendor driver, downloaded on demand. Individual install / download buttons live under System → Debug → Driver dependencies."
                                           FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: MSI Center M -->
                        <Border Background="#1A1A2E" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption468" Text="2. Disable MSI Center M" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption469" x:Name="OnbMsiCenterStatus" Text="Checking MSI Center M..." FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Uid="OnexCaption470" x:Name="OnbMsiCenterBtn" Grid.Column="1" Content="Disable" IsEnabled="False" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4" Click="OnbMsiCenterDisable_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: Controller emulation -->
                        <Border Background="#1A1A2E" CornerRadius="6" Padding="12" Margin="0,8,0,16">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption471" Text="3. Enable controller emulation" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption472" x:Name="OnbEmulationStatus" Text="Controller emulation: off" FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Uid="OnexCaption473" x:Name="OnbEmulationBtn" Grid.Column="1" Content="Enable" IsEnabled="False" Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4" Click="OnbEmulationEnable_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Optional (below step 3): Left MSI single-click setup — links to the Controls tab
                             (the combo group there is too coupled to safely duplicate). -->
                        <Border Background="#1A1A2E" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption474" Text="Set up Left MSI (Claw) button" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Uid="OnexCaption475" Text="Assign a single-click action to the Left MSI (front) button — e.g. open the Steam menu. Opens the full setup in the Controls tab."
                                           FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <Button x:Uid="OnexCaption476" x:Name="OnbSetupLeftMsiBtn" Content="Set up Left MSI button →"
                                        Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                        Click="OnbSetupLeftMsi_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Optional (below step 3): Auto-Jump position — mirror of the Controls-tab slider
                             (same handler ClawTweaksWidgetPosition_ValueChanged, kept in sync both ways). -->
                        <Border Background="#1A1A2E" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption477" Text="Auto Jump to Clawtweaks on Gamebar Open" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Uid="OnexCaption478" Text="The Right MSI button opens Game Bar (its press action is unchanged). When controller emulation is active, ONEXTweaks then auto-jumps to its widget slot on open. Set this to ONEXTweaks&#x27; actual position (usually #3 — Microsoft occupies the first two)."
                                           FontSize="11" Foreground="{StaticResource HintTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="OnexCaption479" Text="ONEXTweaks widget position" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OnbClawTweaksWidgetPositionValue" Grid.Column="1" Text="1"
                                               Foreground="{StaticResource SystemAccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="OnbClawTweaksWidgetPositionSlider" Minimum="1" Maximum="10" StepFrequency="1" Value="1"
                                        ValueChanged="ClawTweaksWidgetPosition_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Legacy (ViGEm) — the old emulation backend, only relevant if you switch off VIIPER.
                             Not needed by default and does NOT gate onboarding while VIIPER is active. -->
                        <Border Background="#15151F" BorderBrush="#33333F" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption480" Text="Legacy (ViGEm)" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                                <TextBlock x:Uid="OnexCaption481" Text="ViGEmBus is the old controller-emulation driver. The default backend is now VIIPER (usbip-win2), so ViGEm is optional — only install it if you switch the backend to Legacy under System → Debug. It does not affect onboarding completion while VIIPER is active."
                                           FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <TextBlock x:Uid="OnexCaption482" x:Name="OnbViGEmStatus" Text="ViGEmBus: Checking..." FontSize="11" Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </muxc:Expander>

                        <!-- Offboarding — install or remove individual tools, collapsed by default -->
                        <muxc:Expander x:Name="OffboardingExpander"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       CornerRadius="8"
                                       IsExpanded="False">
                            <muxc:Expander.Resources>
                                <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="ThemeAccentBrush"/>
                                <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="ThemeAccentBrush"/>
                                <Thickness x:Key="ExpanderHeaderBorderThickness">1</Thickness>
                                <Thickness x:Key="ExpanderContentDownBorderThickness">1</Thickness>
                            </muxc:Expander.Resources>
                            <muxc:Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14" Foreground="#CC6644" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="OnexCaption483" Text="Offboarding" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </muxc:Expander.Header>
                            <StackPanel>
                                <TextBlock x:Uid="OnexCaption484" Text="Remove individual tools. Each row shows the current status and lets you uninstall independently."
                                           FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Border Background="#1A1A2E" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <!-- usbip-win2 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption485" x:Name="DebugUsbipStatusText" Text="usbip-win2: Checking..."
                                                       FontSize="11" Foreground="{StaticResource HintTextBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                                                <Button x:Uid="OnexCaption486" x:Name="DebugUsbipInstallButton" Content="Install usbip-win2"
                                                        Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                                        Click="DebugUsbipInstall_Click" Visibility="Collapsed"/>
                                                <Button x:Uid="OnexCaption487" x:Name="DebugUsbipUninstallButton" Content="Uninstall" IsEnabled="False"
                                                        Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                                        Click="DebugUsbipUninstall_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Uid="OnexCaption488" Text="USB/IP kernel driver for VIIPER controller emulation."
                                                   FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                        <!-- ViGEmBus -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption489" x:Name="ControllerEmulationViGEmBusStatusText" Text="ViGEmBus: Checking..."
                                                       FontSize="11" Foreground="{StaticResource HintTextBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                                                <Button x:Uid="OnexCaption490" x:Name="ControllerEmulationViGEmBusInstallButton" Content="Install ViGEmBus"
                                                        Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                                        Click="ViGEmBusInstallButton_Click" Visibility="Collapsed"/>
                                                <Button x:Uid="OnexCaption491" x:Name="ControllerEmulationViGEmBusUninstallButton" Content="Uninstall" IsEnabled="False"
                                                        Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="10,4"
                                                        Click="ViGEmBusUninstallButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Uid="OnexCaption492" Text="Legacy controller emulation driver. Only needed when the VIIPER backend is off."
                                                   FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                        <!-- HidHide -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption493" x:Name="ControllerEmulationHidHideStatusText" Text="HidHide: Checking..."
