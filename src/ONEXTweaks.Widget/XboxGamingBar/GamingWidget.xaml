                                                              Grid.Column="1" Width="160"
                                                              SelectionChanged="ViiperStickGyroSelectComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="OnexCaption1142" Content="Left" Tag="0"/>
                                                        <ComboBoxItem x:Uid="OnexCaption1143" Content="Right" Tag="1" IsSelected="True"/>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- 3DOF to 2D conversion -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1144" Text="3DOF to 2D conversion" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1145" Text="Which gyro axes drive the stick. Yaw = look L/R, Roll = tilt L/R, Yaw+Roll = both." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ComboBox x:Name="ViiperStickGyroConversionComboBox"
                                                              Grid.Column="1" Width="160"
                                                              SelectionChanged="ViiperStickGyroConversionComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="OnexCaption1146" Content="Yaw" Tag="0"/>
                                                        <ComboBoxItem x:Uid="OnexCaption1147" Content="Roll" Tag="1"/>
                                                        <ComboBoxItem x:Uid="OnexCaption1148" Content="Yaw + Roll" Tag="2" IsSelected="True"/>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- Gyro orientation -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1149" Text="Gyro orientation" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1150" Text="Handheld posture. Switch to Orthogonal if your IMU axes feel rotated 90°." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ComboBox x:Name="ViiperStickGyroOrientationComboBox"
                                                              Grid.Column="1" Width="160"
                                                              SelectionChanged="ViiperStickGyroOrientationComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="OnexCaption1151" Content="Parallel" Tag="0" IsSelected="True"/>
                                                        <ComboBoxItem x:Uid="OnexCaption1152" Content="Orthogonal" Tag="1"/>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- Invert toggles -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="OnexCaption1153" Text="Invert X output" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                                                    <ToggleSwitch x:Name="ViiperStickGyroInvertXToggle"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource ModernToggleStyle}"
                                                                  Toggled="ViiperStickGyroInvertXToggle_Toggled"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="OnexCaption1154" Text="Invert Y output" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                                                    <ToggleSwitch x:Name="ViiperStickGyroInvertYToggle"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource ModernToggleStyle}"
                                                                  Toggled="ViiperStickGyroInvertYToggle_Toggled"/>
                                                </Grid>

                                                <!-- Min gyro input speed -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1155" Text="Min gyro input speed" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1156" Text="Ignore motion below this speed (filters drift / micro-shake)." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Uid="OnexCaption1157" x:Name="ViiperStickGyroMinGyroSpeedValueText" Grid.Column="1" VerticalAlignment="Center" Text="0°/s" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroMinGyroSpeedSlider"
                                                        Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroMinGyroSpeedSlider_ValueChanged"/>

                                                <!-- Max gyro input speed -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1158" Text="Max gyro input speed" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1159" Text="Speed at which the stick reaches full deflection." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Uid="OnexCaption1160" x:Name="ViiperStickGyroMaxGyroSpeedValueText" Grid.Column="1" VerticalAlignment="Center" Text="220°/s" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroMaxGyroSpeedSlider"
                                                        Minimum="50" Maximum="720" StepFrequency="1" SmallChange="5" LargeChange="50"
                                                        ValueChanged="ViiperStickGyroMaxGyroSpeedSlider_ValueChanged"/>

                                                <!-- Min joystick output -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1161" Text="Min joystick output" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1162" Text="Anti-deadzone: minimum stick magnitude when any motion is detected." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ViiperStickGyroMinOutputValueText" Grid.Column="1" VerticalAlignment="Center" Text="0%" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroMinOutputSlider"
                                                        Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroMinOutputSlider_ValueChanged"/>

                                                <!-- Max joystick output -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1163" Text="Max joystick output" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1164" Text="Cap the synthesized stick magnitude. Lower for slower, calmer aim." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ViiperStickGyroMaxOutputValueText" Grid.Column="1" VerticalAlignment="Center" Text="100%" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroMaxOutputSlider"
                                                        Minimum="1" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroMaxOutputSlider_ValueChanged"/>

                                                <!-- Power curve -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1165" Text="Power curve" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1166" Text="0.1 = aggressive (small motion → big stick), 1.0 = linear, 4.0 = relaxed." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ViiperStickGyroPowerCurveValueText" Grid.Column="1" VerticalAlignment="Center" Text="1.0" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroPowerCurveSlider"
                                                        Minimum="10" Maximum="400" StepFrequency="1" SmallChange="5" LargeChange="25"
                                                        ValueChanged="ViiperStickGyroPowerCurveSlider_ValueChanged"/>

                                                <!-- Precision speed -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1167" Text="Precision speed" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1168" Text="Slow-tilt damping. 0 = off." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Uid="OnexCaption1169" x:Name="ViiperStickGyroPrecisionSpeedValueText" Grid.Column="1" VerticalAlignment="Center" Text="Off" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroPrecisionSpeedSlider"
                                                        Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroPrecisionSpeedSlider_ValueChanged"/>

                                                <!-- Output mix -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="OnexCaption1170" Text="Output mix" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock x:Uid="OnexCaption1171" Text="Negative bias = vertical, positive = horizontal, 0 = balanced." FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Uid="OnexCaption1172" x:Name="ViiperStickGyroOutputMixValueText" Grid.Column="1" VerticalAlignment="Center" Text="Balanced" FontSize="12" Foreground="{StaticResource HintTextBrush}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroOutputMixSlider"
                                                        Minimum="-100" Maximum="100" StepFrequency="1" SmallChange="5" LargeChange="25"
                                                        ValueChanged="ViiperStickGyroOutputMixSlider_ValueChanged"/>

                                                <!-- Reset to vvalente30's recommended SteamOS-aligned defaults. Each
                                                     value mirrors over to the legacy CE control via the existing
                                                     property pipe path; no separate save logic. -->
                                                <Button x:Uid="OnexCaption1173" x:Name="ViiperStickGyroResetButton"
                                                        Content="Reset to recommended defaults"
                                                        Margin="0,12,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Click="ViiperStickGyroResetButton_Click"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock x:Uid="OnexCaption1174" Text="Guide/Mode button" FontSize="12" Foreground="#CCCCCC" Margin="0,12,0,4"/>
                                        <ComboBox x:Name="ViiperGuideButtonModeComboBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem x:Uid="OnexCaption1175" Content="Native (emulated device Guide/PS)" Tag="Native"/>
                                            <ComboBoxItem x:Uid="OnexCaption1176" Content="Open Xbox Game Bar (Win+G)" Tag="GameBar"/>
                                        </ComboBox>
                                        <TextBlock x:Uid="OnexCaption1177" x:Name="ViiperLegionLDisabledHint"
                                                   Text="Legion L is disabled in Special Remapping — set it to &quot;Guide&quot; to route the Xbox button through the emulated device."
                                                   FontSize="11"
                                                   Foreground="#FFB060"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="Collapsed"/>

                                        <!-- Swap rumble motors -->
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="OnexCaption1178" Text="Swap rumble motors"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="#CCCCCC"/>
                                            <ToggleSwitch x:Name="ViiperSwapRumbleMotorsToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"/>
                                        </Grid>

                                        <!-- Mirror emulated lightbar (DS4 / DualSense Edge) onto Legion stick lights -->
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Uid="OnexCaption1179" Text="Mirror emulated lightbar to stick lights"
                                                           FontSize="13"
                                                           Foreground="#CCCCCC"/>
                                                <TextBlock x:Uid="OnexCaption1180" Text="DualShock 4 / DualSense Edge only — when on, game-driven LED color overrides the picker color you chose for the Legion Go sticks. Off keeps your saved stick color."
                                                           FontSize="11"
                                                           Foreground="{StaticResource HintTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="ViiperMirrorLightbarToStickToggle"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"/>
                                        </Grid>

                                        <!-- Rumble intensity -->
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid>
                                                <TextBlock x:Uid="OnexCaption1181" Text="Rumble intensity" FontSize="13" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="ViiperRumbleIntensityValue"
                                                           Text="100%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="ViiperRumbleIntensitySlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="200"
                                                    Value="100"
                                                    StepFrequency="5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        </Border>


                        <!-- Mouse Settings Card (collapsible; the Mouse Mode emulation options moved out of the
                             former "Virtual Controller & Mouse" card). Hidden in-game + gated when the virtual
                             controller is inactive, like the other controller cards. -->
                        <Border x:Load="{x:Bind LoadImportedDeviceUi, Mode=OneTime}" x:Name="MouseSettingsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE962;" FontSize="16"
                                                      Foreground="{StaticResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Uid="OnexCaption1182" Text="Mouse Settings" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Uid="OnexCaption1183" Text="Mouse Mode sensitivity, buttons and sticks" Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="MouseSettingsExpandToggle" Grid.Column="1" IsChecked="False"
                                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                  Padding="8,4" Click="MouseSettingsExpandToggle_Click">
                                        <FontIcon x:Name="MouseSettingsExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="MouseSettingsContent" Visibility="Collapsed" Margin="0,12,0,0">
                                <!-- Mouse Emulation Settings -->
                                <StackPanel x:Name="ControllerEmulationMouseSettingsPanel" Margin="0,16,0,0" Visibility="Visible">
                                <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Uid="OnexCaption1184" Text="Mouse Emulation" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Uid="OnexCaption1185" Text="Fine-tune mouse behavior"
                                               Style="{StaticResource CardCaptionStyle}"
                                               Margin="0,0,0,6"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1186" Text="Sensitivity" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ControllerEmulationMouseSensitivityValue"
                                                   Grid.Column="1"
                                                   Text="100"
                                                   FontSize="13"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="ControllerEmulationMouseSensitivitySlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="400"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="100"
                                            IsEnabled="False"
                                            XYFocusUp="{x:Bind MouseSettingsExpandToggle}"
                                            ValueChanged="ControllerEmulationMouseSensitivitySlider_ValueChanged"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="OnexCaption1187" Text="Threshold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ControllerEmulationMouseThresholdValue"
                                                   Grid.Column="1"
                                                   Text="2"
                                                   FontSize="13"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="ControllerEmulationMouseThresholdSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="20"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="2"
                                            IsEnabled="False"
                                            ValueChanged="ControllerEmulationMouseThresholdSlider_ValueChanged"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Uid="OnexCaption1188" Text="Acceleration" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock x:Uid="OnexCaption1189" Text="0 = off (linear). Held deflection ramps up speed over time."
                                                       FontSize="11"
                                                       Foreground="{StaticResource HintTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ControllerEmulationMouseAccelerationValue"
                                                   Grid.Column="1"
                                                   Text="0"
                                                   FontSize="13"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="ControllerEmulationMouseAccelerationSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="0"
                                            IsEnabled="False"
                                            ValueChanged="ControllerEmulationMouseAccelerationSlider_ValueChanged"/>

                                    <!-- Mouse Mode Button Mapping -->
                                    <TextBlock x:Uid="OnexCaption1190" Text="Button Mapping" FontSize="13" Foreground="#FFFFFF" Margin="0,14,0,4"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption1191" Text="Left Click" FontSize="13" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ControllerEmulationMouseLeftClickButtonComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  IsEnabled="False">
                                            <ComboBoxItem x:Uid="OnexCaption1192" Content="None"  Tag="0"/>
                                            <ComboBoxItem x:Uid="OnexCaption1193" Content="A"     Tag="1"/>
                                            <ComboBoxItem x:Uid="OnexCaption1194" Content="B"     Tag="2"/>
                                            <ComboBoxItem x:Uid="OnexCaption1195" Content="X"     Tag="3"/>
                                            <ComboBoxItem x:Uid="OnexCaption1196" Content="Y"     Tag="4"/>
                                            <ComboBoxItem x:Uid="OnexCaption1197" Content="LB"    Tag="5"/>
                                            <ComboBoxItem x:Uid="OnexCaption1198" Content="RB"    Tag="6"/>
                                            <ComboBoxItem x:Uid="OnexCaption1199" Content="LS"    Tag="7"/>
                                            <ComboBoxItem x:Uid="OnexCaption1200" Content="RS"    Tag="8"/>
                                            <ComboBoxItem x:Uid="OnexCaption1201" Content="LT"    Tag="9"/>
                                            <ComboBoxItem x:Uid="OnexCaption1202" Content="RT"    Tag="10" IsSelected="True"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption1203" Text="Right Click" FontSize="13" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ControllerEmulationMouseRightClickButtonComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  IsEnabled="False">
                                            <ComboBoxItem x:Uid="OnexCaption1204" Content="None"  Tag="0"/>
                                            <ComboBoxItem x:Uid="OnexCaption1205" Content="A"     Tag="1"/>
                                            <ComboBoxItem x:Uid="OnexCaption1206" Content="B"     Tag="2"/>
                                            <ComboBoxItem x:Uid="OnexCaption1207" Content="X"     Tag="3"/>
                                            <ComboBoxItem x:Uid="OnexCaption1208" Content="Y"     Tag="4"/>
                                            <ComboBoxItem x:Uid="OnexCaption1209" Content="LB"    Tag="5"/>
                                            <ComboBoxItem x:Uid="OnexCaption1210" Content="RB"    Tag="6"/>
                                            <ComboBoxItem x:Uid="OnexCaption1211" Content="LS"    Tag="7"/>
                                            <ComboBoxItem x:Uid="OnexCaption1212" Content="RS"    Tag="8"/>
                                            <ComboBoxItem x:Uid="OnexCaption1213" Content="LT"    Tag="9" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="OnexCaption1214" Content="RT"    Tag="10"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption1215" Text="Cursor" FontSize="13" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ControllerEmulationMouseCursorStickComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  IsEnabled="False">
                                            <ComboBoxItem x:Uid="OnexCaption1216" Content="Right Stick" Tag="0"/>
                                            <ComboBoxItem x:Uid="OnexCaption1217" Content="Left Stick"  Tag="1" IsSelected="True"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="OnexCaption1218" Text="Scroll" FontSize="13" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ControllerEmulationMouseScrollStickComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  IsEnabled="False">
                                            <ComboBoxItem x:Uid="OnexCaption1219" Content="Left Stick"  Tag="0"/>
                                            <ComboBoxItem x:Uid="OnexCaption1220" Content="Right Stick" Tag="1" IsSelected="True"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Extra assignable actions: browser/window-management shortcuts + cursor
                                         nudge, on top of the fixed Left/Right Click above. Each of the 4 slots
                                         picks a trigger button and an action; None/None = unused. -->
                                    <TextBlock x:Uid="OnexCaption1221" Text="Extra Actions" FontSize="13" Foreground="#FFFFFF" Margin="0,14,0,4"/>
                                    <TextBlock x:Uid="OnexCaption1222" Text="Assign a button to a browser/window shortcut or cursor nudge"
                                               FontSize="11"
                                               Foreground="{StaticResource HintTextBrush}"
                                               Margin="0,0,0,4"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ControllerEmulationMouseAction1ButtonComboBox" Grid.Column="0"
                                                  ItemTemplate="{StaticResource GamepadActionItemTemplate}"
                                                  Style="{StaticResource ModernComboBoxStyle}" IsEnabled="False" SelectedIndex="0"
                                                  SelectionChanged="ControllerEmulationMouseActionSlot_SelectionChanged">
                                            <x:String>None</x:String>
                                            <x:String>A</x:String><x:String>B</x:String><x:String>X</x:String><x:String>Y</x:String>
                                            <x:String>LB</x:String><x:String>RB</x:String><x:String>LS</x:String><x:String>RS</x:String>
                                            <x:String>LT</x:String><x:String>RT</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="ControllerEmulationMouseAction1TypeComboBox" Grid.Column="1" Margin="6,0,0,0"
                                                  Style="{StaticResource ModernComboBoxStyle}" IsEnabled="False"
                                                  SelectionChanged="ControllerEmulationMouseActionSlot_SelectionChanged">
                                            <ComboBoxItem x:Uid="OnexCaption1223" Content="None" Tag="0" IsSelected="True"/>
