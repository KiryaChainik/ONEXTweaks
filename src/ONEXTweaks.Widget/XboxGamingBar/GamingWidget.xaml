                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.Children>
                        <Border x:Name="EngagedGlow" CornerRadius="14" Opacity="0" BorderBrush="Transparent" BorderThickness="0" Background="#10000000" />
                        <Grid x:Name="HorizontalTemplate" Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
