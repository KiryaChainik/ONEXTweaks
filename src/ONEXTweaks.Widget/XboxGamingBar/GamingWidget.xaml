                                              Content="HDR"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Visibility="Collapsed"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed"/>
                                    <CheckBox x:Uid="OnexCaption310" x:Name="ProfileSaveResolutionCheckBox"
