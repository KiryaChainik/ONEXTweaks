<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Version>0.29.1110</Version>
    <OnexWidgetPackageFamily Condition="'$(OnexWidgetPackageFamily)' == ''">ONEXTweaks.Widget_3a23eh8tyg7na</OnexWidgetPackageFamily>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OnexWidgetPackageFamily" Value="$(OnexWidgetPackageFamily)" />
    <InternalsVisibleTo Include="Profiles.Core.Tests" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <Compile Include="../ONEXTweaks.PowerAgent/Pl2ControlPolicy.cs" Link="Pl2ControlPolicy.cs" />
    <Compile Include="../ONEXTweaks.PowerAgent/GameLightingLease.cs" Link="GameLightingLease.cs" />
    <Compile Include="../ONEXTweaks.Panel/PowerChannel.cs" Link="PowerChannel.cs" />
    <Compile Include="../ONEXTweaks.CompanionLauncher/OemConsoleHandoff.cs" Link="OemConsoleHandoff.cs" />
    <Compile Include="../ONEXTweaks.Widget/Shared/Enums/Function.cs" Link="Upstream/Function.cs" />
  </ItemGroup>
  <Target Name="ValidateOnexWidgetPackageFamily" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(OnexWidgetPackageFamily)', '\AONEXTweaks\.Widget_[0123456789abcdefghjkmnpqrstvwxyz]{13}\z'))"
           Text="OnexWidgetPackageFamily must be the exact ONEXTweaks.Widget package family name from the signed widget registration." />
  </Target>
  <ItemGroup>
    <None Include="../../vendor/viiper/0.9.0/libVIIPER.dll" Link="libVIIPER.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../vendor/viiper/0.9.0/licenses.txt" Link="VIIPER-licenses.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyControllerVisibilityObserver" AfterTargets="Build" Condition="Exists('$(TargetDir)ONEXTweaks.WidgetBridge.exe')">
    <Copy SourceFiles="$(TargetDir)ONEXTweaks.WidgetBridge.exe" DestinationFiles="$(TargetDir)ONEXTweaks.ControllerObserver.exe" />
  </Target>
  <Target Name="PublishControllerVisibilityObserver" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' or Exists('$(PublishDir)/ONEXTweaks.WidgetBridge.exe')">
    <Copy SourceFiles="$(PublishDir)/ONEXTweaks.WidgetBridge.exe"
          DestinationFiles="$(PublishDir)/ONEXTweaks.ControllerObserver.exe" />
  </Target>
</Project>
